 	return identity, ok
 }
+
+// NewDeclarationElementIDs inventories canonical declaration identities without emitting RDF.
+// It uses the converter's shared identity scopes, collection and duplicate checks.
+func NewDeclarationElementIDs(documents []ModelDocument) (*ElementIDs, error) {
+	return NewDeclarationElementIDsInModel(documents, nil, nil)
+}
+
+// NewDeclarationElementIDsInModel reuses the loaded model's native identity resolution.
+func NewDeclarationElementIDsInModel(documents []ModelDocument, res *resolve.Resolver, model *semantics.Model) (*ElementIDs, error) {
+	res, encoders, err := prepareModelEncodersInModel(documents, IDQualifiedName, res, model)
+	if err != nil {
+		return nil, err
+	}
+	ids := &ElementIDs{byOrigin: map[symbols.Origin]ElementIdentity{}, byNode: map[ast.Node]string{}, byName: map[string]string{}, res: res, encoders: encoders}
+	declared := map[string]mintedSubject{}
+	for _, e := range encoders {
+		for _, subject := range e.declaredSubjects() {
+			if prior, taken := declared[subject.iri]; taken {
+				return nil, &UnsupportedError{What: fmt.Sprintf("the declaration of %s at %s", subject.fqn, subject.at), Note: fmt.Sprintf("its id lands on the same IRI as %s at %s, which another document declares", prior.fqn, prior.at)}
+			}
+			declared[subject.iri] = subject
+		}
+		for node, fqn := range e.fqn {
+			if e.ids.consumed[node] {
+				continue
+			}
+			subject := e.ids.subjectForNode(node, fqn)
+			id := rdf.LocalName(subject.Value)
+			ids.byNode[node] = id
+			ids.byName[fqn] = id
+			origin := symbols.NodeOrigin(e.file.Name(), node)
+			if origin.Located() {
+				ids.byOrigin[origin] = ElementIdentity{ID: id, QualifiedName: fqn}
+			}
+		}
+	}
+	return ids, nil
+}
