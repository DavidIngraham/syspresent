diff --git a/internal/translate/export/api_json_projection.go b/internal/translate/export/api_json_projection.go
new file mode 100644
index 000000000..617a83c56
--- /dev/null
+++ b/internal/translate/export/api_json_projection.go
@@ -0,0 +1,96 @@
+package export
+
+import (
+	"bytes"
+	"encoding/json"
+	"github.com/Open-MBEE/OpenSysML/internal/semantic/resolve"
+	"github.com/Open-MBEE/OpenSysML/internal/semantic/semantics"
+	"github.com/Open-MBEE/OpenSysML/internal/translate/rdf"
+	"runtime"
+)
+
+// APIJSONProjectionCounts reports the declarations written and other elements omitted.
+type APIJSONProjectionCounts struct {
+	ElementCount        int
+	OmittedElementCount int
+}
+
+// WriteAPIJSONDeclarations writes unchanged API objects for source-backed declarations.
+// References to omitted expression and membership objects retain their native IDs.
+// It avoids materializing API objects for the omitted subjects.
+func WriteAPIJSONDeclarations(graph *rdf.Graph) ([]byte, APIJSONProjectionCounts, error) {
+	wrapped, err := withRootNamespace(graph)
+	if err != nil {
+		return nil, APIJSONProjectionCounts{}, err
+	}
+	settled, err := rdf.ReconcileCollections(wrapped)
+	if err != nil {
+		return nil, APIJSONProjectionCounts{}, err
+	}
+	var out bytes.Buffer
+	w := apiJSONWriter{buf: &out, enc: json.NewEncoder(&out)}
+	counts := APIJSONProjectionCounts{}
+	out.WriteByte('[')
+	for _, subject := range settled.Subjects() {
+		if _, ok := settled.Lexical(subject, rdf.OpenSysML+xSourceLine); !ok {
+			counts.OmittedElementCount++
+			continue
+		}
+		element, err := apiJSONElement(settled, subject)
+		if err != nil {
+			return nil, counts, err
+		}
+		if counts.ElementCount > 0 {
+			out.WriteByte(',')
+		}
+		if err := w.object(element); err != nil {
+			return nil, counts, err
+		}
+		counts.ElementCount++
+	}
+	out.WriteByte(']')
+	return out.Bytes(), counts, nil
+}
+
+// ModelToAPIJSONDeclarations encodes with shared model identities, retaining each document's declaration triples only.
+// Encoding one document at a time avoids retaining the model's complete expression/membership RDF graph.
+func ModelToAPIJSONDeclarations(documents []ModelDocument) ([]byte, APIJSONProjectionCounts, error) {
+	return ModelToAPIJSONDeclarationsInModel(documents, nil, nil)
+}
+
+// ModelToAPIJSONDeclarationsInModel reuses a caller's authoritative resolver and semantic model.
+func ModelToAPIJSONDeclarationsInModel(documents []ModelDocument, res *resolve.Resolver, model *semantics.Model) ([]byte, APIJSONProjectionCounts, error) {
+	defer runtime.GC()
+	if res != nil {
+		for _, document := range documents {
+			res.ResolveDocument(document.File.Name(), document.Root)
+		}
+	}
+	graph, _, _, omitted, err := modelToRDFProjectedInModel(documents, IDQualifiedName, true, res, model)
+	if err != nil {
+		return nil, omitted, err
+	}
+	content, counts, err := WriteAPIJSONDeclarations(graph)
+	counts.OmittedElementCount += omitted.OmittedElementCount
+	return content, counts, err
+}
+
+func declarationGraph(graph *rdf.Graph) *rdf.Graph {
+	selected := map[rdf.Term]bool{}
+	for _, subject := range graph.Subjects() {
+		if _, ok := graph.Lexical(subject, rdf.OpenSysML+xSourceLine); ok {
+			selected[subject] = true
+		}
+	}
+	triples := make([]rdf.Triple, 0, len(selected)*12)
+	for _, triple := range graph.Triples() {
+		if selected[triple.Subject] {
+			triples = append(triples, triple)
+		}
+	}
+	out := rdf.NewGraphOf(triples, graph.Prefixes)
+	if graph.CollectionsSettled() {
+		out.MarkCollectionsSettled()
+	}
+	return out
+}
