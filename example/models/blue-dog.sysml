        package AcousticEquipment {
         doc /* Acoustic bench candidates reviewed 2026-10-16. Supplier facts and project allowances are separate. Stand-alone planning assemblies are not complete traffic-safety solutions. No sensing simulation or requirement change. Dependencies identify questions, not satisfaction. See docs/reference/acoustic-sensing.md and its source register.*/
         private import ScalarValues::*;
         part passiveArray {
             doc /* AC-01: four Aquarian H3dX on four Zoom F6 channels, USB to Pi 4B. Shared recorder clock does not establish calibrated channel phase. Project array geometry is unvalidated. Cueing audible targets cannot cover quiet hazards.*/
             attribute id : String = "AC-01";
             attribute hydrophone : String = "Aquarian H3dX";
             attribute channelCount : Real = 4;
             attribute adc : String = "Zoom F6";
             attribute adcAvailableChannels : Real = 6;
             attribute host : String = "Raspberry Pi 4 Model B";
             attribute hydrophoneHeadMassKg : Real = 0.01;
             attribute recorderMassKg : Real = 0.52;
             attribute hydrophonePhantomVoltageV : Real = 48;
             attribute hydrophoneTypicalCurrentA : Real = 0.0012;
             attribute recorderMainUnitOnlyW : Real = 1;
             attribute arrayForeAftM : Real = 0.6;
             attribute arrayAthwartM : Real = 0.3;
             attribute supplierSource : String = "https://www.aquarianaudio.com/AqAudDocs/H3dX_manual.pdf";
             attribute massScope : String = "Head mass excludes cable/plug. Support covers host, four cables/XLR, enclosure, regulator, USB, rigid mount and flow shrouds, not optics or recovery.";
             attribute powerScope : String = "Recorder 1 W is main-unit-only. Nominal 48 V times current is phantom-supply power before feed losses, not power delivered inside the hydrophone or battery input; 5 V 1 A supply rating is not draw.";
             attribute observationBlocker : String = "Calibrate geometry, phase, sound speed and noise. Bearing does not establish metric range/range rate. Source level is unknown; amplitude-only range unsupported. Flow, self-noise, multipath and quiet targets unresolved.";
             attribute recoveryBlocker : String = "Heads may emerge inverted. Shared recorder, host and power not independent recovery.";
             attribute detectionRangeDemonstrated : Boolean = false;
             attribute bearingAccuracyDemonstrated : Boolean = false;
             attribute metricRangeDemonstrated : Boolean = false;
             attribute relativeMotionDemonstrated : Boolean = false;
             attribute latencyDemonstrated : Boolean = false;
             attribute dayNightCoverageDemonstrated : Boolean = false;
             attribute installedBudgetComplete : Boolean = false;
             attribute invertedObservationDemonstrated : Boolean = false;
             attribute independentRecoveryComplete : Boolean = false;
             attribute hardwareSelected : Boolean = false;
             attribute physicalQualification : Boolean = false;
             attribute plannedSampleRateHz : Real = 48000;
             attribute liveStreamingCompatibilityDemonstrated : Boolean = false;
         } part narrowBeamForward {
             doc /* AC-02: Omniscan 450 FS 100 m depth variant with Pi 4B. Narrow single beam builds an image using motion; not multibeam. Instrument range is not target detection evidence.*/
             attribute id : String = "AC-02";
             attribute sonar : String = "Cerulean Omniscan 450 FS, 100 m depth variant";
             attribute host : String = "Raspberry Pi 4 Model B";
             attribute componentMassKg : Real = 0.44;
             attribute supplierMaxPowerW : Real = 10;
             attribute supplyMinV : Real = 10;
             attribute supplyMaxV : Real = 30;
             attribute horizontalBeamDeg : Real = 0.8;
             attribute verticalBeamDeg : Real = 50;
             attribute supplierInstrumentRangeM : Real = 120;
             attribute dataInterface : String = "100Base-T Ethernet";
             attribute supplierSource : String = "https://docs.ceruleansonar.com/c/omniscan-450/specifications";
             attribute observationBlocker : String = "Known motion needed for coverage. Thin weeds, clutter, bubbles, shadowing, update age and above-water hazards unresolved.";
             attribute recoveryBlocker : String = "Mount may emerge inverted. Shared host, Ethernet and power not independent recovery.";
             attribute detectionRangeDemonstrated : Boolean = false;
             attribute bearingAccuracyDemonstrated : Boolean = false;
             attribute metricRangeDemonstrated : Boolean = false;
             attribute relativeMotionDemonstrated : Boolean = false;
             attribute latencyDemonstrated : Boolean = false;
             attribute dayNightCoverageDemonstrated : Boolean = false;
             attribute installedBudgetComplete : Boolean = false;
             attribute invertedObservationDemonstrated : Boolean = false;
             attribute independentRecoveryComplete : Boolean = false;
             attribute hardwareSelected : Boolean = false;
             attribute physicalQualification : Boolean = false;
             attribute narrowBeamAppliesBeyondM : Real = 5;
         } part multibeamForward {
             doc /* AC-03: Sonoptix ECHO with Pi 4B. Supplier instrument range, beams and powers do not establish Blue Dog target detection, tracking or latency.*/
             attribute id : String = "AC-03";
             attribute sonar : String = "Sonoptix ECHO";
             attribute host : String = "Raspberry Pi 4 Model B";
             attribute componentMassKg : Real = 0.75;
             attribute supplierPowerLowW : Real = 5;
             attribute supplierPowerHighW : Real = 25;
             attribute supplierActiveExampleVoltageV : Real = 12;
             attribute supplierActiveExampleCurrentA : Real = 1.2;
             attribute supplyMinV : Real = 9;
             attribute supplyMaxV : Real = 28;
             attribute beamCount : Real = 256;
             attribute horizontal400kHzDeg : Real = 90;
             attribute horizontal700kHzDeg : Real = 120;
             attribute verticalBeamDeg : Real = 20;
             attribute instrumentRange400kHzM : Real = 200;
             attribute instrumentRange700kHzM : Real = 30;
             attribute dataInterface : String = "Ethernet";
             attribute supplierSource : String = "https://bluerobotics.com/store/sonars/imaging-sonars/sonoptix-echo/";
             attribute observationBlocker : String = "Beams do not establish target probability, thin-strand resolution or swept-volume clearance. Reverberation, bubbles, attitude, masking and latency need measurement.";
             attribute recoveryBlocker : String = "Mount may emerge inverted. Shared host, Ethernet and power not independent recovery.";
             attribute detectionRangeDemonstrated : Boolean = false;
             attribute bearingAccuracyDemonstrated : Boolean = false;
             attribute metricRangeDemonstrated : Boolean = false;
             attribute relativeMotionDemonstrated : Boolean = false;
             attribute latencyDemonstrated : Boolean = false;
             attribute dayNightCoverageDemonstrated : Boolean = false;
             attribute installedBudgetComplete : Boolean = false;
             attribute invertedObservationDemonstrated : Boolean = false;
             attribute independentRecoveryComplete : Boolean = false;
             attribute hardwareSelected : Boolean = false;
             attribute physicalQualification : Boolean = false;
         } part planning {
             doc /* Unmeasured project allowances. Recorder power includes phantom and four microphones once. Shared host replacement requires explicit reconciliation; do not subtract a whole support assembly. Mass excludes optics, recovery and batteries. Storage, bandwidth and thermal performance unresolved.*/
             attribute recorderWithPhantomLowW : Real = 1.5;
             attribute recorderWithPhantomHighW : Real = 3;
             attribute hostLowW : Real = 3;
             attribute hostHighW : Real = 6;
             attribute conversionEfficiency : Real = 0.9;
             attribute passiveSupportMassKg : Real = 0.45;
             attribute activeSupportMassKg : Real = 0.3;
         }
         analysis Budget {
             doc /* Component/project arithmetic only. Mass remainder is not free payload. Active upper cases combine supplier maxima and host planning high, not measured average. Maximum power alone cannot reject an average-energy allocation. Ethernet, heating/cleaning and recovery unallocated.*/
             out attribute passiveHydrophoneHeadsKg : Real = passiveArray.channelCount*passiveArray.hydrophoneHeadMassKg;
             out attribute passiveNominalPhantomSupplyW : Real = passiveArray.channelCount*passiveArray.hydrophonePhantomVoltageV*passiveArray.hydrophoneTypicalCurrentA;
             out attribute passivePlanningMassKg : Real = passiveHydrophoneHeadsKg+passiveArray.recorderMassKg+planning.passiveSupportMassKg;
             out attribute passivePlanningRailLowW : Real = planning.recorderWithPhantomLowW+planning.hostLowW;
             out attribute passivePlanningRailHighW : Real = planning.recorderWithPhantomHighW+planning.hostHighW;
             out attribute passivePlanningBatteryLowW : Real = passivePlanningRailLowW/planning.conversionEfficiency;
             out attribute passivePlanningBatteryHighW : Real = passivePlanningRailHighW/planning.conversionEfficiency;
             out attribute narrowBeamPlanningMassKg : Real = narrowBeamForward.componentMassKg+planning.activeSupportMassKg;
             out attribute multibeamPlanningMassKg : Real = multibeamForward.componentMassKg+planning.activeSupportMassKg;
             out attribute narrowBeamMaxPlusHostHighW : Real = narrowBeamForward.supplierMaxPowerW+planning.hostHighW;
             out attribute multibeamMaxPlusHostHighW : Real = multibeamForward.supplierPowerHighW+planning.hostHighW;
             out attribute multibeamSupplierActiveExampleW : Real = multibeamForward.supplierActiveExampleVoltageV*multibeamForward.supplierActiveExampleCurrentA;
             out attribute installedBudgetComplete : Boolean = false;
             out attribute physicalQualification : Boolean = false;
         }
         dependency trafficQuestion from passiveArray to BlueDog::Requirements::trafficSafety;
         dependency trackQuestion from passiveArray to BlueDog::Requirements::trafficTracking;
         dependency underwaterQuestion from multibeamForward to BlueDog::Requirements::trafficSafety;
         dependency integrationBudget from Budget to BlueDog::Analyses::IntegratedCandidate::hypothesis;
        }

        package Examples {

            package Energy {
                private import SI::*;
                doc /* Illustrative system budget with an explicit provisional wired wind-sensor allocation.
                 * Other equipment loads remain synthetic; none are accepted measurements. A zero payload represents absent optional equipment, not an
                 * unmeasured installed load. Solar resource and battery capacity are illustrative.
                 * Recovery motor is excluded from qualifying sailing loads; its reserve is protected.
                 */
                part sailing : BlueDog::Analyses::Energy::LoadBudget {
                    part controller :> loads {
                        attribute :>> label = "Guidance and mission computer";
                        attribute :>> activePower default = 2 [W];
                        attribute :>> idlePower default = 0.8 [W];
                        attribute :>> activeFraction default = 1;
                        attribute :>> conversionEfficiency default = 0.9;
                        attribute :>> uncertaintyFactor default = 1.15;
                    }
                    part navigation :> loads {
                        attribute :>> label = "Position and attitude sensors";
                        attribute :>> activePower default = 0.5 [W];
                        attribute :>> idlePower default = 0.1 [W];
                        attribute :>> activeFraction default = 1;
                        attribute :>> conversionEfficiency default = 0.9;
                        attribute :>> uncertaintyFactor default = 1.15;
                    }
                    part wind :> loads {
                        attribute :>> label = "Calypso ULP Wired Mini with interface allowance";
                        attribute :>> activePower default = BlueDog::Configurations::WindEquipment::challenge.busPowerW * 1 [W];
                        attribute :>> idlePower default = BlueDog::Configurations::WindEquipment::challenge.busPowerW * 1 [W];
                        attribute :>> activeFraction default = 1;
                        attribute :>> conversionEfficiency default = 1;
                        attribute :>> uncertaintyFactor default = 1;
                    }
                    part traffic :> loads {
                        attribute :>> label = "Traffic sensing";
                        attribute :>> activePower default = 1 [W];
                        attribute :>> idlePower default = 0.2 [W];
                        attribute :>> activeFraction default = 1;
                        attribute :>> conversionEfficiency default = 0.9;
                        attribute :>> uncertaintyFactor default = 1.15;
                    }
                    part sail :> loads {
                        attribute :>> label = "Sail actuator";
                        attribute :>> activePower default = 8 [W];
                        attribute :>> idlePower default = 0.05 [W];
                        attribute :>> activeFraction default = 0.02;
                        attribute :>> conversionEfficiency default = 0.9;
                        attribute :>> uncertaintyFactor default = 1.15;
                    }
                    part steering :> loads {
                        attribute :>> label = "Steering actuator";
                        attribute :>> activePower default = 6 [W];
                        attribute :>> idlePower default = 0.05 [W];
                        attribute :>> activeFraction default = 0.05;
                        attribute :>> conversionEfficiency default = 0.9;
                        attribute :>> uncertaintyFactor default = 1.15;
                    }
                    part telemetry :> loads {
                        attribute :>> label = "Telemetry radio and command gateway";
                        attribute :>> activePower default = 6 [W];
                        attribute :>> idlePower default = 0.1 [W];
                        attribute :>> activeFraction default = 0.02;
                        attribute :>> conversionEfficiency default = 0.9;
                        attribute :>> uncertaintyFactor default = 1.15;
                    }
                    part signaling :> loads {
                        attribute :>> label = "Navigation signals";
                        attribute :>> activePower default = 0.6 [W];
                        attribute :>> idlePower default = 0 [W];
                        attribute :>> activeFraction default = 0.5;
                        attribute :>> conversionEfficiency default = 0.9;
                        attribute :>> uncertaintyFactor default = 1.15;
                    }
                    part recording :> loads {
                        attribute :>> label = "Recording electronics";
                        attribute :>> activePower default = 0.2 [W];
                        attribute :>> idlePower default = 0.05 [W];
                        attribute :>> activeFraction default = 0.5;
                        attribute :>> conversionEfficiency default = 0.9;
                        attribute :>> uncertaintyFactor default = 1.15;
                    }
                    part health :> loads {
                        attribute :>> label = "Recovery controller and ingress sensing";
                        attribute :>> activePower default = 0.1 [W];
                        attribute :>> idlePower default = 0.05 [W];
                        attribute :>> activeFraction default = 1;
                        attribute :>> conversionEfficiency default = 0.9;
                        attribute :>> uncertaintyFactor default = 1.15;
                    }
                    part housekeeping :> loads {
                        attribute :>> label = "Power management quiescent demand";
                        attribute :>> activePower default = 0.2 [W];
                        attribute :>> idlePower default = 0.2 [W];
                        attribute :>> activeFraction default = 1;
                        attribute :>> conversionEfficiency default = 0.9;
                        attribute :>> uncertaintyFactor default = 1.15;
                    }
                    part payload :> loads {
                        attribute :>> label = "Optional payload absent";
                        attribute :>> activePower default = 0 [W];
                        attribute :>> idlePower default = 0 [W];
                        attribute :>> activeFraction default = 0;
                        attribute :>> conversionEfficiency default = 0.9;
                        attribute :>> uncertaintyFactor default = 1.15;
                    }
                }
                part campaign : BlueDog::Analyses::Energy::Scenario {
                    part redefines battery {
                        attribute :>> nominalEnergy default = 900000 [J];
                        attribute :>> usableFraction default = 0.8;
                        attribute :>> chargeEfficiency default = 0.9;
                        attribute :>> dischargeEfficiency default = 0.9;
                        attribute :>> selfDischargePower default = 0.02 [W];
                        attribute :>> maxChargePower default = 30 [W];
                        attribute :>> maxDischargePower default = 60 [W];
                    }
                    attribute :>> initialEnergy default = 648000 [J];
                    attribute :>> recoveryMotorPower default = 50 [W];
                    attribute :>> recoveryEssentialPower default = 8 [W];
                    comment recoveryExample /* Synthetic route exposure for evaluator regression, not the challenge reserve policy. */
                    attribute :>> recoveryPoweredDuration default = 1800 [s];
                    attribute :>> recoveryEssentialDuration default = 7200 [s];
                    attribute :>> recoveryUncertaintyFactor default = 1.2;
                    ref part :>> timeline default = (dark1, harvest1, dark2, harvest2, dark3, harvest3);
                    attribute :>> dayCount default = 3;
                    attribute :>> evidenceAccepted default = false;
                    part dark1 :> intervals {
                        ref part :>> budget default = sailing;
                        attribute :>> duration default = 64800 [s];
                        attribute :>> harvestEnabled default = false;
                        attribute :>> rawHarvestPower default = 0 [W];
                        attribute :>> harvestEfficiency default = 0.85;
                    }
                    part harvest1 :> intervals {
                        ref part :>> budget default = sailing;
                        attribute :>> duration default = 21600 [s];
                        attribute :>> harvestEnabled default = true;
                        attribute :>> rawHarvestPower default = 40 [W];
                        attribute :>> harvestEfficiency default = 0.85;
                    }
                    part dark2 :> intervals {
                        ref part :>> budget default = sailing;
                        attribute :>> duration default = 64800 [s];
                        attribute :>> harvestEnabled default = false;
                        attribute :>> rawHarvestPower default = 0 [W];
                        attribute :>> harvestEfficiency default = 0.85;
                    }
                    part harvest2 :> intervals {
                        ref part :>> budget default = sailing;
                        attribute :>> duration default = 21600 [s];
                        attribute :>> harvestEnabled default = true;
                        attribute :>> rawHarvestPower default = 40 [W];
                        attribute :>> harvestEfficiency default = 0.85;
                    }
                    part dark3 :> intervals {
                        ref part :>> budget default = sailing;
                        attribute :>> duration default = 64800 [s];
                        attribute :>> harvestEnabled default = false;
                        attribute :>> rawHarvestPower default = 0 [W];
                        attribute :>> harvestEfficiency default = 0.85;
                    }
                    part harvest3 :> intervals {
                        ref part :>> budget default = sailing;
                        attribute :>> duration default = 21600 [s];
                        attribute :>> harvestEnabled default = true;
                        attribute :>> rawHarvestPower default = 40 [W];
                        attribute :>> harvestEfficiency default = 0.85;
                    }
                }
                dependency controllerAllocation from sailing::controller to BlueDog::Architecture::missionContext::boat::control;
                dependency navigationAllocation from sailing::navigation to BlueDog::Architecture::missionContext::boat::navigation;
                dependency trafficAllocation from sailing::traffic to BlueDog::Architecture::missionContext::boat::navigation::traffic;
                dependency sailAllocation from sailing::sail to BlueDog::Architecture::missionContext::boat::actuation;
                dependency steeringAllocation from sailing::steering to BlueDog::Architecture::missionContext::boat::actuation;
                dependency telemetryAllocation from sailing::telemetry to BlueDog::Architecture::missionContext::boat::communications;
                dependency signalingAllocation from sailing::signaling to BlueDog::Architecture::missionContext::boat::signaling;
                dependency recordingAllocation from sailing::recording to BlueDog::Architecture::missionContext::boat::recording;
                dependency healthAllocation from sailing::health to BlueDog::Architecture::missionContext::boat::recovery;
                dependency housekeepingAllocation from sailing::housekeeping to BlueDog::Architecture::missionContext::boat::energy::powerManagement;
                dependency payloadAllocation from sailing::payload to BlueDog::Architecture::missionContext::boat::observationPayload;
                dependency campaignIntent from campaign to BlueDog::Requirements::multiDayEndurance;
            }

            package Reliability {
                private import SI::*;
                part gorgeIllustration : BlueDog::Analyses::Reliability::VoyageProfile {
                    doc /* Synthetic 100 km each-way profile; not surveyed challenge gates or a predicted polar.
                     * 2.5 m/s water VMG with 20 percent loss, +/-1.5 m/s current, six hours of holds.
                     * Failure-rate and test-hour inputs are illustrative, not collected evidence. */
                    ref part :>> vessel = BlueDog::Architecture::missionContext.boat;
                    part upstream : BlueDog::Analyses::Reliability::SailingLeg subsets legs {
                        attribute :>> distance default = 100000 [m];
                        attribute :>> waterVMG default = 2.5 [m/s];
                        attribute :>> currentVMG default = -1.5 [m/s];
                        attribute :>> retainedPerformance default = 0.8;
                    }
                    part downstream : BlueDog::Analyses::Reliability::SailingLeg subsets legs {
                        attribute :>> distance default = 100000 [m];
                        attribute :>> waterVMG default = 2.5 [m/s];
                        attribute :>> currentVMG default = 1.5 [m/s];
                        attribute :>> retainedPerformance default = 0.8;
                    }
                    attribute :>> holdTime default = 21600 [s];
                    attribute :>> qualifiedDuration default = 259200 [s];
                    attribute :>> criticalRatesPerHour default = (0.0002, 0.0003);
                    attribute :>> commonCauseRatePerHour default = 0.0001;
                    attribute :>> zeroFailureTestHours default = 2000;
                    attribute :>> observedCriticalFailures default = 0;
                    attribute :>> profileEvidenceAccepted default = false;
                    attribute :>> rateEvidenceAccepted default = false;
                    attribute :>> constantHazardAccepted default = false;
                }
                analysis gorgeAssessment : BlueDog::Analyses::Reliability::CruiseReliability { subject :>> profile = gorgeIllustration; }
            }

            package Sailing {
                private import SI::*;
                doc /* Synthetic design studies. No measured hull, polar or route is asserted.
                 * Wind from west/east denotes idealized alignment with a straight river axis,
                 * not a weather forecast or surveyed corridor. Length is waterline length of
                 * the assembled vessel, not a printer-module dimension. gorgeWesterly is
                 * the representative selected-window challenge illustration; gorgeEasterly
                 * is a reversal/winter sensitivity. Neither is a probability-weighted route.
                 * BlueDog::Analyses::Weather::policy governs seasonal context, not these synthetic speeds.
                 */
                part def UpstreamHeadwind :> BlueDog::Analyses::Sailing::PolarLeg {
                    attribute :>> label default = "Upstream / headwind";
                    attribute :>> distance default = 100000 [m];
                    attribute :>> currentVMG default = -1.5 [m/s];
                    attribute :>> retainedPerformance default = 0.8;
                    attribute :>> trueWindSpeed default = 5 [m/s];
                    attribute :>> trueWindAngle default = TrigFunctions::rad(45) * (1 [rad]);
                    attribute :>> leeway default = 0 [rad];
                    attribute :>> windward default = true;
                    attribute :>> cleanPolarSpeed default = 4 [m/s];
                    attribute :>> maneuverRetention default = 0.95;
                    attribute :>> waterlineLength default = 1 [m];
                    attribute :>> allocatedTime default = 201600 [s];
                    attribute :>> minimumGroundVMG default = 0.5 [m/s];
                    attribute :>> polarEvidenceAccepted default = false;
                    attribute :>> hullEvidenceAccepted default = false;
                }
                part def UpstreamTailwind :> UpstreamHeadwind {
                    attribute :>> label default = "Upstream / tailwind";
                    attribute :>> trueWindAngle default = TrigFunctions::rad(140) * (1 [rad]);
                    attribute :>> windward default = false;
                    attribute :>> cleanPolarSpeed default = 3.6 [m/s];
                }
                part def DownstreamHeadwind :> UpstreamHeadwind {
                    attribute :>> label default = "Downstream / headwind";
                    attribute :>> currentVMG default = 1.5 [m/s];
                    attribute :>> allocatedTime default = 36000 [s];
                    attribute :>> cleanPolarSpeed default = 3 [m/s];
                }
                part def DownstreamTailwind :> DownstreamHeadwind {
                    attribute :>> label default = "Downstream / tailwind";
                    attribute :>> trueWindAngle default = TrigFunctions::rad(140) * (1 [rad]);
                    attribute :>> windward default = false;
                }
                part upstreamHeadwind : UpstreamHeadwind;
                part upstreamTailwind : UpstreamTailwind;
                part downstreamHeadwind : DownstreamHeadwind;
                part downstreamTailwind : DownstreamTailwind;
                part gorgeWesterly : BlueDog::Analyses::Sailing::PolarVoyageProfile {
                    ref part :>> vessel = BlueDog::Architecture::missionContext.boat;
                    part upstream : UpstreamTailwind subsets legs;
                    part downstream : DownstreamHeadwind subsets legs;
                    attribute :>> holdTime default = BlueDog::Configurations::Examples::Reliability::gorgeIllustration.holdTime;
                    attribute :>> qualifiedDuration default = BlueDog::Configurations::Examples::Reliability::gorgeIllustration.qualifiedDuration;
                    attribute :>> criticalRatesPerHour default = BlueDog::Configurations::Examples::Reliability::gorgeIllustration.criticalRatesPerHour;
                    attribute :>> commonCauseRatePerHour default = BlueDog::Configurations::Examples::Reliability::gorgeIllustration.commonCauseRatePerHour;
                    attribute :>> zeroFailureTestHours default = BlueDog::Configurations::Examples::Reliability::gorgeIllustration.zeroFailureTestHours;
                    attribute :>> observedCriticalFailures default = BlueDog::Configurations::Examples::Reliability::gorgeIllustration.observedCriticalFailures;
                    attribute :>> rateEvidenceAccepted default = false;
                    attribute :>> constantHazardAccepted default = false;
                }
                part gorgeEasterly :> gorgeWesterly {
                    part redefines upstream {
                        attribute :>> label = upstreamHeadwind.label;
                        attribute :>> trueWindAngle = upstreamHeadwind.trueWindAngle;
                        attribute :>> windward = true;
                        attribute :>> cleanPolarSpeed = upstreamHeadwind.cleanPolarSpeed;
                    }
                    part redefines downstream {
                        attribute :>> label = downstreamTailwind.label;
                        attribute :>> trueWindAngle = downstreamTailwind.trueWindAngle;
                        attribute :>> windward = false;
                        attribute :>> cleanPolarSpeed = downstreamTailwind.cleanPolarSpeed;
                    }
                }
                analysis upstreamBeat : BlueDog::Analyses::Sailing::PolarDemandAndHullScreen { subject :>> leg = upstreamHeadwind; }
                analysis upstreamRun : BlueDog::Analyses::Sailing::PolarDemandAndHullScreen { subject :>> leg = upstreamTailwind; }
                analysis downstreamBeat : BlueDog::Analyses::Sailing::PolarDemandAndHullScreen { subject :>> leg = downstreamHeadwind; }
                analysis downstreamRun : BlueDog::Analyses::Sailing::PolarDemandAndHullScreen { subject :>> leg = downstreamTailwind; }
                analysis westerlyPassage : BlueDog::Analyses::Sailing::PolarVoyageAssessment { subject :>> profile = gorgeWesterly; }
                analysis easterlyPassage : BlueDog::Analyses::Sailing::PolarVoyageAssessment { subject :>> profile = gorgeEasterly; }
                part lightWind : UpstreamHeadwind { attribute :>> trueWindSpeed = 3 [m/s]; }
                part strongWind : UpstreamHeadwind { attribute :>> trueWindSpeed = 10 [m/s]; }
                part highWind : UpstreamHeadwind { attribute :>> trueWindSpeed = 15 [m/s]; }
                analysis lightWindDemand : BlueDog::Analyses::Sailing::PolarDemandAndHullScreen { subject :>> leg = lightWind; }
                analysis strongWindDemand : BlueDog::Analyses::Sailing::PolarDemandAndHullScreen { subject :>> leg = strongWind; }
                analysis highWindDemand : BlueDog::Analyses::Sailing::PolarDemandAndHullScreen { subject :>> leg = highWind; }
                analysis sensitivity : BlueDog::Analyses::Sailing::SailingSensitivity { subject :>> leg = upstreamHeadwind; }
                part oceanIllustration : UpstreamHeadwind {
                    doc /* Sizing probe only: 4000 km in 28 moving days (30 days less 48 h holds),
                     * zero along-route current, 140-degree TWA. No Hawaii route, season, wind
                     * persistence, endurance qualification or operating window is established. */
                    metadata issue : ModelingMetadata::Issue { text = "Illustrative distance and time allocation are not approved Hawaii mission parameters."; }
                    attribute :>> label = "Offshore sizing probe";
                    attribute :>> distance = 4000000 [m];
                    attribute :>> currentVMG = 0 [m/s];
                    attribute :>> allocatedTime = 2419200 [s];
                    attribute :>> trueWindAngle = TrigFunctions::rad(140) * (1 [rad]);
                    attribute :>> windward = false;
                    attribute :>> cleanPolarSpeed = 3 [m/s];
                }
                analysis oceanDemand : BlueDog::Analyses::Sailing::PolarDemandAndHullScreen { subject :>> leg = oceanIllustration; }
                dependency oceanSizingBasis from oceanIllustration to BlueDog::Goals::hawaiiVoyage;
            }
        }

        package IC01 {
            private import ScalarValues::*;
            doc /* IC-01 is the provisional finite-Gorge integration configuration.
             * The complete geometry is explicitly owned here. Exact values preserve the
             * 15 October archived candidate; they are not measured manufacturing precision.
             * The wing model is a sizing representation, not a rig selection. Soft sail,
             * tail-controlled wing and directly rotated fixed-camber wing remain contenders.
             * Physical qualification and accepted installed equipment remain open. */
            part design : MarineDesign::Design {
                attribute configurationId : String = "IC-01";
                attribute missionId : String = "Trans-Gorge";
                attribute designSource : String = "evidence/runs/2026-10-15-integrated-candidate/integrated-sizing.json";
                attribute sourceRevision : String = "86049ae5ee0429fd2c7b350228d3a544428a4aaf";
                attribute physicallyQualified : Boolean = false;
                attribute :>> length_m = 1.1999999999991275;
                attribute :>> beam_m = 0.42;
                attribute :>> bottom_depth_m = 0.1;
                attribute :>> deck_height_m = 0.07;
                attribute :>> sail_m2 = 0.4;
                attribute :>> sail_AR = 2.341980758978876;
                attribute :>> camber_scale = 1.5;
                attribute :>> wing_thickness_scale = 2.0;
                attribute :>> mast_fraction = 0.5238422485213118;
                attribute :>> mast_x_fraction = -0.1481170636448525;
                attribute :>> keel_m2 = 0.02;
                attribute :>> keel_span_m = 0.19999999999977908;
                attribute :>> rudder_m2 = 0.017679746777796716;
                attribute :>> rudder_span_m = 0.188041210379152;
                attribute :>> rudder_arm_fraction = 0.420003780182039;
                attribute :>> ballast_kg = 0.5;
                attribute :>> battery_Wh = 1300;
                attribute :>> panel_m2 = 0.05;
                attribute :>> wing_torque_Nm = 1.5;
                attribute :>> rudder_torque_Nm = 0.34378095116731916;
                attribute :>> hull_glass_kg_m2 = 0.452496128293465;
                attribute :>> wing_glass_kg_m2 = 0.4;
                attribute :>> keel_glass_kg_m2 = 2.5;
                attribute :>> rudder_glass_kg_m2 = 3;
                attribute :>> hull_rib_pitch_m = 0.022436816975681086;
                attribute :>> foil_rib_pitch_m = 0.2299999999996331;
                attribute :>> battery_x_fraction = -2.528793840994581e-11;
                attribute :>> battery_z_fraction = 0.05;
                attribute :>> hull_fullness_exponent = 2.0;
            }
            part integration {
                attribute identifier : String = design.configurationId;
                attribute additionalBusW : Real = 8;
                attribute additionalEquipmentKg : Real = 1.2;
                attribute independentRecoveryAssumed : Boolean = true;
                attribute recoveryBatteryWh : Real = 60;
                attribute recoveryStandbyW : Real = 0.05;
                attribute recoveryMotorW : Real = 50;
                attribute recoveryEssentialW : Real = 8;
                attribute recoverySpeedMps : Real = 1.5;
                attribute invertedSpeedMps : Real = 0.5;
                attribute invertedMotorW : Real = 40;
                attribute recoveryUncertainty : Real = 1.2;
                attribute arrivalAllowanceWh : Real = 2;
                attribute batteryWhKg : Real = BlueDog::Configurations::assumptions.batteryWhKg;
                attribute electronicsW : Real = BlueDog::Configurations::assumptions.electronicsW + additionalBusW;
                attribute fixedEquipmentKg : Real = BlueDog::Configurations::assumptions.fixedEquipmentKg + additionalEquipmentKg + recoveryBatteryWh/batteryWhKg;
                attribute recoveryDepartureWh : Real = recoveryBatteryWh*0.8*0.9;
                attribute sensorRangeM : Real = BlueDog::Analyses::EncounterReview::criteria.rangeAllocationM {
                    doc /* Historical 15 October IC-01 sensing hypothesis retained for archived replay. The 750 m value is not a current class-specific allocation; BlueDog::Analyses::ClassDetection allocations remain unaccepted.*/
                }
                attribute weedRangeM : Real = 40;
                attribute sensorLatencyS : Real = 1;
                attribute assessmentS : Real = 1;
                attribute commandS : Real = 2;
                attribute maneuverS : Real = 15;
                attribute planningHorizonS : Real = 180;
                attribute minimumSailingSpeedMps : Real = 0.05;
                attribute depowerPenaltyM : Real = 180;
                attribute crossTrackWeight : Real = 0.5;
                attribute maneuverPenaltyM : Real = 10;
            }
        }

        package Management {
            private import ScalarValues::*;
            private import ISQ::*;
            private import SI::*;
            doc /* Configuration and resource-accounting context, tailored from NASA SE6.5/6.7,
             * defense SE Guidebook2026 6.1.3/6.1.6 and PSM/INCOSE Technical Measurement2005.
             * No numerical allocation, equipment selection or historical evidence changes. */
            part def ContextRecord {
                attribute identifier : String [1];
                attribute role : String [1];
                attribute intendedUse : String [1];
                attribute revisionBasis : String [1];
                ref part representedSubject [1];
            }
            part currentCandidate : ContextRecord {
                attribute :>> identifier = "IC-01";
                attribute :>> role = "Current numerical/integration candidate";
                attribute :>> intendedUse = "Conditional coupled sizing and local sailing/encounter/recovery studies; planned physical integration, not a built or qualified article";
                attribute :>> revisionBasis = "Current model source/model hashes identify a run. design.sourceRevision identifies the archived numerical origin, not the current hardware/software configuration revision.";
                ref part :>> representedSubject = BlueDog::Configurations::IC01::design;
            }
            part retainedSizing : ContextRecord {
                attribute :>> identifier = "Retained440Wh";
                attribute :>> role = "Historical sizing-study subject";
                attribute :>> intendedUse = "Interpret the retained candidate and its original archived replay; no transfer of its budget or evidence acceptance to IC-01";
                attribute :>> revisionBasis = "BlueDog::Evidence::SRRCurrent preserves the 440Wh record and original source revision; current reanalysis requires its own input fingerprints.";
                ref part :>> representedSubject = BlueDog::Evidence::SRRCurrent::candidate;
            }
            part illustrativeLoads : ContextRecord {
                attribute :>> identifier = "IllustrativeLoads";
                attribute :>> role = "Synthetic load-accounting example";
                attribute :>> intendedUse = "Demonstrate duty/conversion rollup; not a complete vessel or IC-01 installed-load split";
                attribute :>> revisionBasis = "BlueDog::Configurations::Examples::Energy source fingerprint identifies the illustrative allocation; it is not installed equipment evidence.";
                ref part :>> representedSubject = BlueDog::Configurations::Examples::Energy::sailing;
            }
            part searchReference : ContextRecord {
                attribute :>> identifier = "SearchReference";
                attribute :>> role = "Numerical starting geometry";
                attribute :>> intendedUse = "Reference geometry for preparation/search; not a selected vessel or accepted installed article";
                attribute :>> revisionBasis = "Current authored configuration fingerprint; original decimal precision is not measured accuracy.";
                ref part :>> representedSubject = BlueDog::Configurations::reference;
            }
            part lowerSearchBracket : ContextRecord {
                attribute :>> identifier = "LowerBracket";
                attribute :>> role = "Numerical/model-domain lower bracket";
                attribute :>> intendedUse = "Define search bounds; not a complete feasible vessel, owner requirement or manufacturing tolerance";
                attribute :>> revisionBasis = "Current model-domain/search input fingerprint; bracket changes need applicability and search review.";
                ref part :>> representedSubject = BlueDog::Configurations::lowerBracket;
            }
            part upperSearchBracket : ContextRecord {
                attribute :>> identifier = "UpperBracket";
                attribute :>> role = "Numerical/model-domain upper bracket";
                attribute :>> intendedUse = "Define search bounds; not a selected dimension, vessel requirement or manufacturing tolerance";
                attribute :>> revisionBasis = "Current model-domain/search input fingerprint; do not transfer bracket status to physical feasibility.";
                ref part :>> representedSubject = BlueDog::Configurations::upperBracket;
            }
            part parameterBasis : ContextRecord {
                attribute :>> identifier = "ParameterBasis";
                attribute :>> role = "Provisional shared analysis assumptions";
                attribute :>> intendedUse = "Reusable physical/component assumptions overridden by identified candidate integration inputs where declared";
                attribute :>> revisionBasis = "Current model/driver fingerprints identify assumptions; numerical allocations are not measured equipment.";
                ref part :>> representedSubject = BlueDog::Configurations::assumptions;
            }
            part recordedBaseline : ContextRecord {
                attribute :>> identifier = "RecordedBaseline";
                attribute :>> role = "Historical exploratory sizing projection";
                attribute :>> intendedUse = "Interpret the original October10 exploration; no silent substitution for current geometry or qualification";
                attribute :>> revisionBasis = "models/evidence/coupled-2026-10-10.sysml and evidence/runs/2026-10-10-coupled/manifest.json retain original revision.";
                ref part :>> representedSubject = BlueDog::Evidence::RecordedSizing::candidate;
            }
            part bingenProjection : ContextRecord {
                attribute :>> identifier = "BingenProjection";
                attribute :>> role = "Historical Bingen sizing projection";
                attribute :>> intendedUse = "Interpret the October12 Bingen candidate; distinct from the later 440Wh retained replay and IC-01";
                attribute :>> revisionBasis = "Despite the package name CurrentSizing, evidence/runs/2026-10-12-bingen/manifest.json owns this historical projection.";
                ref part :>> representedSubject = BlueDog::Evidence::CurrentSizing::candidate;
            }
            part continuationProjection : ContextRecord {
                attribute :>> identifier = "ContinuationProjection";
                attribute :>> role = "Historical coarse sizing continuation";
                attribute :>> intendedUse = "Interpret the recorded continuation subject; coarse feasibility and target status do not establish refinement or physical qualification";
                attribute :>> revisionBasis = "models/evidence/sizing-continuation.sysml preserves its recorded stage/result context; retain the archived run lineage.";
                ref part :>> representedSubject = BlueDog::Evidence::SizingContinuation::candidate;
            }
            part finitePassageProjection : ContextRecord {
                attribute :>> identifier = "FinitePassageProjection";
                attribute :>> role = "Historical finite-passage continuation";
                attribute :>> intendedUse = "Interpret the recorded partial/coarse progression and unreached target; no global infeasibility or current-vessel claim";
                attribute :>> revisionBasis = "evidence/runs/2026-10-12-finite-passage/manifest.json and native evidenceManifest retain the original scope/status.";
                ref part :>> representedSubject = BlueDog::Evidence::FinitePassageSizing::candidate;
            }
            part reliabilityIllustration : ContextRecord {
                attribute :>> identifier = "ReliabilityIllustration";
                attribute :>> role = "Synthetic exposure/rate example";
                attribute :>> intendedUse = "Exercise voyage-duration and constant-hazard arithmetic; not surveyed course geometry or collected vessel failure evidence";
                attribute :>> revisionBasis = "Current illustrative source fingerprint; profile/rates, dependence and statistical applicability remain unaccepted.";
                ref part :>> representedSubject = BlueDog::Configurations::Examples::Reliability::gorgeIllustration;
            }
            part def PlannedInstallation {
                ref part design : MarineDesign::Design [1];
                ref part assembly : BlueDog::Architecture::Physical::IC01Candidate [1];
                attribute articleId : String [0..1];
                attribute hardwareRevision : String [0..1];
                attribute softwareDataRevision : String [0..1];
                attribute procedureRevision : String [0..1];
                attribute reconciliationRecord : String [0..1];
                attribute reconciled : Boolean default = false;
                attribute identityReady : Boolean = SequenceFunctions::size(articleId) == 1 and
                    SequenceFunctions::size(hardwareRevision) == 1 and SequenceFunctions::size(softwareDataRevision) == 1 and
                    SequenceFunctions::size(procedureRevision) == 1 and SequenceFunctions::size(reconciliationRecord) == 1 and
                    articleId->ControlFunctions::forAll { in v : String; v != "" } and
                    hardwareRevision->ControlFunctions::forAll { in v : String; v != "" } and
                    softwareDataRevision->ControlFunctions::forAll { in v : String; v != "" } and
                    procedureRevision->ControlFunctions::forAll { in v : String; v != "" } and
                    reconciliationRecord->ControlFunctions::forAll { in v : String; v != "" };
                attribute plannedReferencesApplicable : Boolean = design == BlueDog::Configurations::IC01::design and assembly == BlueDog::Architecture::Physical::ic01;
                attribute configurationReconciled : Boolean = plannedReferencesApplicable and identityReady and reconciled;
                doc /* A record identity does not inspect records or accept hardware. Include
                 * applicable data/calibration in softwareDataRevision; a justified exclusion
                 * belongs in the reconciliation record. No actual article is identified yet. */
            }
            part ic01Installation : PlannedInstallation {
                ref part :>> design = BlueDog::Configurations::IC01::design;
                ref part :>> assembly = BlueDog::Architecture::Physical::ic01;
            }
            part def ResourceScope {
                attribute label : String [1];
                attribute quantityKind : String [1];
                ref part configuration : MarineDesign::Design [1] = BlueDog::Configurations::IC01::design;
                attribute boundary : String [1];
                attribute mode : String [1];
                attribute ownerRole : String [1];
                attribute basis : String [1];
                attribute closureEvidenceNeeded : String [1];
                attribute massAllocation : MassValue [0..1];
                attribute massEstimate : MassValue [0..1];
                attribute averagePowerAllocation : PowerValue [0..1];
                attribute peakPowerBound : PowerValue [0..1];
                attribute nameplateEnergy : EnergyValue [0..1];
                attribute departureEnergy : EnergyValue [0..1];
                attribute acquisitionLatency : TimeValue [0..1];
                attribute assessmentLatency : TimeValue [0..1];
                attribute commandLatency : TimeValue [0..1];
                attribute maneuverDuration : TimeValue [0..1];
                attribute coverageReviewed : Boolean default = false;
                attribute measurementsAccepted : Boolean default = false;
                attribute accountingReconciled : Boolean default = false;
                attribute evidenceRecord : String [0..1];
                attribute contextIdentified : Boolean = label != "" and quantityKind != "" and boundary != "" and
                    mode != "" and ownerRole != "" and basis != "" and closureEvidenceNeeded != "";
                attribute quantitiesValid : Boolean =
                    massAllocation->ControlFunctions::forAll { in v : MassValue; v >= 0 [kg] } and
                    massEstimate->ControlFunctions::forAll { in v : MassValue; v >= 0 [kg] } and
                    averagePowerAllocation->ControlFunctions::forAll { in v : PowerValue; v >= 0 [W] } and
                    peakPowerBound->ControlFunctions::forAll { in v : PowerValue; v >= 0 [W] } and
                    nameplateEnergy->ControlFunctions::forAll { in v : EnergyValue; v >= 0 [J] } and
                    departureEnergy->ControlFunctions::forAll { in v : EnergyValue; v >= 0 [J] } and
                    acquisitionLatency->ControlFunctions::forAll { in v : TimeValue; v >= 0 [s] } and
                    assessmentLatency->ControlFunctions::forAll { in v : TimeValue; v >= 0 [s] } and
                    commandLatency->ControlFunctions::forAll { in v : TimeValue; v >= 0 [s] } and
                    maneuverDuration->ControlFunctions::forAll { in v : TimeValue; v >= 0 [s] };
                attribute requiredQuantitiesPresent : Boolean default = false;
                attribute ready : Boolean = contextIdentified and requiredQuantitiesPresent and quantitiesValid and coverageReviewed and measurementsAccepted and accountingReconciled and
                    SequenceFunctions::size(evidenceRecord) == 1 and
                    evidenceRecord->ControlFunctions::forAll { in v : String; v != "" };
                doc /* Allocations are bound to existing owners, not added measurements.
                 * Empty quantities are unknown/not supplied or outside the row's scope.
                 * Review the boundary and quantityKind before interpreting or aggregating.
                 * No total, headroom or zero entry is fabricated for missing information. */
            }
            part def AccountingCase {
                ref part installation : PlannedInstallation [1];
                part scopes : ResourceScope [1..*];
            }
            part ic01 : AccountingCase {
                ref part :>> installation = ic01Installation;
                part wholeVesselMass : ResourceScope subsets scopes {
                    attribute :>> requiredQuantitiesPresent = SequenceFunctions::size(massEstimate) == 1;
                    attribute :>> label = "Whole-vessel mass estimate, not supplied in this register";
                    attribute :>> quantityKind = "Total vessel mass estimate; distinct from component allowances";
                    attribute :>> boundary = "Complete loaded vessel: structure, rig, appendages, batteries, equipment, attachment and support/finish contributions. Fixed equipment is one contribution; do not add it again after a complete native mass rollup.";
                    attribute :>> mode = "Same loaded IC-01 geometry, equipment and carried-fluid configuration as the associated performance/handling/recovery study";
                    attribute :>> ownerRole = "System integration/mass";
                    attribute :>> basis = "A new identified coupled/native MassProperties execution is needed to populate this register. Historical IC-01 or reference-design estimates keep their own recorded source/configuration; none is silently substituted here.";
                    attribute :>> closureEvidenceNeeded = "Current coupled/native mass/CG result with exact source/geometry inputs, complete installation reconciliation and weighed-article evidence for physical claims; compare with the applicable handling criterion";
                }
                part mainStorage : ResourceScope subsets scopes {
                    attribute :>> requiredQuantitiesPresent = SequenceFunctions::size(nameplateEnergy) == 1 and SequenceFunctions::size(departureEnergy) == 1;
                    attribute :>> label = "Main sailing storage account";
                    attribute :>> quantityKind = "Nameplate and allocated departure stored energy; successive states";
                    attribute :>> boundary = "One main bank; nameplate, usable and departure states are not additive. Sailing withdrawal/losses/self-discharge and its protected reserve belong to the same finite-passage screen. Independent recovery storage is separate; no cross-bank transfer is credited.";
                    attribute :>> mode = "Finite-Gorge passage/holds with current sizing usable/departure fractions; no solar credit in the IC-01 integration hypothesis";
                    attribute :>> ownerRole = "Power/energy integration";
                    attribute :>> basis = "BlueDog::Configurations::IC01.design.battery_Wh and BlueDog::Configurations::OperatingEnvironment.Inputs usable_fraction/initial_fraction; existing allocations, not measured storage capability";
                    attribute :>> nameplateEnergy = BlueDog::Configurations::IC01::design.battery_Wh * 3600 [J];
                    attribute :>> departureEnergy = nameplateEnergy * BlueDog::Configurations::OperatingEnvironment::Inputs.usable_fraction * BlueDog::Configurations::OperatingEnvironment::Inputs.initial_fraction;
                    attribute :>> closureEvidenceNeeded = "Installed bank usable capacity, initial energy and temperature/end-of-service basis; complete withdrawal/reserve history and measured voltage/current/peak capability, coupled passage and casualty assessment";
                }
                part fixedEquipment : ResourceScope subsets scopes {
                    attribute :>> requiredQuantitiesPresent = SequenceFunctions::size(massAllocation) == 1;
                    attribute :>> label = "Fixed-equipment mass allowance";
                    attribute :>> quantityKind = "Mass allocation, not total vessel mass";
                    attribute :>> boundary = "Base fixed equipment plus additional equipment plus recovery battery mass. Wind installation, geometry/materials, main battery and actuator models are accounted separately; do not add the recovery battery again.";
                    attribute :>> mode = "Candidate installed mass/CG accounting across sailing and recovery";
                    attribute :>> ownerRole = "System integration/mass";
                    attribute :>> basis = "BlueDog::Configurations::IC01.integration.fixedEquipmentKg; specific-energy conversion is an allowance, not weighed hardware";
                    attribute :>> massAllocation = BlueDog::Configurations::IC01::integration.fixedEquipmentKg * 1 [kg];
                    attribute :>> closureEvidenceNeeded = "Complete non-overlapping BOM, installation/support mass and locations; weighed articles, packaging and coupled mass/CG/performance reconciliation";
                }
                part sailingElectronics : ResourceScope subsets scopes {
                    attribute :>> requiredQuantitiesPresent = SequenceFunctions::size(averagePowerAllocation) == 1 and SequenceFunctions::size(peakPowerBound) == 1;
                    attribute :>> label = "Sailing electronics bus allowance";
                    attribute :>> quantityKind = "Average bus power allocation; peak unknown";
                    attribute :>> boundary = "Base electronics including separately provisioned wired wind plus additionalBusW. The additional 8W is inside this row, not another additive load; actuator demand is separate.";
                    attribute :>> mode = "Qualifying sailing/holds under the declared performance and duty assumptions";
                    attribute :>> ownerRole = "Power/sensing integration";
                    attribute :>> basis = "BlueDog::Configurations::IC01.integration.electronicsW; no installed component split or startup/stall/coincident peak bound";
                    attribute :>> averagePowerAllocation = BlueDog::Configurations::IC01::integration.electronicsW * 1 [W];
                    attribute :>> closureEvidenceNeeded = "Selected acquisition/processing/navigation/recording/communications/signaling/support loads, explicit replacements, measured duty/thermal/peak performance and supplied bus compatibility";
                }
                part recoveryEssentials : ResourceScope subsets scopes {
                    attribute :>> requiredQuantitiesPresent = SequenceFunctions::size(averagePowerAllocation) == 1 and SequenceFunctions::size(peakPowerBound) == 1;
                    attribute :>> label = "Recovery essential-load allowance";
                    attribute :>> quantityKind = "Active recovery withdrawal-power allocation; peak unknown";
                    attribute :>> boundary = "8W essentials used by the recovery demand model, separately from active motor and voyage standby. Not a measured bus split; record-storage and telemetry supply assignment is unresolved.";
                    attribute :>> mode = "Active upright/inverted recovery after loss of primary sailing";
                    attribute :>> ownerRole = "Recovery/power";
                    attribute :>> basis = "BlueDog::Configurations::IC01.integration.recoveryEssentialW; preserve the recovery model's battery-withdrawal boundary and do not apply bus conversion twice";
                    attribute :>> averagePowerAllocation = BlueDog::Configurations::IC01::integration.recoveryEssentialW * 1 [W];
                    attribute :>> closureEvidenceNeeded = "Installed surviving functions, actual supply topology, conversions, simultaneous load and fault isolation; measured casualty performance";
                }
                part recoveryStorage : ResourceScope subsets scopes {
                    attribute :>> requiredQuantitiesPresent = SequenceFunctions::size(nameplateEnergy) == 1 and SequenceFunctions::size(departureEnergy) == 1;
                    attribute :>> label = "Independent recovery storage account";
                    attribute :>> quantityKind = "Nameplate and departure stored energy; successive states";
                    attribute :>> boundary = "Nameplate and departure are not additive capacity. Standby depletes departure energy; route/casualty demand is assessed against the remaining bank. Main-pack protected reserve remains a separate conservative screen, with no pack transfer credited.";
                    attribute :>> mode = "Voyage standby then route-dependent casualty recovery";
                    attribute :>> ownerRole = "Recovery/energy";
                    attribute :>> basis = "BlueDog::Configurations::IC01.integration.recoveryBatteryWh/recoveryDepartureWh; 1Wh=3600J";
                    attribute :>> nameplateEnergy = BlueDog::Configurations::IC01::integration.recoveryBatteryWh * 3600 [J];
                    attribute :>> departureEnergy = BlueDog::Configurations::IC01::integration.recoveryDepartureWh * 3600 [J];
                    attribute :>> closureEvidenceNeeded = "Same installed bank's temperature/end-of-service usable capacity, initial energy, standby history and casualty route demand, peaks and no-transfer/isolation evidence";
                }
                part responseTiming : ResourceScope subsets scopes {
                    attribute :>> requiredQuantitiesPresent = SequenceFunctions::size(acquisitionLatency) == 1 and SequenceFunctions::size(assessmentLatency) == 1 and SequenceFunctions::size(commandLatency) == 1 and SequenceFunctions::size(maneuverDuration) == 1;
                    attribute :>> label = "Allocated encounter response stages";
                    attribute :>> quantityKind = "Individual time allowances, not an accepted end-to-end bound";
                    attribute :>> boundary = "Acquisition/assessment/command/maneuver allowances belong to separate response stages. Queueing, overlap, clock uncertainty and occupied-actuator delay need a whole-path model; do not infer a complete deadline by adding labels.";
                    attribute :>> mode = "Local IC-01 encounter hypothesis, including degraded/occupied response";
                    attribute :>> ownerRole = "Control/sensing integration";
                    attribute :>> basis = "BlueDog::Configurations::IC01.integration.sensorLatencyS/assessmentS/commandS/maneuverS";
                    attribute :>> acquisitionLatency = BlueDog::Configurations::IC01::integration.sensorLatencyS * 1 [s];
                    attribute :>> assessmentLatency = BlueDog::Configurations::IC01::integration.assessmentS * 1 [s];
                    attribute :>> commandLatency = BlueDog::Configurations::IC01::integration.commandS * 1 [s];
                    attribute :>> maneuverDuration = BlueDog::Configurations::IC01::integration.maneuverS * 1 [s];
                    attribute :>> closureEvidenceNeeded = "Synchronized installed observations, scheduling, delivered command and achieved motion, interacting faults and current class/clearance acceptance criteria";
                }
            }
            analysis def AccountingReview {
                subject account : AccountingCase;
                out attribute scopeCount : Integer = SequenceFunctions::size(account.scopes);
                out attribute allScopesSameConfiguration : Boolean = account.scopes->ControlFunctions::forAll {
                    in row : ResourceScope; row.configuration == account.installation.design };
                out attribute installationReconciled : Boolean = account.installation.configurationReconciled;
                out attribute resourceEvidenceReady : Boolean = scopeCount > 0 and account.scopes->ControlFunctions::forAll {
                    in row : ResourceScope; row.ready };
                return ready : Boolean = allScopesSameConfiguration and installationReconciled and resourceEvidenceReady;
            }
            analysis currentReview : AccountingReview { subject = ic01; }
            dependency wholeMassBasis from ic01::wholeVesselMass to BlueDog::Analyses::Sizing::MassProperties;
            dependency mainStorageBasis from ic01::mainStorage to BlueDog::Configurations::IC01::design::battery_Wh;
            dependency massBasis from ic01::fixedEquipment to BlueDog::Configurations::IC01::integration::fixedEquipmentKg;
            dependency sailingBasis from ic01::sailingElectronics to BlueDog::Configurations::IC01::integration::electronicsW;
            dependency recoveryLoadBasis from ic01::recoveryEssentials to BlueDog::Configurations::IC01::integration::recoveryEssentialW;
            dependency storageBasis from ic01::recoveryStorage to BlueDog::Analyses::IntegratedCandidate::RecoveryScreen;
            dependency timingBasis from ic01::responseTiming to BlueDog::Analyses::EncounterReview::criteria;
            metadata issue : ModelingMetadata::Issue { text = "C-01: Identify installed article/hardware/software-data/procedure revisions and reconcile actual configuration. C-02: Replace lumped allowances with non-overlapping measured installation accounting, including signal/record/telemetry and recovery supplies. C-03: Reconcile modes, peaks, storage/conversion/reserve boundaries and mass/CG/performance coupling. C-04: Establish uncertainty/margin and change/retest triggers from evidence; none of these accounting scopes is accepted physical evidence."; }
        }

        package OperatingEnvironment {
            private import ScalarValues::*;
            private import SI::*;
            analysis Inputs {
                doc /* Provisional operating and energy allocations. Physical values remain separate from numerical optimizer tolerances. */
                out attribute foil_alpha_limit_deg : Real = 12;
                out attribute rudder_inflow_ratio : Real = 0.8;
                out attribute hinge_fraction : Real = RealFunctions::abs(BlueDog::Analyses::Sizing::Credibility::policy.rudderStockChordFraction-BlueDog::Analyses::Sizing::Credibility::policy.rudderLoadChordFraction);
                out attribute friction_Nm : Real = 0.02;
                out attribute max_froude : Real = 0.65;
                out attribute min_wing_Re : Real = 60000;
                out attribute min_foil_Re : Real = 30000;
                out attribute yaw_reserve_Nm : Real = 0.5;
                out attribute control_speed_m_s : Real = 0.5;
                out attribute control_wind_m_s : Real = 5;
                out attribute peak_irradiance_W_m2 : Real = 1000;
                out attribute panel_efficiency : Real = 0.2;
                out attribute harvest_efficiency : Real = 0.85;
                out attribute charge_efficiency : Real = 0.9;
                out attribute discharge_efficiency : Real = 0.9;
                out attribute usable_fraction : Real = 0.8;
                out attribute initial_fraction : Real = 0.9;
                out attribute charge_C_rate : Real = 0.5;
                out attribute discharge_C_rate : Real = 1.5;
                out attribute self_discharge_W : Real = 0.02;
                out attribute dark_hours : Real = 18;
                out attribute solar_hours : Real = 6;
                comment reserveScreen /* Synthetic comparison exposure only; mission feasibility requires the course-dependent reserve provider. */
                out attribute reserve_Wh : Real = BlueDog::Requirements::RecoveryReserveDemand(50 [W], 8 [W], 1800 [s], 7200 [s], 1.2) / (3600 [J]);
                out attribute wingMomentScale : Real = BlueDog::Analyses::AerodynamicPolicy::sizing.momentScale;
                out attribute parameterNames : String [*] ordered nonunique = ("foil_alpha_limit_deg", "rudder_inflow_ratio", "hinge_fraction", "friction_Nm", "max_froude", "min_wing_Re", "min_foil_Re", "yaw_reserve_Nm", "control_speed_m_s", "control_wind_m_s", "peak_irradiance_W_m2", "panel_efficiency", "harvest_efficiency", "charge_efficiency", "discharge_efficiency", "usable_fraction", "initial_fraction", "charge_C_rate", "discharge_C_rate", "self_discharge_W", "dark_hours", "solar_hours", "reserve_Wh", "wingMomentScale");
                out attribute parameterValues : Real [*] ordered nonunique = (foil_alpha_limit_deg, rudder_inflow_ratio, hinge_fraction, friction_Nm, max_froude, min_wing_Re, min_foil_Re, yaw_reserve_Nm, control_speed_m_s, control_wind_m_s, peak_irradiance_W_m2, panel_efficiency, harvest_efficiency, charge_efficiency, discharge_efficiency, usable_fraction, initial_fraction, charge_C_rate, discharge_C_rate, self_discharge_W, dark_hours, solar_hours, reserve_Wh, wingMomentScale);
            }
        }

        package SensingEquipment {
            doc /* Physical installation hypotheses reviewed 2026-10-16. Supplier specifications are component inputs, not demonstrated detection range, latency or full installed budgets. See evidence/sensing/2026-10-16/sources.json and docs/reference/sensing-configurations.md. No sensing simulation is changed by this package.*/
            private import ScalarValues::*;
            part fixedHighResolution {
                doc /* SC-01: four Luxonis OAK-1 W IMX378 fixed-focus cameras at 90 degree azimuth spacing; on-camera RVC2 inference; Raspberry Pi4 ModelB host; externally powered USB3 hub; Quark QK-A026 AIS/GPS and separate antennas. Four95deg horizontal fields give only5deg nominal adjacent overlap before occlusion or calibration.*/
                attribute id : String = "SC-01";
                attribute cameraCount : Real = 4;
                attribute horizontalPixels : Real = 4056;
                attribute horizontalFovDeg : Real = 95;
                attribute cameraMassKg : Real = 0.0531;
                attribute cameraStreamingLowW : Real = 2.5;
                attribute cameraStreamingHighW : Real = 3.0;
                attribute cameraAiAllowanceW : Real = 1.0;
                attribute cameraEncoderAllowanceW : Real = 0.5;
                attribute knownCameraMassKg : Real = 0.2124;
                attribute nominalOverlapDeg : Real = 5;
                attribute primaryPlanningMassKg : Real = 0.9824;
                attribute cameraStreamingSubtotalLowW : Real = 10.0;
                attribute cameraFeatureAllowanceHighW : Real = 18.0;
                attribute installedBudgetComplete : Boolean = false;
                attribute rangeDemonstrated : Boolean = false;
                attribute latencyDemonstrated : Boolean = false;
                attribute invertedObservationDemonstrated : Boolean = false;
                attribute independentRecoveryComplete : Boolean = false;
                attribute recoveryBlocker : String = "Separate recovery power alone is insufficient: independent host, observation geometry, navigation, antennas and sealed upright/inverted mounting remain unselected. No primary camera/hub credit after shared failure or immersion.";
            }
            part fixedGlobalShutter {
                doc /* SC-02: three Luxonis OAK-1 W OV9782 fixed-focus global-shutter cameras at120degree spacing; same Pi4B host, powered hub andQKA026 AIS/GPS. Three127degree fields give7degree nominal adjacent overlap. Lower resolution trades angular detail for fewer camera loads.*/
                attribute id : String = "SC-02";
                attribute cameraCount : Real = 3;
                attribute horizontalPixels : Real = 1280;
                attribute horizontalFovDeg : Real = 127;
                attribute cameraMassKg : Real = 0.0531;
                attribute cameraStreamingLowW : Real = 2.5;
                attribute cameraStreamingHighW : Real = 3.0;
                attribute cameraAiAllowanceW : Real = 1.0;
                attribute cameraEncoderAllowanceW : Real = 0.5;
                attribute knownCameraMassKg : Real = 0.1593;
                attribute nominalOverlapDeg : Real = 7;
                attribute primaryPlanningMassKg : Real = 0.8493;
                attribute cameraStreamingSubtotalLowW : Real = 7.5;
                attribute cameraFeatureAllowanceHighW : Real = 13.5;
                attribute installedBudgetComplete : Boolean = false;
                attribute rangeDemonstrated : Boolean = false;
                attribute latencyDemonstrated : Boolean = false;
                attribute invertedObservationDemonstrated : Boolean = false;
                attribute independentRecoveryComplete : Boolean = false;
                attribute recoveryBlocker : String = "Separate recovery power alone is insufficient: independent host, observation geometry, navigation, antennas and sealed upright/inverted mounting remain unselected. No primary camera/hub credit after shared failure or immersion.";
            }
            part scanningCamera {
                doc /* SC-03: one OAK-1 W IMX378 on Hitec HS785HB azimuth winch, Pololu Micro Maestro6 controller, Pi4B host, powered hub andQKA026 AIS/GPS. Bounded360degree sweep and cable-safe return; splash-only servo requires sealed installation. Revisit delay is unresolved; not credited with simultaneous coverage.*/
                attribute id : String = "SC-03";
                attribute cameraCount : Real = 1;
                attribute horizontalPixels : Real = 4056;
                attribute horizontalFovDeg : Real = 95;
                attribute cameraMassKg : Real = 0.0531;
                attribute servoMassKg : Real = 0.11;
                attribute controllerMassKg : Real = 0.0048;
                attribute servoSupplyV : Real = 6.0;
                attribute servoIdleA : Real = 0.008;
                attribute servoNoLoadA : Real = 0.25;
                attribute servoStallA : Real = 1.8;
                attribute servoSecondsPer60Deg : Real = 1.38;
                attribute idealFullSweepSeconds : Real = 8.28;
                attribute primaryPlanningMassKg : Real = 0.7679;
                attribute installedBudgetComplete : Boolean = false;
                attribute rangeDemonstrated : Boolean = false;
                attribute latencyDemonstrated : Boolean = false;
                attribute invertedObservationDemonstrated : Boolean = false;
                attribute independentRecoveryComplete : Boolean = false;
                attribute recoveryBlocker : String = "Separate recovery power alone is insufficient: independent host, observation geometry, navigation, antennas and sealed upright/inverted mounting remain unselected. No primary camera/hub credit after shared failure or immersion.";
            }
            part underwaterOption {
                doc /* Blue Robotics Ping360 optional submerged sector scanner. Range is supplier instrument range, not weed detection evidence. Adds drag, mount and snag risk. Primary sonar mounted below hull may emerge when inverted; no recovery backup credit.*/
                attribute massWithCableKg : Real = 0.51;
                attribute supplierMaxPowerW : Real = 5.0;
                attribute supplierMaxRangeM : Real = 50.0;
                attribute fullScanAtMaxRangeSeconds : Real = 33.0;
                attribute minimumTemperatureC : Real = 0.0;
                attribute maximumTemperatureC : Real = 30.0;
            }
            part radarReference {
                doc /* Garmin GMRFantom18x is ruled out as an IC01 drop-in: component alone exceeds added mass allocation and electrical demand. Retained as size/power comparison, not an installation candidate.*/
                attribute componentMassKg : Real = 6.35;
                attribute supplierNormalMaxPowerW : Real = 33.0;
                attribute supplierSaveMaxPowerW : Real = 24.0;
                attribute supplierStandbyMaxPowerW : Real = 4.0;
            }
            part budgetBasis {
                doc /* IC01 current base4.5W plus8W increment and1.2kg additional equipment. The full4.5W cannot be freely reassigned if navigation/comms/recording remain. Shared replacements require explicit reconciliation. Recovery battery mass remains separate, recovery electronics/propulsion allocations must not be double-counted.*/
                attribute baseElectronicsW : Real = 4.5;
                attribute additionalSensingW : Real = 8.0;
                attribute additionalEquipmentKg : Real = 1.2;
                attribute aisSupplierMaxW : Real = 0.6;
            }
            part supportAllowances {
                doc /* Unmeasured project planning allowances per primary installation: Pi4B3-6W, powered hub0.3-1W, DC conversion0.90 efficiency; common support mass0.450kg for host, hub, storage, receivers/antennas, wiring, fusing and common case. Ring camera housing/mount allowance0.080kg per camera; scanner sealed bearing/mount allowance0.150kg. These are design targets, not supplier totals. Recovery-side sensing, washing/heating and any structural reinforcement excluded and unresolved.*/
                attribute hostLowW : Real = 3.0;
                attribute hostHighW : Real = 6.0;
                attribute hubLowW : Real = 0.3;
                attribute hubHighW : Real = 1.0;
                attribute conversionEfficiency : Real = 0.9;
                attribute commonPrimaryMassKg : Real = 0.45;
                attribute perFixedCameraHousingKg : Real = 0.08;
                attribute scannerMountKg : Real = 0.15;
            }
        }

        package StudyPlan {
            private import ScalarValues::*;
            part operatingCoverage {
                doc /* Numerical operating coverage, not a new environmental requirement.
                 * Eight cases combine two winds, windward/leeward travel and both tacks.
                 * State order: speed m/s, true-wind angle, incidence, leeway, rudder, heel;
                 * all angles degrees, represented on positive tack and reflected in Python.
                 * Incidence coverage is constrained by the recorded aerodynamic grid. */
                attribute windSpeeds : Real [2] ordered = (5, 8);
                attribute stateLower : Real [6] ordered nonunique = (0.2,20,BlueDog::Analyses::AerodynamicPolicy::sizing.incidenceLowDeg,-12,-25,-BlueDog::Analyses::AerodynamicPolicy::sizing.heelLimitDeg);
                attribute stateUpper : Real [6] ordered nonunique = (5,88,BlueDog::Analyses::AerodynamicPolicy::sizing.incidenceHighDeg,12,25,BlueDog::Analyses::AerodynamicPolicy::sizing.heelLimitDeg);
                attribute leewardHeading : Real [2] ordered = (95,175);
                attribute progressSearchReserve : Real = 0.005;
                attribute coarseTrims : Real [2] ordered = (0,90);
                attribute coarseHeels : Real [8] ordered = (-175,-150,-90,-15,15,90,150,175);
                attribute recoveryTrims : Real [4] ordered = (0,90,180,270);
                attribute recoveryDensities : Real [2] ordered = (1000,1025);
                attribute recoveryHeels : Real [3] ordered = (-180,180,49);
                metadata rationale : ModelingMetadata::Rationale { text = "Paired tacks expose the fixed-camber wing asymmetry. Numerical brackets bound a local solve; they do not establish optimality beyond the search domain. Coarse restoring samples screen the search; full-roll free-pitch replay and freshwater/seawater ingress cases assess the candidate. The progress reserve is a mesh allowance, not a physical safety margin."; }
            }
            dependency operatingPurpose from operatingCoverage to BlueDog::Requirements::cruiseEvidence;
            dependency recoveryPurpose from operatingCoverage to BlueDog::Requirements::selfRighting;
            dependency uncertaintyBasis from operatingCoverage to BlueDog::Decisions::Design::uncertaintyPolicy;
        }

        package WindEquipment {
            private import ScalarValues::*;
            private import OOSEM::hardware;
            #hardware part def Installation {
                attribute product : String;
                attribute dataInterface : String;
                attribute sensorMassKg : Real;
                attribute installationAllowanceKg : Real;
                attribute installedMassKg : Real = sensorMassKg + installationAllowanceKg;
                attribute sensorSupplyW : Real;
                attribute interfaceAllowanceW : Real;
                attribute conversionEfficiency : Real;
                attribute powerMargin : Real;
                attribute busPowerW : Real = (sensorSupplyW + interfaceAllowanceW) * powerMargin / conversionEfficiency;
                attribute internalBatteryRuntimeHours : Real;
                attribute xFraction : Real;
                attribute aboveDeckM : Real;
                attribute evidenceAccepted : Boolean = false;
            }
            part testbed : Installation {
                doc /* Historical installation allowance for the retired separate testbed concept.
                 * The owned sensor remains available for component experiments; this is
                 * not a planned first boat or a selected IC-01 installation. */
                attribute :>> product = "Calypso Ultrasonic Portable Mini";
                attribute :>> dataInterface = "Bluetooth; internal battery; shore Qi charging";
                attribute :>> sensorMassKg = 0.078;
                attribute :>> installationAllowanceKg = 0.05;
                attribute :>> sensorSupplyW = 0;
                attribute :>> interfaceAllowanceW = 0.05;
                attribute :>> conversionEfficiency = 0.9;
                attribute :>> powerMargin = 1.25;
                attribute :>> internalBatteryRuntimeHours = 150;
                attribute :>> xFraction = 0;
                attribute :>> aboveDeckM = 0.3;
                metadata rationale : ModelingMetadata::Rationale { text = "Owner has the battery/Bluetooth sensor originally considered for the retired testbed concept and available for component experiments. Manufacturer lists 78 g including internal battery, 43 mm diameter, 47 mm height, 1 Hz, Bluetooth 5.1, Qi charging and 150 hours active use: https://www.calypsoinstruments.com/shop/ultrasonic-portable-mini-wind-meter-221 . The 50 g mount and 50 mW receiver are project allowances, not product specifications. Sensor energy comes from its own battery; zero vessel-bus sensor power does not mean zero sensor consumption."; }
                metadata issue : ModelingMetadata::Issue { text = "Confirm owned 25 or 45 m/s variant and firmware. Measure runtime, receiver power, disconnection behavior and charging between tests. Internal battery capacity and energy use are not published here; 150 hours is a supplier runtime claim, not an endurance verification."; }
            }
            part challenge : Installation {
                attribute :>> product = "Calypso ULP Wired Mini, 45 m/s UART variant";
                attribute :>> dataInterface = "UART 38400 baud, 1 Hz, 5 V vessel supply";
                attribute :>> sensorMassKg = 0.078;
                attribute :>> installationAllowanceKg = 0.072;
                attribute :>> sensorSupplyW = 5 * 0.00015;
                attribute :>> interfaceAllowanceW = 0.05;
                attribute :>> conversionEfficiency = 0.9;
                attribute :>> powerMargin = 1.25;
                attribute :>> internalBatteryRuntimeHours = 0;
                attribute :>> xFraction = 0;
                attribute :>> aboveDeckM = 0.3;
                metadata rationale : ModelingMetadata::Rationale { text = "Owner restricts the provisional challenge choice to a wired Calypso. The ULP Wired Mini data sheet lists 78 g, 43 by 47 mm, 3.3–5 V, UART, and 0.15 mA at 5 V/38400 baud/1 Hz: https://www.calypsoinstruments.com/web/content/62187?download=true . Select the 45 m/s variant to cover more than the 25 m/s version. The 72 g cable/mount/interface allocation, 50 mW interface draw, 90 percent conversion and 25 percent power margin are project allowances. The generic 2.5 kg equipment and 4.5 W electronics allocations exclude this separately budgeted installation."; }
                metadata issue : ModelingMetadata::Issue { text = "Confirm currently orderable SKU and peak/startup power; 1 Hz data-sheet consumption is not a measured worst case. Qualify weather exposure, immersion and installed-flow errors. Centerline mounting 0.3 m above deck is a mass-centroid placeholder; finalize unobstructed siting and cable layout. Sensor displaced volume and windage remain outside the current geometry model."; }
            }
            dependency challengeSelection from challenge to BlueDog::Requirements::windObservation;
            dependency challengeEndurance from challenge to BlueDog::Requirements::windSensingEndurance;
            dependency testbedLearning from testbed to BlueDog::Requirements::windObservation;
            dependency logicalAllocation from challenge to BlueDog::Architecture::WindSensing;
            analysis Rollup {
                out attribute testbedInstalledMassKg : Real = testbed.installedMassKg;
                out attribute testbedVesselBusW : Real = testbed.busPowerW;
                out attribute testbedSupplierRuntimeHours : Real = testbed.internalBatteryRuntimeHours;
                out attribute challengeInstalledMassKg : Real = challenge.installedMassKg;
                out attribute challengeVesselBusW : Real = challenge.busPowerW;
                out attribute challengeEnergyPerDayWh : Real = challenge.busPowerW * 24;
                out attribute challengeEvidenceAccepted : Boolean = challenge.evidenceAccepted;
            }
        }
    }

    package Decisions {

        package Context {
            private import ScalarValues::*;
            metadata def Context {
                attribute kind : String [1];
                attribute decisionQuestion : String [0..1];
                attribute scope : String [1];
                attribute ownerRole : String [0..1];
                attribute criteriaBasis : String [1];
                attribute comparisonBasis : String [1];
                attribute reopenTrigger : String [1];
                attribute dispositionRecord : String [0..1];
                attribute authorityIdentity : String [0..1];
                attribute decisionDate : String [0..1];
                attribute implementationEvidence : String [0..1];
            }
            metadata sizingBaseline : Context about BlueDog::Decisions::Design::sizingBaseline {
                kind = "Numerical baseline";
                decisionQuestion = "Which available geometry supports the first coupled sizing calculation?";
                scope = "Finite Gorge sizing/reference CAD; no hardware rig downselect.";
                criteriaBasis = "Applicable mission and safety obligations remain mandatory.";
                comparisonBasis = "Compare all three rigs using measured performance, durability, energy and recovery on common cases.";
                reopenTrigger = "New comparable rig evidence, changed geometry/domain or a proposed hardware selection.";
                ownerRole = "Project owner";
            }
            metadata holdingDrive : Context about BlueDog::Decisions::Design::holdingDrive {
                kind = "Option investigation";
                decisionQuestion = "Should non-backdrivable gearing remain an actuator option?";
                scope = "Finite Gorge move/hold/standby energy, shock/jam and recovery; future endurance separate.";
                criteriaBasis = "Launch/recovery energy, controllability and casualty response cannot be traded away.";
                comparisonBasis = "Compare complete drive mass, efficiency, idle/move/hold energy, wear, depower and construction effort.";
                reopenTrigger = "Measured holding/efficiency/failure behavior or changed actuator/energy/safety assumptions.";
                ownerRole = "Project owner";
            }
            metadata aerodynamicScope : Context about BlueDog::Decisions::Design::aerodynamicScope {
                kind = "Analysis-use policy";
                decisionQuestion = "What can the provisional VSPAERO response support?";
                scope = "Restricted attached-flow sizing of the reference section, not a measured candidate polar.";
                criteriaBasis = "Respect declared analysis domain and mission-evidence obligations.";
                comparisonBasis = "Convergence and domain sensitivity inform use; additional calculations do not prefer the rig.";
                reopenTrigger = "New measurements, solver/domain changes or a use beyond the declared polar envelope.";
                ownerRole = "Project owner";
            }
            metadata structuralScope : Context about BlueDog::Decisions::Design::structuralScope {
                kind = "Analysis credit policy";
                decisionQuestion = "Which structural contributions receive preliminary bending credit?";
                scope = "Current hybrid printed/composite sizing; production joints and wet/aged properties unaccepted.";
                criteriaBasis = "Applicable structural integrity, manufacturing boundary and verification requirements.";
                comparisonBasis = "Compare complete mass, section behavior, constructability and test-supported material/joint alternatives.";
                reopenTrigger = "New wet/joint/fatigue/buckling data, changed construction or load envelope.";
                ownerRole = "Project owner";
            }
            metadata recoveryScope : Context about BlueDog::Decisions::Design::recoveryScope {
                kind = "Analysis-use policy";
                decisionQuestion = "What recovery claim can static restoring curves support?";
                scope = "Static full-roll sensitivities for identified geometries; dynamic self-righting separate.";
                criteriaBasis = "Self-righting, safe casualty control, independent recovery and retrieval obligations.";
                comparisonBasis = "Compare geometry, pitch stability, water state, control restoration and dynamic trajectories.";
                reopenTrigger = "New dynamic releases, water-state geometry, failures or changed recovery use.";
                ownerRole = "Project owner";
            }
            metadata energyEvidenceAcceptance : Context about BlueDog::Decisions::Design::energyEvidenceAcceptance {
                kind = "Evidence-acceptance policy";
                decisionQuestion = "What evidence would support setting energy evidenceAccepted?";
                scope = "Same installed configuration and declared sustained-operation use; finite Gorge energy remains separately scoped.";
                criteriaBasis = "Required functions, non-overlapping accounts and actual evidence/readiness obligations.";
                comparisonBasis = "Compare bound adequacy and uncertainty; a review Boolean is not an automatic evidence audit.";
                reopenTrigger = "Changed installation, duty, temperature/service age, usable storage, harvester or required functions.";
                ownerRole = "Project owner";
            }
            metadata uncertaintyPolicy : Context about BlueDog::Decisions::Design::uncertaintyPolicy {
                kind = "Interpretation policy";
                decisionQuestion = "How should nominal solutions, adverse sensitivities and qualification be interpreted?";
                scope = "Local sizing/search and declared environmental/construction sensitivities.";
                criteriaBasis = "Preserve mission requirements and report calculation/domain limitations.";
                comparisonBasis = "Compare robust margins and consequential sensitivities; brackets/reserves are not accepted safety factors or probabilities.";
                reopenTrigger = "Measured bounds, new adverse cases, solver/domain changes or proposed qualification use.";
                ownerRole = "Project owner";
            }
            metadata trafficCourtesy : Context about BlueDog::Decisions::Design::trafficCourtesy {
                kind = "Operational design preference";
                decisionQuestion = "How should alternatives reduce the burden on crewed traffic while meeting navigation duties?";
                scope = "Common finite Gorge traffic scenarios; planner preference not yet implemented or validated.";
                criteriaBasis = "Navigation duties, predictable required behavior, collision safety and permitted interventions.";
                comparisonBasis = "Compare close encounters, predicted other-vessel action and mission delay; no inference about another skipper's motives.";
                reopenTrigger = "Changed traffic/rule context, sensing/planning capability or contrary encounter evidence.";
                ownerRole = "Project owner";
            }
            metadata trafficAcceptance : Context about BlueDog::Decisions::OpenQuestions::trafficAcceptance {
                kind = "Open acceptance question";
                scope = "Current Gorge class-specific traffic/rule applicability and installed response evidence.";
                criteriaBasis = "Applicable supporting requirements and the evidence named by this open question; unaccepted criteria remain open.";
                comparisonBasis = "Evidence sufficiency and applicability review; no hardware ranking or invented utility score.";
                reopenTrigger = "Observation/response errors, changed class/context/rules or new installed evidence.";
            }
            metadata recoveryAcceptance : Context about BlueDog::Decisions::OpenQuestions::recoveryAcceptance {
                kind = "Open acceptance question";
                scope = "Current Gorge course-wide powered recovery, capture/retention and human retrieval.";
                criteriaBasis = "Applicable supporting requirements and the evidence named by this open question; unaccepted criteria remain open.";
                comparisonBasis = "Evidence sufficiency and applicability review; no hardware ranking or invented utility score.";
                reopenTrigger = "Changed shores/current/casualty envelope, supplies or recovery/retrieval capability.";
            }
            metadata structuralQualification : Context about BlueDog::Decisions::OpenQuestions::structuralQualification {
                kind = "Open acceptance question";
                scope = "Current production materials/joints and combined structural/environmental loads.";
                criteriaBasis = "Applicable supporting requirements and the evidence named by this open question; unaccepted criteria remain open.";
                comparisonBasis = "Evidence sufficiency and applicability review; no hardware ranking or invented utility score.";
                reopenTrigger = "Changed production process, material/joint aging, loads or functional installation.";
            }
            metadata installedControlEvidence : Context about BlueDog::Decisions::OpenQuestions::installedControlEvidence {
                kind = "Open acceptance question";
                scope = "Current onboard observations, command delivery and achieved motion for the actual installation.";
                criteriaBasis = "Applicable supporting requirements and the evidence named by this open question; unaccepted criteria remain open.";
                comparisonBasis = "Evidence sufficiency and applicability review; no hardware ranking or invented utility score.";
                reopenTrigger = "Changed sensing/frame/time/control path, software/calibration or fault behavior.";
            }
            metadata integrationCoverage : Context about BlueDog::Decisions::OpenQuestions::integrationCoverage {
                kind = "Open acceptance question";
                scope = "Current whole-route mission/safety/energy/structure/casualty acceptance argument.";
                criteriaBasis = "Applicable supporting requirements and the evidence named by this open question; unaccepted criteria remain open.";
                comparisonBasis = "Evidence sufficiency and applicability review; no hardware ranking or invented utility score.";
                reopenTrigger = "Changed configuration, mission case, interacting fault or excluded domain.";
            }
            metadata futureMissionAcceptance : Context about BlueDog::Decisions::OpenQuestions::futureMissionAcceptance {
                kind = "Open acceptance question";
                scope = "Separately scoped future ocean voyage; no implied current Gorge requirement.";
                criteriaBasis = "Applicable supporting requirements and the evidence named by this open question; unaccepted criteria remain open.";
                comparisonBasis = "Evidence sufficiency and applicability review; no hardware ranking or invented utility score.";
                reopenTrigger = "New route/exposure/maintenance requirements or an authorized future mission scope.";
            }
        }

        package Design {
            private import ScalarValues::*;
            item sizingBaseline : EngineeringDecisions::DecisionRecord {
                attribute :>> recordState = EngineeringDecisions::RecordState::workingDisposition;
                attribute :>> disposition = "Use the fixed-camber rotating-mast wing as the first numerical sizing baseline; no final sail downselect.";
                attribute :>> evidenceNeeded = "Comparable both-tack polars, wet-cycle durability, actuator energy, mass/CG and dynamic recovery evidence for the alternatives.";
                metadata rationale : ModelingMetadata::Rationale {
                    text = "The existing manufacturing CAD supplies a measured section and a practical starting geometry. This enables coupled sizing while preserving the tail-controlled wing and soft sail as equal development contenders for the finite Gorge mission. Availability of CAD is not proof of superior sailing performance.";
                }
                metadata issue : ModelingMetadata::Issue { text = "The source CAD is a manufacturing prototype, not the challenge vessel; the rectangular VSP wing uses its complete midspan section rather than reproducing its swept planform."; }
            }
            dependency baselineCandidate from sizingBaseline to BlueDog::Analyses::SailTrade::camberedWing;
            dependency retainedAlternative from sizingBaseline to BlueDog::Analyses::SailTrade::tailWing;
            dependency softSailAlternative from sizingBaseline to BlueDog::Analyses::SailTrade::softSail;
            dependency baselinePurpose from sizingBaseline to BlueDog::Requirements::cruiseEvidence;

            item holdingDrive : EngineeringDecisions::DecisionRecord {
                attribute :>> recordState = EngineeringDecisions::RecordState::workingDisposition;
                attribute :>> disposition = "Evaluate non-backdrivable gearing as an option, not a selected or qualified component.";
                attribute :>> evidenceNeeded = "Motor-off holding under shock, wear, temperature and lubrication changes; moving efficiency, controller demand, jam and power-loss recovery tests.";
                metadata rationale : ModelingMetadata::Rationale { text = "Zero motor holding current can reduce finite mission energy consumption, but gear friction and trim movement still consume energy. A locked gearbox retains the last mast angle and requires explicit storm and capsize assessment."; }
            }
            dependency holdingEnergy from holdingDrive to BlueDog::Requirements::multiDayEndurance {
                metadata rationale : ModelingMetadata::Rationale { text = "Additional future endurance relevance; this is not the finite Gorge energy basis or a component selection."; }
            }
            dependency holdingFiniteAdmission from holdingDrive to BlueDog::Requirements::launchEnergyAdmission;
            dependency holdingFiniteReserve from holdingDrive to BlueDog::Requirements::recoveryEnergy;
            dependency holdingRecovery from holdingDrive to BlueDog::Requirements::capsizeControlRecovery;
            dependency holdingCalculation from holdingDrive to Analysis::Energy::Actuation::DrivePower;

            item aerodynamicScope : EngineeringDecisions::DecisionRecord {
                attribute :>> recordState = EngineeringDecisions::RecordState::workingDisposition;
                attribute :>> disposition = "Use restricted attached-flow VSPAERO sensitivity evidence with conservative sizing assumptions and separate actuator-moment uncertainty; no measured polar is available for this CAD.";
                attribute :>> evidenceNeeded = "Low-Reynolds-number viscous drag, stall, broadside response, thickness sensitivity and both-tack moment measurements; converged heel/wind/trim response across the sizing grid.";
                metadata rationale : ModelingMetadata::Rationale { text = "Potential-flow interpolation is suitable for a provisional force-balance model. Mesh convergence and direct candidate checks establish numerical consistency only. Rounded section ends and assumed wake attachment require physical validation; square-sail/downwind performance is not established by VLM."; }
            }
            dependency heelSensitivityEvidence from aerodynamicScope to BlueDog::Analyses::WingHeel::sweepInputs;
            dependency sizingAerodynamicPolicy from aerodynamicScope to BlueDog::Analyses::AerodynamicPolicy::sizing;
            dependency polarPurpose from aerodynamicScope to BlueDog::Requirements::cruiseEvidence;
            dependency polarCalculation from aerodynamicScope to Analysis::Marine::Sailing::Evaluate;

            item structuralScope : EngineeringDecisions::DecisionRecord {
                attribute :>> recordState = EngineeringDecisions::RecordState::workingDisposition;
                attribute :>> disposition = "Credit finite glass/epoxy laminate sections for bending; give printed substrate no bending-strength credit.";
                attribute :>> evidenceNeeded = "Wet/jointed coupon strength and stiffness, glass-to-print bonds, ribs, attachments, fatigue, buckling and impact tests.";
                metadata rationale : ModelingMetadata::Rationale { text = "Thin-wall inertia exceeded the solid-section bound in an earlier sizing trial. Polygon offsets now define finite-thickness section properties. Printed walls/ribs, seams and finish still contribute mass; preliminary material targets are not measured properties."; }
            }
            dependency structureChoice from structuralScope to BlueDog::Requirements::Structure::hybridConstruction;
            dependency structureCriteria from structuralScope to BlueDog::Requirements::Structure::structuralIntegrity;
            dependency structureCalculation from structuralScope to Analysis::Mechanics::Structures::DesignMargins;

            item recoveryScope : EngineeringDecisions::DecisionRecord {
                attribute :>> recordState = EngineeringDecisions::RecordState::workingDisposition;
                attribute :>> disposition = "Treat static full-roll restoring curves as screening evidence, separate from dynamic self-righting.";
                attribute :>> evidenceNeeded = "Dynamic releases, pitch stability, ingress/drainage, control restoration and credible failure-state geometry.";
                metadata rationale : ModelingMetadata::Rationale { text = "Positive sampled roll moments on a pitch-unstable equilibrium branch do not establish a recovery trajectory. Freely flooded material and fully retained water are distinct static sensitivities, not leakage or slosh predictions."; }
            }
            dependency recoveryCriteria from recoveryScope to BlueDog::Requirements::selfRighting;
            dependency recoveryCalculation from recoveryScope to Analysis::Marine::Hydrostatics::Balance;

            item energyEvidenceAcceptance : EngineeringDecisions::DecisionRecord {
                attribute :>> recordState = EngineeringDecisions::RecordState::workingDisposition;
                attribute :>> disposition = "Set evidenceAccepted only after review of evidence for the same installed configuration.";
                attribute :>> evidenceNeeded = "Non-overlapping installed-load coverage; measured power and duty bounds that preserve required functions; installed harvester route/season bounds including outages; temperature/end-of-service battery limits; conservative initial energy; consistent stored-energy and bus boundaries; interval resolution, uncertainty, repeat-cycle phase, source identifiers, configuration revision and review disposition.";
                metadata rationale : ModelingMetadata::Rationale { text = "A review Boolean does not automatically audit the records. Recovery demand is a battery withdrawal rate and its reserve stays inside usable capacity. Saving power by violating navigation, collision assessment, signaling, logging or communications does not establish sustained operation. A finite synthetic campaign cannot establish indefinite service."; }
            }
            dependency energyAcceptance from energyEvidenceAcceptance to BlueDog::Requirements::energyEvidenceReadiness;
            dependency energyVerification from energyEvidenceAcceptance to BlueDog::Analyses::Energy::SustainedEnergyVerification;

            item uncertaintyPolicy : EngineeringDecisions::DecisionRecord {
                attribute :>> recordState = EngineeringDecisions::RecordState::workingDisposition;
                attribute :>> disposition = "Separate nominal feasibility, adverse engineering sensitivities and physical qualification.";
                attribute :>> evidenceNeeded = "Measured uncertainty bounds and environmental exposure; hardware packaging/CG; robust feasibility with sufficient mission margins.";
                metadata rationale : ModelingMetadata::Rationale { text = "The size search is local and its variable brackets are numerical or model-domain limits. Mesh reserves are numerical allowances, not engineering safety factors. Sensitivity cases are not probabilities. Failed local operating solves do not prove physical impossibility or global infeasibility."; }
            }
            dependency uncertaintyCases from uncertaintyPolicy to BlueDog::Analyses::Sizing::Uncertainty::Inputs;
            dependency missionEvidence from uncertaintyPolicy to BlueDog::Requirements::missionEvidence;
            item trafficCourtesy : EngineeringDecisions::DecisionRecord {
                attribute :>> recordState = EngineeringDecisions::RecordState::workingDisposition;
                attribute disposition :>> disposition = "Prefer safe, rule-consistent routes, operating windows and trajectories that reduce the likelihood of crewed vessels needing to maneuver. Accept delay or reduced mission progress to avoid developing encounters. Once encounter duties apply, preserve required predictable behavior and act when permitted or necessary; this is not an always-yield policy.";
                attribute evidenceNeeded :>> evidenceNeeded = "Compare alternatives against the same traffic scenarios using close-encounter exposure, predicted need for other-vessel action and mission delay, with explicit behavior and sensing assumptions. These are comparative design measures, not evidence of why another skipper acted or challenge pass/fail criteria. The preference is not yet implemented as a planner objective or validated by the existing replay.";
            }
            dependency courtesyWithinNavigationDuties from trafficCourtesy to BlueDog::Mission::Challenge::navigationRules;
            dependency courtesyCollisionSafety from trafficCourtesy to BlueDog::Mission::Challenge::trafficCoexistence;
        }

        package OpenQuestions {
            private import ScalarValues::*;
            item <'U01'> trafficAcceptance : EngineeringDecisions::DecisionRecord {
                attribute :>> recordState = EngineeringDecisions::RecordState::openQuestion;
                attribute :>> owner = "Project owner";
                attribute :>> accepted = false;
                attribute :>> question = "Accept class-specific observation, response, clearance and reliability/confidence criteria and the deployment applicability matrix.";
                attribute :>> evidenceNeeded = "Installed class-specific observations and achieved responses; configuration-specific rule review and recorded authority.";
            }
            dependency trafficAcceptanceBasis1 from trafficAcceptance to BlueDog::Requirements::trafficSafety;
            dependency trafficAcceptanceBasis2 from trafficAcceptance to BlueDog::Requirements::regulatoryClassification;
            dependency trafficAcceptanceBasis3 from trafficAcceptance to BlueDog::Mission::Challenge::navigationRuleApplicability;
            item <'U02'> recoveryAcceptance : EngineeringDecisions::DecisionRecord {
                attribute :>> recordState = EngineeringDecisions::RecordState::openQuestion;
                attribute :>> owner = "Project owner";
                attribute :>> accepted = false;
                attribute :>> question = "Establish independent course-wide recovery and physical retrieval.";
                attribute :>> evidenceNeeded = "Surveyed accessible shores, final capture/retention, casualty propulsion, onboard observations/control and protected power under no-contact faults.";
            }
            dependency recoveryAcceptanceBasis1 from recoveryAcceptance to BlueDog::Requirements::recoveryPropulsion;
            dependency recoveryAcceptanceBasis2 from recoveryAcceptance to BlueDog::Requirements::recoveryEnergy;
            dependency recoveryAcceptanceBasis3 from recoveryAcceptance to BlueDog::Mission::Challenge::capsizeRecovery;
            item <'U03'> structuralQualification : EngineeringDecisions::DecisionRecord {
                attribute :>> recordState = EngineeringDecisions::RecordState::openQuestion;
                attribute :>> owner = "Project owner";
                attribute :>> accepted = false;
                attribute :>> question = "Accept actual structural loads and installed functional limits.";
                attribute :>> evidenceNeeded = "Wet and aged production materials/joints, impact/fatigue/buckling and combined environmental load evidence.";
            }
            dependency structuralQualificationBasis1 from structuralQualification to BlueDog::Requirements::Structure::structuralIntegrity;
            item <'U04'> installedControlEvidence : EngineeringDecisions::DecisionRecord {
                attribute :>> recordState = EngineeringDecisions::RecordState::openQuestion;
                attribute :>> owner = "Project owner";
                attribute :>> accepted = false;
                attribute :>> question = "Connect supplied observations and commands to installed sensing and achieved motion.";
                attribute :>> evidenceNeeded = "Correlated apparent and 10 m true wind, navigation/traffic observations, maneuver response and interacting faults.";
            }
            dependency installedControlEvidenceBasis1 from installedControlEvidence to BlueDog::Requirements::windObservation;
            dependency installedControlEvidenceBasis2 from installedControlEvidence to BlueDog::Requirements::navigationAndControl;
            item <'U05'> integrationCoverage : EngineeringDecisions::DecisionRecord {
                attribute :>> recordState = EngineeringDecisions::RecordState::openQuestion;
                attribute :>> owner = "Project owner";
                attribute :>> accepted = false;
                attribute :>> question = "Establish an integrated acceptance argument beyond sampled predicates and supplied Booleans.";
                attribute :>> evidenceNeeded = "Compatible configuration-specific whole-route, safety, energy, structural and casualty evidence with justified coverage and exclusions.";
            }
            dependency integrationCoverageBasis1 from integrationCoverage to BlueDog::Requirements::missionReliability;
            dependency integrationCoverageBasis2 from integrationCoverage to BlueDog::Requirements::cruisePerformance;
            item <'U06'> futureMissionAcceptance : EngineeringDecisions::DecisionRecord {
                attribute :>> recordState = EngineeringDecisions::RecordState::openQuestion;
                attribute :>> owner = "Project owner";
                attribute :>> accepted = false;
                attribute :>> question = "Select independently scoped future voyage targets and acceptance.";
                attribute :>> evidenceNeeded = "Hawaii route, weather, ocean exposure, sustained energy, communications, maintenance and recovery decisions.";
            }
            dependency futureMissionAcceptanceBasis1 from futureMissionAcceptance to BlueDog::Mission::Scope::future;
        }

        package TradeCriteria {
            private import ScalarValues::*;
            enum def Kind { mandatory; comparativeStudy; }
            part def Criterion {
                attribute position : Integer [1];
                attribute label : String [1];
                attribute kind : Kind [1];
                attribute scope : String [1];
                attribute evidenceNeeded : String [1];
            }
            part durability : Criterion {
                attribute :>> position = 1; attribute :>> label = "Wet and survival durability";
                attribute :>> kind = Kind::mandatory;
                attribute :>> scope = "Complete proposed rig installation under applicable wet and Gorge survival conditions.";
                attribute :>> evidenceNeeded = "Comparable wet-cycle, wear, joint, storm and faulted-rig evidence for the intended exposure.";
            }
            part energy : Criterion {
                attribute :>> position = 2; attribute :>> label = "Finite mission energy and recovery reserve";
                attribute :>> kind = Kind::mandatory;
                attribute :>> scope = "Installed move/hold/idle and controller demand, main account and protected recovery account; future sustained energy separate.";
                attribute :>> evidenceNeeded = "Measured installed loads and duty bounds, stored-energy boundaries, route/exposure and casualty reserve.";
            }
            part progress : Criterion {
                attribute :>> position = 3; attribute :>> label = "Passage duration and representative cruise evidence";
                attribute :>> kind = Kind::mandatory;
                attribute :>> scope = "Current Gorge passage-duration obligation and both-tack representative evidence; legacy leg-progress ratio is a study comparison.";
                attribute :>> evidenceNeeded = "Comparable installed polars, loading, current/wind cases, passage limits and uncertainty.";
            }
            part recovery : Criterion {
                attribute :>> position = 4; attribute :>> label = "Capsize and control recovery";
                attribute :>> kind = Kind::mandatory;
                attribute :>> scope = "Candidate rig in actual casualty geometry, trim/jam/water states and restored control; static screens alone insufficient.";
                attribute :>> evidenceNeeded = "Dynamic righting, ingress/drainage, depower, observation/control restoration and fault evidence.";
            }
            part manufacturing : Criterion {
                attribute :>> position = 5; attribute :>> label = "Manufacturing compatibility";
                attribute :>> kind = Kind::mandatory;
                attribute :>> scope = "Applicable desktop-manufactured hull/structure obligation and compatible rig installation; sailcloth need not be printed.";
                attribute :>> evidenceNeeded = "Manufacturing/process and installation evidence; compare rig construction effort separately without inventing cost scores.";
            }
            part handling : Criterion {
                attribute :>> position = 6; attribute :>> label = "Lift and handling mass";
                attribute :>> kind = Kind::mandatory;
                attribute :>> scope = "Complete boat and applicable lift/handling configuration; compare total installed rig mass and CG consistently.";
                attribute :>> evidenceNeeded = "Identified configuration mass and handling/structural evidence, including wet and retained-water states as applicable.";
            }
            part reliabilityStudy : Criterion {
                attribute :>> position = 7; attribute :>> label = "Provisional voyage reliability study";
                attribute :>> kind = Kind::comparativeStudy;
                attribute :>> scope = "Unaccepted L-101 study objective; an unknown or missed study target is not a mandatory selection veto. Required functions still apply.";
                attribute :>> evidenceNeeded = "Representative failure/dependence/common-cause/exposure evidence and uncertainty before comparing reliability; supplied states do not accept rates.";
            }
            dependency durabilityWet from durability to BlueDog::Requirements::wetMechanicalIntegrity;
            dependency durabilityStorm from durability to BlueDog::Requirements::gorgeSurvivalWind;
            dependency energyAdmission from energy to BlueDog::Requirements::launchEnergyAdmission;
            dependency energyReserve from energy to BlueDog::Requirements::recoveryEnergy;
            dependency progressDuration from progress to BlueDog::Requirements::passageDuration;
            dependency progressEvidence from progress to BlueDog::Requirements::cruiseEvidence;
            dependency recoveryRighting from recovery to BlueDog::Requirements::selfRighting;
            dependency recoveryControl from recovery to BlueDog::Requirements::capsizeControlRecovery;
            dependency manufacturingScope from manufacturing to BlueDog::Requirements::desktopManufacture;
            dependency handlingMass from handling to BlueDog::Requirements::liftMass;
            dependency studyObjective from reliabilityStudy to BlueDog::Requirements::missionSuccessProbability;
            dependency studyEvidence from reliabilityStudy to BlueDog::Requirements::reliabilityEvidence;
            dependency requiredFunctionContinuity from reliabilityStudy to BlueDog::Requirements::missionReliability {
                metadata rationale : ModelingMetadata::Rationale { text = "Functional continuity remains mandatory; classifying the provisional probability target as comparative does not waive required functions."; }
            }
        }
    }

    package Verification {

        package Challenge {
            doc /* Planned qualification cases, not completed evidence. Virtual regression checks and physical demonstrations are separate evidence streams. */
            verification def OverallLengthVerification {
                metadata plannedInspect : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::inspect; }
                metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
                metadata plannedAnalyze : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::analyze; }
                doc /* Inspect and measure the maximum fore-and-aft extent through all normal rig, steering and equipment configurations. Apply the executable lengthLimit constraint with recorded measurement uncertainty; confirm no unmeasured projection extends beyond the reported envelope. */
                objective acceptance { verify BlueDog::Mission::Challenge::overallLength; }
                return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
            }
            verification def SafetyCapabilityAbortVerification {
                metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
                doc /* Inject loss of required safety functions, including visibility-driven loss and common-cause faults. Confirm qualification terminates when the function is unavailable; demonstrate continued qualification only when an accepted backup maintains that function. */
                objective acceptance { verify BlueDog::Mission::Challenge::safetyCapabilityAbort; }
                return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
            }
            verification def AutonomousShoreRecoveryVerification {
                metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
                metadata plannedAnalyze : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::analyze; }
                doc /* From declared course locations and casualty states, remove communications and trigger safety abort. Record recovery initiation, chosen accessible destination, transit and final approach. Assess impaired-sensing collision exposure and consequences independently; a successful transit alone does not accept that residual risk. */
                objective acceptance { verify BlueDog::Mission::Challenge::autonomousShoreRecovery; }
                return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
            }
            verification def AbortAlertVerification {
                metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
                doc /* Trigger abort with available and unavailable links. Observe immediate transmission attempts with a link, durable queueing without a link and delivery after reconnection. Timing implementation tolerance must be declared before qualification. */
                objective acceptance { verify BlueDog::Mission::Challenge::abortAlert; }
                return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
            }
            verification def NoLitteringVerification {
                metadata plannedInspect : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::inspect; }
                metadata plannedAnalyze : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::analyze; }
                doc /* Review and demonstrate the linked flotation, major-component retention and capsize recovery cases using the same casualty configuration. Account for every major component at retrieval. */
                objective acceptance { verify BlueDog::Mission::Challenge::noLittering; }
                return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
            }
            verification def CasualtyFlotationVerification {
                metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
                doc /* Execute the approved flooding and capsize exposure cases with maximum mission load. Observe flotation throughout the course-derived recovery duration. A short static float test cannot substantiate a longer recovery exposure. */
                objective acceptance { verify BlueDog::Mission::Challenge::casualtyFlotation; }
                return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
            }
            verification def MajorComponentRetentionVerification {
                metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
                metadata plannedInspect : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::inspect; }
                doc /* Inspect rig, ballast and battery retention before and after the same flooding and capsize cases used for flotation. Record attachments and any released debris. */
                objective acceptance { verify BlueDog::Mission::Challenge::majorComponentRetention; }
                return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
            }
            verification def CapsizeRecoveryVerification {
                metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
                doc /* Release the vessel in the declared capsize orientations with communications disabled and execute shore recovery under the approved current, wind and wave profile. Observe arrival at a retrievable location; remaining inverted is allowed. Motor use must disqualify the attempt. */
                objective acceptance { verify BlueDog::Mission::Challenge::capsizeRecovery; }
                return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
            }
            verification def UnattachedPassageVerification {
                metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
                metadata plannedAnalyze : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::analyze; }
                doc /* Review timestamped passage records and inject grounding, anchoring, shore attachment and refuge entry. Each ends qualification; safe afloat waiting does not. Missing evidence prevents an affirmative qualification verdict. */
                objective acceptance { verify BlueDog::Mission::Challenge::unattachedPassage; }
                return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
            }
            verification def OutageAutonomyVerification {
                metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
                doc /* Interrupt communications during healthy passage and verify continued autonomous operation, retained observations and backlog delivery. Separately inject a safety failure during the outage to ensure loss of contact does not inhibit recovery. */
                objective acceptance { verify BlueDog::Mission::Challenge::communicationOutageAutonomy; }
                return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
            }
            verification def ForecastAdmissionVerification {
                metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
                metadata plannedAnalyze : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::analyze; }
                doc /* Exercise forecast-conditioned launch scenarios covering full passage, waiting and recovery exposure. Reject missing or insufficient forecast coverage. Evaluate the frozen Monte Carlo ensemble and explicit edge cases without treating sample completion fraction as calibrated real-world probability. */
                objective acceptance { verify BlueDog::Mission::Challenge::forecastAdmission; }
                return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
            }
            verification def WeatherOutageContinuationVerification {
                metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
                doc /* Interrupt weather access with applicable and expired forecasts; independently vary onboard safety capability. Confirm continuation requires both applicable forecast information and preserved safety capability. */
                objective acceptance { verify BlueDog::Mission::Challenge::weatherOutageContinuation; }
                return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
            }
            verification def CourseRecoveryReserveVerification {
                metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
                metadata plannedAnalyze : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::analyze; }
                doc /* Evaluate route-dependent reserve along the course using installed load evidence, adverse currents, route feasibility and uncertainty. An inaccessible shore, infeasible route or missing input cannot establish a protected reserve. */
                objective acceptance { verify BlueDog::Mission::Challenge::courseRecoveryReserve; }
                return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
            }
            verification def ReserveAbortVerification {
                metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
                metadata plannedAnalyze : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::analyze; }
                doc /* Inject declining energy and increasing recovery demand along the route. Confirm recovery begins with sufficient reserve for the decision delay, transition and transit rather than only after reserve exhaustion. */
                objective acceptance { verify BlueDog::Mission::Challenge::reserveAbort; }
                return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
            }
            verification def NightOperationVerification {
                metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
                doc /* Exercise the declared navigation, traffic, communications and recovery scenarios in darkness. Confirm nightfall alone does not terminate qualification. Simulation cannot close optical sensing or navigation-light physical evidence. */
                objective acceptance { verify BlueDog::Mission::Challenge::nightOperation; }
                return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
            }
            verification def AbortPersistenceVerification {
                metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
                doc /* After abort, test reboot, contact restoration, refuge departure and operator relocation. Qualification remains ended until the new attempt departure-gate condition is met; partial progress is not carried forward. */
                objective acceptance { verify BlueDog::Mission::Challenge::abortPersistence; }
                return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
            }
            verification def RecoveryConspicuityVerification {
                metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
                metadata plannedInspect : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::inspect; }
                doc /* Inspect and test recovery indications against the deployment-specific navigation-signal matrix in the approved visibility conditions, including the casualty states for which recovery is claimed. */
                objective acceptance { verify BlueDog::Mission::Challenge::recoveryConspicuity; }
                return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
            }
            verification def WindSportEncounterVerification {
                metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
                metadata plannedAnalyze : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::analyze; }
                doc /* Exercise BlueDog::Analyses::LocationTraffic windsurfCrossing, wingfoilTurn, kiteSweep, fallenRider and groupEncounter across both tacks, overtaking, unknown tack, glare, waves and darkness. Independently record rider/equipment extent, timing, swept-volume clearance and navigation obligations. Include timely, delayed and absent rider avoidance, falls, track swaps and no feasible sailing response. Scripted planar targets or cooperative passes cannot close these cases.*/
                objective acceptance {
                    verify BlueDog::Mission::Challenge::trafficCoexistence;
                    verify BlueDog::Mission::Challenge::navigationRules;
                }
                return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
            }
            verification def LocationTrafficAdmissionVerification {
                metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
                metadata plannedAnalyze : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::analyze; }
                doc /* Exercise BlueDog::Analyses::LocationTraffic windowOverrun and WindowAssessment for surveyed sectors and background reaches on both legs, waiting and recovery. Reject missing traffic evidence, unsupported wind/daylight conditions, incomplete coverage and intervals outside reviewed windows. Compare cumulative exposure, energy, sensing and recovery before departure. Sparse heatmaps and zero observed users cannot establish absence. Reassess delays and unexpected traffic; no accepted window yet.*/
                objective acceptance {
                    verify BlueDog::Mission::Challenge::forecastAdmission;
                }
                return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
            }
            verification def NavigationRulesEntryAndAdjudicationVerification {
                metadata plannedInspect : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::inspect; }
                metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
                metadata plannedAnalyze : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::analyze; }
                doc /* Planned case; no completed compliance evidence. Review entry applicability, current rule/notice baseline, installed observation and maneuver evidence, controlled demonstrations and simulation limitations against predeclared criteria. Reject unsupported admitted conditions. Replay compliant autonomous avoidance, no-contact rule breach, collision, operator intervention, motor-assisted safety action and insufficient evidence; confirm their distinct qualification outcomes. Record configuration, conditions, reviewer, evidence and rationale. Do not stage hazardous encounters with uninvolved users.*/
                objective acceptance {
                    verify BlueDog::Mission::Challenge::navigationRules;
                    verify BlueDog::Mission::Challenge::navigationRuleApplicability;
                    verify BlueDog::Mission::Challenge::navigationRuleBaseline;
                    verify BlueDog::Mission::Challenge::navigationEntryEvidence;
                    verify BlueDog::Mission::Challenge::operatorSafetyIntervention;
                    verify BlueDog::Mission::Challenge::navigationAdjudication;
                }
                return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
            }
            verification def InlandApplicabilityVerification {
                metadata plannedInspect : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::inspect; }
                metadata plannedAnalyze : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::analyze; }
                doc /* Planned case; no completed compliance evidence. Sources: Rules 1-3, https://www.ecfr.gov/current/title-33/chapter-I/subchapter-E/part-83/subpart-A . Review jurisdiction, vessel classification, sailing/powered/casualty modes, responsibility, local provisions and authority for exceptions. Record applicability dispositions; no blanket small-vessel or autonomous exemption.*/
                objective acceptance {
                    verify BlueDog::Mission::Challenge::navigationRules;
                }
                return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
            }
            verification def InlandLookoutAndAvoidanceVerification {
                metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
                metadata plannedAnalyze : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::analyze; }
                doc /* Planned case; no completed compliance evidence. Sources: Rules 5-8, https://www.ecfr.gov/current/title-33/chapter-I/subchapter-E/part-83/subpart-B . Demonstrate installed lookout, safe speed, risk appraisal and effective avoidance under admitted conditions, including uncertain and missed tracks. Independently observe early/substantial action and effectiveness. No-contact outcome alone is insufficient.*/
                objective acceptance {
                    verify BlueDog::Mission::Challenge::navigationRules;
                }
                return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
            }
            verification def InlandEncounterConductVerification {
                metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
                metadata plannedAnalyze : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::analyze; }
                doc /* Planned case; no completed compliance evidence. Sources: Rules 11-18, https://www.ecfr.gov/current/title-33/chapter-I/subchapter-E/part-83/subpart-B . Review applicability and demonstrate sailing, overtaking, crossing/head-on where relevant, give-way and stand-on escalation, unknown tack and exceptional status. Retain overtaking duty until past and clear. Distinguish permission from mandatory action; a subset does not verify omitted rules.*/
                objective acceptance {
                    verify BlueDog::Mission::Challenge::navigationRules;
                }
                return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
            }
            verification def InlandChannelAndVisibilityVerification {
                metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
                metadata plannedAnalyze : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::analyze; }
                doc /* Planned case; no completed compliance evidence. Sources: Rules 9, 10 and 19, https://www.ecfr.gov/current/title-33/chapter-I/subchapter-E/part-83/subpart-B . Review channel confinement, nonimpediment, crossings, applicable traffic separation and restricted visibility. Exercise simultaneous pairwise/channel duties. Record applicability or justified exclusions, operating limits and response to deteriorating visibility. In-sight logic does not verify nonvisual encounters.*/
                objective acceptance {
                    verify BlueDog::Mission::Challenge::navigationRules;
                }
                return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
            }
            verification def InlandSignalsVerification {
                metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
                metadata plannedInspect : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::inspect; }
                doc /* Planned case; no completed compliance evidence. Sources: Rules 20-37 and applicable annexes, https://www.ecfr.gov/current/title-33/chapter-I/subchapter-E . Review lights, shapes and sound signals for sailing, powered recovery and casualty modes. Demonstrate required equipment performance and signal behavior under admitted conditions. Record authority for alternatives; review distress signaling and applicable exemptions separately.*/
                objective acceptance {
                    verify BlueDog::Mission::Challenge::navigationRules;
                }
                return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
            }
            verification def PassageQualificationVerification {
                metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
                metadata plannedAnalyze : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::analyze; }
                doc /* Review the approved course, configuration and predeclared admission evidence, then independently reconstruct the ordered finite gate crossings and complete attempt history. Exercise skipped/reversed/touched gates, operator updates, motor thrust, grounding and restart. A complete circuit is insufficient when another governing challenge obligation failed or evidence is missing. Safe unassisted righting preserves qualification only with required safety capability; recovery after disqualification cannot transfer partial progress into a new attempt. Accept C-000 only after every applicable C-001, C-003 through C-010 and C-012 through C-027 obligation has its own accepted evidence or justified coverage in the same attempt. */
                objective acceptance {
                    verify BlueDog::Mission::Challenge::transGorgeChallenge;
                    verify BlueDog::Mission::Challenge::courseCompletion;
                    verify BlueDog::Mission::Challenge::unassistedAttempt;
                    verify BlueDog::Mission::Challenge::sailingPropulsion;
                }
                return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
            }
            verification def ObservationAndInterventionVerification {
                metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
                doc /* Measure acquisition-to-shore delivery under an available link, including current position, operating mode and health. Interrupt and restore the link; inspect durable backlog replay and continued autonomous control. Exercise authenticated emergency abort and manual-control commands with independent observation of the commanded response and persistent disqualification. Passive monitoring must not change mission state. Distinguish an unavailable link from a failed delivery on an available link. The demonstration must cover the installed vessel and shore endpoints; software queue tests alone do not establish communication service. */
                objective acceptance {
                    verify BlueDog::Mission::Challenge::liveObservation;
                    verify BlueDog::Mission::Challenge::emergencyIntervention;
                }
                return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
            }
            verification def RestrictedWatersVerification {
                metadata plannedInspect : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::inspect; }
                metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
                metadata plannedAnalyze : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::analyze; }
                doc /* Review the applicable chart, dam and lock exclusions, local restrictions and current notice baseline for the configured course. Independently compare the complete observed vessel envelope and position uncertainty against approved exclusion geometry throughout the attempt. Exercise approach, navigation-loss and no-feasible-maneuver cases in a controlled test or simulation; do not enter prohibited waters to test the response. A route-planner clearance result is supporting analysis, not evidence that actual operation remained outside restrictions. */
                objective acceptance { verify BlueDog::Mission::Challenge::restrictedWaters; }
                return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
            }
        }

        package Planning {
            private import ScalarValues::*;
            doc /* Verification-method tags describe plans, not execution or acceptance.
             * Source basis: NASA SE Handbook 5.3.1.2 and 5.4.1.2; NASA-HDBK-1009A
             * 8.14-8.20 engineering information design; defense SE Guidebook 2026
             * 6.2.5-6.2.7. SysML 2.0 VerificationCases supplies method/verdict kinds.
             * Plans remain inconclusive. Historical records retain their own subjects. */

            calc def EvidenceEligibleForAcceptance {
                doc /* Decision-support preconditions only, never an acceptance decision.
                 * Inputs are established by traceable evidence review, not inferred from
                 * an artifact filename or a successful equation. False eligibility does
                 * not discard a valid failed test or prevent review of incomplete data.
                 * Criteria and uncertainty rules belong to the actual assessed claim. */
                in executed : Boolean [1];
                in subjectIdentified : Boolean [1];
                in configurationApplicable : Boolean [1];
                in conditionsApplicable : Boolean [1];
                in procedureControlled : Boolean [1];
                in provenanceIntact : Boolean [1];
                in measurementBasisAdequate : Boolean [1];
                in uncertaintyAdequate : Boolean [1];
                in criterionEvaluated : Boolean [1];
                in criterionHolds : Boolean [1];
                in anomaliesAccounted : Boolean [1];
                return eligible : Boolean [1] = executed and subjectIdentified and configurationApplicable
                    and conditionsApplicable and procedureControlled and provenanceIntact
                    and measurementBasisAdequate and uncertaintyAdequate and criterionEvaluated
                    and criterionHolds and anomaliesAccounted;
            }
            part def PlannedTestConfiguration {
                ref part plannedDesign : MarineDesign::Design [1];
                ref part plannedAssembly : BlueDog::Architecture::Physical::IC01Candidate [1];
                attribute purpose : String [1];
                attribute articleIdentity : String [0..1];
                attribute procedureIdentity : String [0..1];
                attribute instrumentConfiguration : String [0..1];
                attribute plannedOnly : Boolean = true;
                doc /* Planned candidate references are not the identity of a built article.
                 * Absent article, released procedure and instruments remain unresolved;
                 * no execution or evidence-acceptance status is invented. */
            }
            part interfaceBench : PlannedTestConfiguration {
                ref part :>> plannedDesign = BlueDog::Configurations::IC01::design;
                ref part :>> plannedAssembly = BlueDog::Architecture::Physical::ic01;
                attribute :>> purpose = "Current Gorge command/permission, storage durability and restart integration";
            }
            part recoveryUseTrial : PlannedTestConfiguration {
                ref part :>> plannedDesign = BlueDog::Configurations::IC01::design;
                ref part :>> plannedAssembly = BlueDog::Architecture::Physical::ic01;
                attribute :>> purpose = "Current Gorge recovery approach, shore retention and one-person pickup in admitted conditions";
            }
            verification def InterfaceAndDurabilityIntegrationVerification {
                metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
                metadata plannedInspect : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::inspect; }
                subject vessel : BlueDog::Architecture::Physical::IC01Candidate = BlueDog::Architecture::Physical::ic01;
                doc /* Freeze actual article/software/storage/clock configuration and procedure.
                 * Independently observe command receipt, authority/expiry assessment,
                 * durable disqualification acknowledgment and physical motor enable.
                 * Inject stale/future/reordered/replayed commands, expired permissions,
                 * missing acknowledgments, primary loss and reset between each boundary.
                 * Confirm no thrust while qualification is qualifying or unknown and no
                 * commanded enable before durable disqualification. Establish legitimate
                 * onboard recovery authorization separately from authenticated operator
                 * authorization. Measure the governed restart/response deadlines using
                 * appropriate instrumentation; synthetic gate checks do not close them.
                 * Retain failures, input loss and power-cut corruption, not only clean runs. */
                objective acceptance {
                    verify BlueDog::Requirements::motorQualificationInvariant;
                    verify BlueDog::Requirements::freshRecoveryCommand;
                    verify BlueDog::Requirements::qualificationPersistence;
                    verify BlueDog::Requirements::qualificationRestoration;
                }
                return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
            }
            verification def HumanRecoveryUseValidation {
                metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
                metadata plannedDemo : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::demo; }
                subject vessel : BlueDog::Architecture::Physical::IC01Candidate = BlueDog::Architecture::Physical::ic01;
                doc /* Combined product verification and stakeholder-use validation.
                 * Use the identified actual operator, candidate installation, handling
                 * aids and surveyed recovery destination. Declare conditions, access,
                 * retrieval exposure, acceptance criteria and recovery arrangements before
                 * the trial. Observe autonomous approach separately from shore capture,
                 * retention and one-person pickup. Measure applicable handling outcomes;
                 * assess whether the intended user can complete the whole recovery task.
                 * Record failures, assistance, unsafe access and incomplete retrieval.
                 * A simulated approach, propulsion command or cooperative fixture alone
                 * cannot establish intended-use recovery or physical qualification. */
                objective acceptance { verify BlueDog::Requirements::soloRetrieval; }
                return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
            }
            dependency interfaceConfiguration from interfaceBench to InterfaceAndDurabilityIntegrationVerification;
            dependency recoveryConfiguration from recoveryUseTrial to HumanRecoveryUseValidation;
            dependency intendedRecoveryUse from HumanRecoveryUseValidation to BlueDog::Mission::UseCases::recover;
            dependency interfaceScenario from InterfaceAndDurabilityIntegrationVerification to BlueDog::Method::Scenarios::AbortAndRecover;
            dependency restartContract from InterfaceAndDurabilityIntegrationVerification to BlueDog::Behavior::Contracts::RestoreQualification;
            metadata issue : ModelingMetadata::Issue {
                text = "V-01: Release configuration-specific procedures, article identity, instrumentation/calibration and acceptance criteria before physical assessment. V-02: Establish applicability and uncertainty for every transferred component, historical or simulation artifact. V-03: Retain independent review and acceptance dispositions; method tags and eligibility checks do not execute or accept evidence. V-04: Perform stakeholder-use validation of shore capture, retention and one-person pickup, not only autonomous approach.";
            }
        }

        package Requirements {
            doc /* Verification specifications, not completed evidence. Each case remains
             * inconclusive until an evidence-backed implementation supplies a verdict.
             * Named requirement conditions are normative qualification definitions;
             * rationale and notes are explanatory. */
            verification def <'V-M-001'> RoundTripVerification {
                metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
                metadata plannedAnalyze : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::analyze; }
                doc /* Apply the complete M-001 qualification conditions and BlueDog::Verification::Challenge::PassageQualificationVerification acceptance strategy. Correlate the observed trajectory with safety-capability, energy-reserve, external-command, propulsion and qualification histories. Test safe unassisted righting separately from capsize with safety loss, motor use or external assistance. Missing gate crossings, missing evidence or disqualifying events prevent a completion verdict. */
                objective acceptance {
                    verify BlueDog::Requirements::roundTrip;
                }
                return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
            }
            verification def <'V-M-002'> MultiDayEnduranceVerification {
                metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
                metadata plannedAnalyze : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::analyze; }
                doc /* Apply the M-002 qualification conditions. Record initial battery state, harvester configuration, resource profile, harvested energy and loads. Limit input to installed-harvester output measured under a frozen, recorded resource profile; any test supply replay must not exceed measured power or accumulated energy. Absent profile evidence invalidates the test. */
                objective acceptance {
                    verify BlueDog::Requirements::multiDayEndurance;
                }
                return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
            }
            verification def <'V-E-001'> EnergyAwarenessVerification {
                metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
                metadata plannedAnalyze : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::analyze; }
                doc /* Apply the E-001 qualification conditions. Assess every applicable acceptance outcome separately: E-101, E-102, E-103, E-104. */
                objective acceptance {
                    verify BlueDog::Requirements::energyAwareness;
                    verify BlueDog::Requirements::energyEstimateCadence;
                    verify BlueDog::Requirements::reserveEstimateCadence;
                    verify BlueDog::Requirements::energyEstimateAccuracy;
                    verify BlueDog::Requirements::conservativeEnergyEstimate;
                }
                return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
            }
            verification def <'V-E-002'> NavigationAndControlVerification {
                metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
                metadata plannedAnalyze : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::analyze; }
                doc /* Apply the E-002 qualification conditions. Assess every applicable acceptance outcome separately: E-105, E-106, E-107, E-108, E-109. */
                objective acceptance {
                    verify BlueDog::Requirements::navigationAndControl;
                    verify BlueDog::Requirements::guidanceUpdateCadence;
                    verify BlueDog::Requirements::sailCommandCadence;
                    verify BlueDog::Requirements::steeringCommandCadence;
                    verify BlueDog::Requirements::positionAccuracy;
                    verify BlueDog::Requirements::headingAccuracy;
                }
                return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
            }
            verification def <'V-E-003'> ResetRecoveryVerification {
                metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
                doc /* Apply the E-003 qualification conditions. Assess every applicable acceptance outcome separately: E-110, E-111, E-112, E-113, E-145, E-136, E-139, E-138, R-102, R-101. */
                objective acceptance {
                    verify BlueDog::Requirements::resetRecovery;
                    verify BlueDog::Requirements::restartDeadline;
                    verify BlueDog::Requirements::missionStateRestoration;
                    verify BlueDog::Requirements::gateProgressRestoration;
                    verify BlueDog::Requirements::resetRestrictionPreservation;
                    verify BlueDog::Requirements::qualificationRestoration;
                    verify BlueDog::Requirements::logInterruptionDurability;
                    verify BlueDog::Requirements::unknownQualificationFallback;
                    verify BlueDog::Requirements::qualificationPersistence;
                    verify BlueDog::Requirements::freshRecoveryCommand;
                    verify BlueDog::Requirements::motorQualificationInvariant;
                }
                return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
            }
            verification def <'V-E-004'> LowEnergyRecoveryVerification {
                metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
                metadata plannedAnalyze : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::analyze; }
                doc /* Apply the E-004 qualification conditions. Assess every applicable acceptance outcome separately: E-114, E-115, E-116, E-117, E-118, E-119, E-130, E-120, E-132, R-101. */
                objective acceptance {
                    verify BlueDog::Requirements::lowEnergyRecovery;
                    verify BlueDog::Requirements::lowEnergyEntry;
                    verify BlueDog::Requirements::lowEnergyPayloadInhibition;
                    verify BlueDog::Requirements::lowEnergyNavigationContinuity;
                    verify BlueDog::Requirements::lowEnergyCollisionContinuity;
                    verify BlueDog::Requirements::lowEnergyExit;
                    verify BlueDog::Requirements::payloadRestartPermission;
                    verify BlueDog::Requirements::periodicLogCadence;
                    verify BlueDog::Requirements::telemetryDeliveryCadence;
                    verify BlueDog::Requirements::criticalEventRecording;
                    verify BlueDog::Requirements::motorQualificationInvariant;
                }
                return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
            }
            verification def <'V-E-005'> CommunicationsVerification {
                metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
                doc /* Apply the E-005 qualification conditions. Assess every applicable acceptance outcome separately: E-120, E-121, E-122, E-123, E-124, E-131, E-137. */
                objective acceptance {
                    verify BlueDog::Requirements::communications;
                    verify BlueDog::Requirements::telemetryDeliveryCadence;
                    verify BlueDog::Requirements::outageAutonomy;
                    verify BlueDog::Requirements::reconnectCurrentRecord;
                    verify BlueDog::Requirements::backlogOrdering;
                    verify BlueDog::Requirements::backlogCurrentPriority;
                    verify BlueDog::Requirements::logRetention;
                    verify BlueDog::Requirements::reconnectLogPreservation;
                }
                return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
            }
            verification def <'V-E-006'> IngressResponseVerification {
                metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
                doc /* Apply the E-006 qualification conditions. Assess every applicable acceptance outcome separately: E-125, E-126, E-127, E-128, E-129, E-144, E-132, R-101. */
                objective acceptance {
                    verify BlueDog::Requirements::ingressResponse;
                    verify BlueDog::Requirements::ingressDetection;
                    verify BlueDog::Requirements::ingressRecoveryRequest;
                    verify BlueDog::Requirements::ingressFlotation;
                    verify BlueDog::Requirements::ingressElectronicsProtection;
                    verify BlueDog::Requirements::ingressPositionContinuity;
                    verify BlueDog::Requirements::ingressEventDeadline;
                    verify BlueDog::Requirements::criticalEventRecording;
                    verify BlueDog::Requirements::motorQualificationInvariant;
                }
                return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
            }
            verification def <'V-E-007'> MissionEvidenceVerification {
                metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
                metadata plannedInspect : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::inspect; }
                doc /* Apply the E-007 qualification conditions. Assess every applicable acceptance outcome separately: E-130, E-131, E-132, E-133, E-134, E-135, E-136, E-137, E-138, E-139. */
                objective acceptance {
                    verify BlueDog::Requirements::missionEvidence;
                    verify BlueDog::Requirements::periodicLogCadence;
                    verify BlueDog::Requirements::logRetention;
                    verify BlueDog::Requirements::criticalEventRecording;
                    verify BlueDog::Requirements::logTimestampAccuracy;
                    verify BlueDog::Requirements::invalidTimestampMarking;
                    verify BlueDog::Requirements::logGapIndication;
                    verify BlueDog::Requirements::logInterruptionDurability;
                    verify BlueDog::Requirements::reconnectLogPreservation;
                    verify BlueDog::Requirements::qualificationPersistence;
                    verify BlueDog::Requirements::unknownQualificationFallback;
                }
                return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
            }
            verification def <'V-P-001'> TransportabilityVerification {
                metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
                metadata plannedInspect : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::inspect; }
                doc /* Apply the P-001 qualification conditions. Assess every applicable acceptance outcome separately: P-101, P-102, P-103, P-104, P-105, P-106. */
                objective acceptance {
                    verify BlueDog::Requirements::transportability;
                    verify BlueDog::Requirements::soloTransport;
                    verify BlueDog::Requirements::liftMass;
                    verify BlueDog::Requirements::setupDuration;
                    verify BlueDog::Requirements::packDuration;
                    verify BlueDog::Requirements::soloLaunch;
                    verify BlueDog::Requirements::soloRetrieval;
                }
                return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
            }
            verification def <'V-P-002'> DesktopManufactureVerification {
                metadata plannedInspect : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::inspect; }
                metadata plannedAnalyze : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::analyze; }
                doc /* Apply the P-002 qualification conditions. Compare slicer/job-envelope measurements for every job with the 250 × 250 × 250 mm usable Cartesian travel; raw part volume is insufficient. */
                objective acceptance {
                    verify BlueDog::Requirements::desktopManufacture;
                }
                return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
            }
            verification def <'V-P-003'> ServiceabilityVerification {
                metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
                metadata plannedInspect : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::inspect; }
                doc /* Apply the P-003 qualification conditions. Assess every applicable acceptance outcome separately: P-107, P-108, P-109, P-110. */
                objective acceptance {
                    verify BlueDog::Requirements::serviceability;
                    verify BlueDog::Requirements::replacementDuration;
                    verify BlueDog::Requirements::nondestructiveService;
                    verify BlueDog::Requirements::postServiceSealing;
                    verify BlueDog::Requirements::postServiceActuation;
                }
                return verdict : VerificationCases::VerdictKind = VerificationCases::VerdictKind::inconclusive;
            }
            verification def <'V-S-001'> TrafficSafetyVerification {
                metadata plannedTest : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::test; }
                metadata plannedAnalyze : VerificationCases::VerificationMethod { kind = VerificationCases::VerificationMethodKind::analyze; }
                doc /* Verify S-001 and its decomposed timing and tracking requirements using reviewed class-specific and conservative unclassified envelopes from BlueDog::Analyses::ClassDetection. Record class/condition-specific timely track and whole-response probability lower bounds, confidence, applicable method and consequence/exposure reviews, classification transitions, clearance and risk disposition. Independently observe collision and nonimpediment obligations; source-model gates and synthetic truth do not demonstrate physical compliance. Current allocations and installed evidence remain open.*/
                objective acceptance {
                    verify BlueDog::Requirements::trafficSafety;
