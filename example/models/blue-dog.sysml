        package Structure {
            private import ScalarValues::*;
            private import RequirementDerivation::*;
            private import ModelingMetadata::refinement;
            private import SI::*;
            doc /* Owner-selected FDM plus wet-layup construction. Acceptance uses qualified material evidence and validated load/functional envelopes.
             * Provisional numerical screening values live in BlueDog::Analyses::StructuralBasis. */
            requirement def <'T-001'> HybridConstruction {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                doc /* The primary shell structure shall use an FDM substrate with wet-layup glass/epoxy reinforcement. */
                comment conditions /* Owner-selected construction architecture. PETG is the initial candidate, not a qualified material. */
                metadata rationale : ModelingMetadata::Rationale { text = "Owner-selected construction architecture. PETG is the initial candidate, not a qualified material."; }
            }
            requirement hybridConstruction : HybridConstruction;
            dependency basisHybridConstruction from hybridConstruction to BlueDog::DesignIntent { metadata rationale : ModelingMetadata::Rationale { text = "The owner constrains the shell construction process independently of mission performance."; } }
            requirement def <'T-100'> StructuralIntegrity {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                doc /* The primary structure shall carry its declared limit loads throughout the specified wet exposure. */
                comment conditions /* Apply T-101 through T-109 independently. Current screening allocations do not cover impact, fatigue, buckling or qualified adhesive strength. */
            }
            requirement structuralIntegrity : StructuralIntegrity;
            dependency structuralBasis from structuralIntegrity to BlueDog::Requirements::wetMechanicalIntegrity { metadata rationale : ModelingMetadata::Rationale { text = "Changes to wet exposure and joint integrity require review of structural loads, material bounds and test evidence."; } }
            requirement def <'T-101'> BendingStrength {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                doc /* Each primary structural member shall retain nonnegative bending-strength margin under the applicable limit-load cases. */
                comment conditions /* Assess each member and load direction using qualified wet/jointed allowables. Grounding, ballast inertia and operational loads are distinct cases. The sizing model currently credits glass only; that is an analysis choice. */
                attribute stressPa : Real;
                attribute qualifiedAllowablePa : Real;
                attribute evidenceAccepted : Boolean;
                require constraint acceptance { evidenceAccepted and qualifiedAllowablePa > 0 and RealFunctions::abs(stressPa) <= qualifiedAllowablePa }
            }
            requirement bendingStrength : BendingStrength;
            #derivation connection deriveBendingStrength { end #original source ::> structuralIntegrity; end #derive target ::> bendingStrength; }
            requirement def <'T-102'> AppendageDeflection {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                doc /* Each wing, keel and rudder shall remain within its validated functional deformation limit under the applicable load cases. */
                comment conditions /* Validate the limit against affected functions: foil/control performance, alignment, clearances and sealing as applicable. The preliminary sizing fraction is a screening assumption, not an accepted limit. Assess each member and direction separately. */
                attribute fraction : Real;
                attribute validatedMaximumFraction : Real;
                attribute limitEvidenceAccepted : Boolean;
                require constraint acceptance { limitEvidenceAccepted and validatedMaximumFraction > 0 and fraction >= 0 and fraction <= validatedMaximumFraction }
            }
            requirement appendageDeflection : AppendageDeflection;
            #derivation connection deriveAppendageDeflection { end #original source ::> structuralIntegrity; end #derive target ::> appendageDeflection; }
            requirement def <'T-103'> HullDeflection {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                doc /* The hull shall remain within its validated functional deformation limit under the applicable load cases. */
                comment conditions /* Validate the limit against affected functions: foil/control performance, alignment, clearances and sealing as applicable. The preliminary sizing fraction is a screening assumption, not an accepted limit. Assess each member and direction separately. */
                attribute fraction : Real;
                attribute validatedMaximumFraction : Real;
                attribute limitEvidenceAccepted : Boolean;
                require constraint acceptance { limitEvidenceAccepted and validatedMaximumFraction > 0 and fraction >= 0 and fraction <= validatedMaximumFraction }
            }
            requirement hullDeflection : HullDeflection;
            #derivation connection deriveHullDeflection { end #original source ::> structuralIntegrity; end #derive target ::> hullDeflection; }
            requirement def <'T-104'> PanelStrength {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                doc /* Each hull skin panel shall retain nonnegative bending-strength margin under the applicable differential-pressure cases. */
                comment conditions /* Determine load cases from immersion, wave/slam exposure and compartment pressures for the selected mission and geometry. The 10 kPa sizing screen is provisional, not a complete pressure envelope. */
                attribute stressPa : Real;
                attribute qualifiedAllowablePa : Real;
                attribute evidenceAccepted : Boolean;
                require constraint acceptance { evidenceAccepted and qualifiedAllowablePa > 0 and RealFunctions::abs(stressPa) <= qualifiedAllowablePa }
            }
            requirement panelStrength : PanelStrength;
            #derivation connection derivePanelStrength { end #original source ::> structuralIntegrity; end #derive target ::> panelStrength; }
            requirement def <'T-105'> PanelDeflection {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                doc /* Each hull skin panel shall remain within its validated functional deformation limit under the applicable load cases. */
                comment conditions /* Validate the limit against affected functions: foil/control performance, alignment, clearances and sealing as applicable. The preliminary sizing fraction is a screening assumption, not an accepted limit. Assess each member and direction separately. */
                attribute fraction : Real;
                attribute validatedMaximumFraction : Real;
                attribute limitEvidenceAccepted : Boolean;
                require constraint acceptance { limitEvidenceAccepted and validatedMaximumFraction > 0 and fraction >= 0 and fraction <= validatedMaximumFraction }
            }
            requirement panelDeflection : PanelDeflection;
            #derivation connection derivePanelDeflection { end #original source ::> structuralIntegrity; end #derive target ::> panelDeflection; }
            requirement def <'T-106'> RootProofLoad {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                doc /* Each appendage root attachment shall retain its load path under its applicable limit-load proof cases. */
                comment conditions /* Cover operational, handling, grounding and ballast-inertia loads applicable to the selected design. The initial 100 N tip-load and two-times-weight probes are screening cases, not universal requirements. Beam stress alone does not qualify joints or attachments. */
            }
            requirement rootProofLoad : RootProofLoad;
            #derivation connection deriveRootProofLoad { end #original source ::> structuralIntegrity; end #derive target ::> rootProofLoad; }
            requirement def <'T-107'> WetCouponStrength {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                doc /* Strength allowables credited in structural qualification shall not exceed the qualified wet-conditioned production-laminate bounds. */
                comment conditions /* Establish directional bounds for the selected layup, print, joints and cure process, including exposure and statistical/design reductions. Lower measured strength requires re-analysis or resizing, not rejection against the provisional 50 MPa input. */
                attribute creditedAllowablePa : Real;
                attribute qualifiedAllowablePa : Real;
                attribute evidenceAccepted : Boolean;
                require constraint acceptance { evidenceAccepted and qualifiedAllowablePa > 0 and creditedAllowablePa > 0 and creditedAllowablePa <= qualifiedAllowablePa }
            }
            requirement wetCouponStrength : WetCouponStrength;
            #derivation connection deriveWetCouponStrength { end #original source ::> structuralIntegrity; end #derive target ::> wetCouponStrength; }
            requirement def <'T-108'> WetCouponStiffness {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                doc /* Stiffness credited in structural qualification shall not exceed the qualified wet-conditioned production-laminate bounds. */
                comment conditions /* Establish directional effective stiffness for the modeled layup, joints and exposure. A lower measured modulus can be accommodated by geometry or reinforcement changes; 10 GPa is an unverified analysis input, not a material acceptance floor. */
                attribute creditedModulusPa : Real;
                attribute qualifiedModulusPa : Real;
                attribute evidenceAccepted : Boolean;
                require constraint acceptance { evidenceAccepted and qualifiedModulusPa > 0 and creditedModulusPa > 0 and creditedModulusPa <= qualifiedModulusPa }
            }
            requirement wetCouponStiffness : WetCouponStiffness;
            #derivation connection deriveWetCouponStiffness { end #original source ::> structuralIntegrity; end #derive target ::> wetCouponStiffness; }
            requirement def <'T-109'> BondProof {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                doc /* Each representative glass-to-print joint shall retain its load path under its calculated limit-load proof test after N-044 exposure. */
                comment conditions /* No qualified adhesion value is available; bond acceptance remains evidence-gated even when beam margins pass. */
                metadata rationale : ModelingMetadata::Rationale { text = "No qualified adhesion value is available; bond acceptance remains evidence-gated even when beam margins pass."; }
            }
            requirement bondProof : BondProof;
            #derivation connection deriveBondProof { end #original source ::> structuralIntegrity; end #derive target ::> bondProof; }
            requirement def <'T-110'> LoadedFreeboard {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                doc /* Downflooding openings shall retain positive clearance above the local water surface throughout the applicable intact operating cases. */
                comment conditions /* Evaluate actual openings, loading, heel, pitch and wave motion. A sealed deck edge may immerse without downflooding; the 50 mm deck-edge screen is not proof of this requirement. */
                attribute minimumOpeningClearanceM : Real;
                attribute caseCoverageAccepted : Boolean;
                require constraint acceptance { caseCoverageAccepted and minimumOpeningClearanceM > 0 }
            }
            requirement loadedFreeboard : LoadedFreeboard;
            dependency basisLoadedFreeboard from loadedFreeboard to BlueDog::Requirements::capsizeResilience { metadata rationale : ModelingMetadata::Rationale { text = "The selected intact operating cases determine downflooding clearances; a sealed deck edge is not an opening."; } }
            requirement def <'T-111'> ReserveBuoyancy {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                doc /* The vessel shall retain sufficient buoyancy to support its loaded weight throughout the applicable casualty-flotation cases. */
                comment conditions /* Use the declared flooding, capsize, ingress and recovery exposure cases; account for retained water and lost buoyant volume. Do not credit unsealed infill. The intact 100-percent reserve screen is not a casualty-flotation demonstration. */
                attribute availableBuoyancyN : Real;
                attribute loadedWeightN : Real;
                attribute caseCoverageAccepted : Boolean;
                require constraint acceptance { caseCoverageAccepted and loadedWeightN > 0 and availableBuoyancyN >= loadedWeightN }
            }
            requirement reserveBuoyancy : ReserveBuoyancy;
            dependency flotationPurpose from reserveBuoyancy to BlueDog::Mission::Challenge::casualtyFlotation { metadata rationale : ModelingMetadata::Rationale { text = "Buoyancy assessment supports casualty flotation but does not establish damage stability, retained components or safe retrieval. Changes to casualty cases require a new assessment."; } }
            dependency basisReserveBuoyancy from reserveBuoyancy to BlueDog::Requirements::capsizeResilience { metadata rationale : ModelingMetadata::Rationale { text = "Capsize and flooding cases drive the required buoyancy assessment; intact reserve-volume screens do not establish casualty flotation."; } }
            requirement def <'T-112'> LaunchClearance {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                doc /* The loaded vessel shall retain the site-qualified bottom clearance throughout the selected launch and retrieval paths. */
                comment conditions /* Use surveyed depth, stage/current uncertainty, vessel motion and actual appendage configuration. The 1.5 m depth and 0.3 m clearance used in preliminary sizing do not qualify a site or impose a universal draft limit. */
                attribute availableDepthM : Real;
                attribute immersedDepthM : Real;
                attribute requiredClearanceM : Real;
                attribute siteEvidenceAccepted : Boolean;
                require constraint acceptance { siteEvidenceAccepted and immersedDepthM > 0 and requiredClearanceM > 0 and availableDepthM - immersedDepthM >= requiredClearanceM }
            }
            requirement launchClearance : LaunchClearance;
            dependency basisLaunchClearance from launchClearance to BlueDog::Requirements::soloLaunch { metadata rationale : ModelingMetadata::Rationale { text = "The launch concept determines site and appendage clearances; actual surveyed paths must support the one-person launch claim."; } }
            requirement def <'T-113'> PrintTileEnvelope {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                doc /* Each structural tile shall fit the 250 mm cubic print-job envelope in its selected build configuration. */
                comment conditions /* Include supports, brim, raft and printer clearance in the job extents. The 230 mm tile is a seam/mass-study assumption; larger tiles are permitted when the complete job satisfies P-002. */
                attribute jobXM : Real;
                attribute jobYM : Real;
                attribute jobZM : Real;
                attribute slicerEvidenceAccepted : Boolean;
                require constraint acceptance { slicerEvidenceAccepted and BlueDog::Requirements::PrintJobEnvelopeCriterion(jobXM * 1 [m], jobYM * 1 [m], jobZM * 1 [m], BlueDog::Requirements::printBuildLimit) }
            }
            requirement printTileEnvelope : PrintTileEnvelope;
            #refinement dependency basisPrintTileEnvelope from printTileEnvelope to BlueDog::Requirements::desktopManufacture { metadata rationale : ModelingMetadata::Rationale { text = "Applies the same owner print-job envelope to structural tiles with accepted slicer evidence. The native system predicate supplies the common dimensional bounds."; } }
            // Compatibility projection for numerical adapters; authority is the analysis basis.
            analysis def MaterialInputs :> BlueDog::Analyses::StructuralBasis::Inputs;
            analysis material : MaterialInputs;




            dependency materialSource from MaterialInputs to hybridConstruction { metadata rationale : ModelingMetadata::Rationale { text = "Material input assumptions depend on the owner construction concept; a process change requires new property evidence and analysis inputs."; } }
            satisfy hybridConstruction by BlueDog::Architecture::missionContext.boat.hullAndRig.printedHull;
            satisfy bendingStrength by BlueDog::Architecture::missionContext.boat.hullAndRig;
            satisfy appendageDeflection by BlueDog::Architecture::missionContext.boat.hullAndRig;
            satisfy loadedFreeboard by BlueDog::Architecture::missionContext.boat.hullAndRig.printedHull;
            satisfy reserveBuoyancy by BlueDog::Architecture::missionContext.boat.hullAndRig.printedHull;
            satisfy launchClearance by BlueDog::Architecture::missionContext.boat.hullAndRig;
            satisfy printTileEnvelope by BlueDog::Architecture::missionContext.boat.hullAndRig.printedHull;
        }
    }

    package Architecture {
            doc /* The boat needs a hull and rig, electrical power, navigation and wind sensing, traffic detection, sailing control, communications, recovery equipment and data recording. This overview groups those jobs and identifies the operator, shore station, river conditions and other vessels. The logical architecture describes how the jobs interact; the IC-01 equipment proposal assigns them to candidate hardware.*/
            #user part def Operator;
            part def MonitoringStation;
            #externalSystem part def ShoreSupport {
                part monitoringStation : MonitoringStation;
            }
            #environment part def Environment;
            #externalSystem part def OtherVessel {
                doc /* External traffic, including commercial ships, barges, fishing and recreational craft, with or without AIS. Behavior and cooperation are outside Blue Dog control. */
            }
            #hardware part def PrintedHull;
            #hardware part def SealedEnclosure;
            #hardware part def KeelAndBallast;
            #hardware part def HandlingInterfaces;
            part def RigConcept {
                doc /* Three sail arrangements are under consideration: a soft sail, a rigid wing controlled by an aerodynamic tail, and a fixed-camber wing rotated by a drive. The comparison still needs sailing, energy, construction and recovery test results.*/
            }
            part def HullAndRig {
                part rig : RigConcept;
                part printedHull : PrintedHull;
                part enclosure : SealedEnclosure;
                part keelAndBallast : KeelAndBallast;
                part handling : HandlingInterfaces;
            }
            part def EnergyStorage;
            part def HarvestingInterface;
            part def PowerManagement;
            part def EnergySubsystem {
                part storage : EnergyStorage;
                part harvesting : HarvestingInterface;
                part powerManagement : PowerManagement;
            }
            part def PositionAndAttitude;
            part def WindSensing;
            part def TrafficSensing;
            part def NavigationAndSensing {
                part positionAndAttitude : PositionAndAttitude;
                part wind : WindSensing;
                part traffic : TrafficSensing;
            }
            part def MissionManager;
            part def CollisionAvoidance;
            part def BoundarySupervisor;
            part def GuidanceAndControl {
                part missionManager : MissionManager;
                part collisionAvoidance : CollisionAvoidance;
                part boundarySupervisor : BoundarySupervisor;
            }
            part def SailAndSteeringActuation;
            part def TelemetryRadio;
            part def AntennaSystem;
            part def CommandGateway;
            part def Communications {
                part telemetryRadio : TelemetryRadio;
                part antenna : AntennaSystem;
                part commandGateway : CommandGateway;
            }
            part def RecoveryPropulsion;
            part def RecoveryController;
            part def IngressMonitor;
            part def HealthAndRecovery {
                part motorSystem : RecoveryPropulsion;
                part recoveryController : RecoveryController;
                part ingressMonitor : IngressMonitor;
            }
            part def NavigationSignaling;
            part def DataRecording;
            part def ObservationPayload;

            #system part def Boat {
                doc /* Blue Dog combines hull and rig, power, sensing, control, sail and rudder actuation, communications, recovery, signaling and recording to complete the Gorge circuit. These groups identify the work the boat must perform. IC-01 describes the proposed equipment; its hardware still needs selection and testing.*/
                part hullAndRig : HullAndRig;
                part energy : EnergySubsystem;
                part navigation : NavigationAndSensing;
                part control : GuidanceAndControl;
                part actuation : SailAndSteeringActuation;
                part communications : Communications;
                part recovery : HealthAndRecovery;
                part recording : DataRecording;
                part signaling : NavigationSignaling;
                part observationPayload : ObservationPayload [0..1];
            }
            #systemContext part def MissionContext {
                part boat : Boat :>> systemOfInterest;
                part operator : Operator :>> users;
                part shoreSupport : ShoreSupport :> externalSystems;
                part :>> environment : Environment;
                part traffic : OtherVessel [0..*] :> externalSystems;
            }
            part missionContext : MissionContext;

        package Contracts {
            private import ScalarValues::*;
            doc /* Project allocation conventions, not a new relationship engine.
             * Primary/recovery label implementation paths, not automatic mode selection
             * or proof of independent operation. Each mapping is a provisional claim. */
            enum def ImplementationPath { primary; recovery; shared; }
            allocation def ContextMapping {
                end part context;
                end part logical;
                attribute scope : String;
            }
            allocation def IC01Responsibility {
                end part logical;
                end part implementation;
                ref part configuration : MarineDesign::Design = BlueDog::Configurations::IC01::design;
                attribute path : ImplementationPath;
                attribute scope : String;
            }
            allocation def IC01Exchange {
                end occurrence logical;
                end occurrence implementation;
                ref part configuration : MarineDesign::Design = BlueDog::Configurations::IC01::design;
                attribute path : ImplementationPath;
                attribute scope : String;
                doc /* Map a logical transfer to a candidate transfer. A common payload
                 * definition preserves meaning; latency, arbitration, encoding and
                 * installed protocol remain interface decisions, not implied by this link. */
            }
            allocation def IC01InternalExchange {
                end occurrence logical;
                end part implementation;
                ref part configuration : MarineDesign::Design = BlueDog::Configurations::IC01::design;
                attribute path : ImplementationPath;
                attribute scope : String;
                doc /* Interaction between responsibilities allocated to one controller.
                 * This records an internal implementation obligation, not an existing
                 * software call or measured scheduling/latency guarantee. */
            }
        }

        package Correspondence {
            private import BlueDog::Architecture::Contracts::*;
            private import BlueDog::Architecture::Logical::vessel;
            private import BlueDog::Architecture::Physical::ic01;
            private import BlueDog::Architecture::missionContext;
            doc /* Cross-description mappings for the finite-Gorge IC-01 hypothesis.
             * Logical/implementation allocation can be many-to-many. The scope on each
             * link identifies the contribution; no allocation asserts physical acceptance.
             * Source configurations and historical evidence retain their own identity. */
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            metadata interfaceDecisions : ModelingMetadata::Issue {
                text = "Resolve sensor freshness and validity propagation; peer timeout, authority arbitration and startup after primary loss; independent inverted safety observations; controller software deployment and timing; recording/telemetry power, retention and arbitration. Existing IC-01 mass and energy allowances are hypotheses, not a bill of materials or installed-load evidence.";
            }
            metadata contextLimits : ModelingMetadata::Issue {
                text = "Navigation signaling has a context responsibility and requirements but no detailed logical interface or IC-01 equipment allocation. Optional observation payload and future harvesting remain outside this finite-Gorge implementation. Hull/rig composition and operator launch/pickup stay in their physical and human descriptions; they are not fictitious controller functions.";
            }
            allocation contextEnergy : ContextMapping allocate missionContext.boat.energy to vessel.energy { attribute :>> scope = "Reserve estimation and protection"; }
            allocation contextNavigation : ContextMapping allocate missionContext.boat.navigation to vessel.navigation { attribute :>> scope = "Position and attitude estimation"; }
            allocation contextWind : ContextMapping allocate missionContext.boat.navigation to vessel.wind { attribute :>> scope = "Apparent wind estimates"; }
            allocation contextTrafficObservation : ContextMapping allocate missionContext.boat.navigation to vessel.trafficObservation { attribute :>> scope = "Traffic observations"; }
            allocation contextSupervision : ContextMapping allocate missionContext.boat.control to vessel.supervision { attribute :>> scope = "Permissions and qualification state"; }
            allocation contextGuidance : ContextMapping allocate missionContext.boat.control to vessel.guidance { attribute :>> scope = "Sailing commands"; }
            allocation contextCollision : ContextMapping allocate missionContext.boat.control to vessel.collision { attribute :>> scope = "Encounter assessment"; }
            allocation contextBoundary : ContextMapping allocate missionContext.boat.control to vessel.boundary { attribute :>> scope = "Operating domain assessment"; }
            allocation contextActuation : ContextMapping allocate missionContext.boat.actuation to vessel.actuation { attribute :>> scope = "Sail and steering execution"; }
            allocation contextCommunications : ContextMapping allocate missionContext.boat.communications to vessel.communications { attribute :>> scope = "Onboard telemetry and link status"; }
            allocation contextSafety : ContextMapping allocate missionContext.boat.recovery to vessel.safety { attribute :>> scope = "Required safety capability assessment"; }
            allocation contextRecovery : ContextMapping allocate missionContext.boat.recovery to vessel.recovery { attribute :>> scope = "Shore recovery planning and control"; }
            allocation contextRecoveryActuation : ContextMapping allocate missionContext.boat.recovery to vessel.recoveryActuation { attribute :>> scope = "Recovery propulsion execution"; }
            allocation contextRecording : ContextMapping allocate missionContext.boat.recording to vessel.recording { attribute :>> scope = "Mission evidence retention and readback"; }
            allocation primaryNavigation : IC01Responsibility allocate vessel.navigation to ic01.primaryNavigation {
                attribute :>> path = ImplementationPath::primary;
                attribute :>> scope = "Acquire and supply primary time-stamped navigation estimates";
            }
            allocation recoveryNavigation : IC01Responsibility allocate vessel.navigation to ic01.recoveryNavigation {
                attribute :>> path = ImplementationPath::recovery;
                attribute :>> scope = "Acquire and supply recovery-path navigation estimates";
            }
            allocation primaryNavigationValidation : IC01Responsibility allocate vessel.navigation to ic01.primaryController {
                attribute :>> path = ImplementationPath::primary;
                attribute :>> scope = "Validate and consume primary navigation estimates; stale data cannot become confirmed safety";
            }
            allocation recoveryNavigationValidation : IC01Responsibility allocate vessel.navigation to ic01.recoveryController {
                attribute :>> path = ImplementationPath::recovery;
                attribute :>> scope = "Validate recovery navigation independently of the primary estimate";
            }
            allocation wind : IC01Responsibility allocate vessel.wind to ic01.windSensor {
                attribute :>> path = ImplementationPath::primary;
                attribute :>> scope = "Supply apparent wind estimates with timestamp and validity";
            }
            allocation primarySafety : IC01Responsibility allocate vessel.safety to ic01.primaryController {
                attribute :>> path = ImplementationPath::primary;
                attribute :>> scope = "Assess primary safety capability from observations; inverted evidence remains unresolved";
            }
            allocation recoverySafety : IC01Responsibility allocate vessel.safety to ic01.recoveryController {
                attribute :>> path = ImplementationPath::recovery;
                attribute :>> scope = "Assess recovery safety capability; a peer report alone does not establish independence";
            }
            allocation primaryEnergy : IC01Responsibility allocate vessel.energy to ic01.primaryController {
                attribute :>> path = ImplementationPath::primary;
                attribute :>> scope = "Estimate main and recovery reserve and protect recovery energy";
            }
            allocation recoveryEnergy : IC01Responsibility allocate vessel.energy to ic01.recoveryController {
                attribute :>> path = ImplementationPath::recovery;
                attribute :>> scope = "Assess recovery-bank energy and route demand after primary loss";
            }
            allocation primaryCollision : IC01Responsibility allocate vessel.collision to ic01.primaryController {
                attribute :>> path = ImplementationPath::primary;
                attribute :>> scope = "Assess traffic for sailing";
            }
            allocation recoveryCollision : IC01Responsibility allocate vessel.collision to ic01.recoveryController {
                attribute :>> path = ImplementationPath::recovery;
                attribute :>> scope = "Assess traffic for powered recovery; implemented navigation-rule coverage remains open";
            }
            allocation primaryBoundary : IC01Responsibility allocate vessel.boundary to ic01.primaryController {
                attribute :>> path = ImplementationPath::primary;
                attribute :>> scope = "Assess the configured sailing domain";
            }
            allocation recoveryBoundary : IC01Responsibility allocate vessel.boundary to ic01.recoveryController {
                attribute :>> path = ImplementationPath::recovery;
                attribute :>> scope = "Assess recovery route boundaries and permitted shore approach";
            }
            allocation primaryObservation : IC01Responsibility allocate vessel.trafficObservation to ic01.primaryObservation {
                attribute :>> path = ImplementationPath::primary;
                attribute :>> scope = "Acquire primary traffic tracks; detection coverage remains unverified";
            }
            allocation recoveryObservation : IC01Responsibility allocate vessel.trafficObservation to ic01.recoveryObservation {
                attribute :>> path = ImplementationPath::recovery;
                attribute :>> scope = "Acquire recovery traffic tracks including the unresolved inverted installation";
            }
            allocation primarySupervision : IC01Responsibility allocate vessel.supervision to ic01.primaryController {
                attribute :>> path = ImplementationPath::primary;
                attribute :>> scope = "Sailing and gate permissions, qualification and abort state";
            }
            allocation recoverySupervision : IC01Responsibility allocate vessel.supervision to ic01.recoveryController {
                attribute :>> path = ImplementationPath::recovery;
                attribute :>> scope = "Recovery-side qualification restrictions and fallback authority; primary-loss arbitration remains open";
            }
            allocation guidance : IC01Responsibility allocate vessel.guidance to ic01.primaryController {
                attribute :>> path = ImplementationPath::primary;
                attribute :>> scope = "Select sailing guidance subject to current permissions";
            }
            allocation sailingActuation : IC01Responsibility allocate vessel.actuation to ic01.sailingActuators {
                attribute :>> path = ImplementationPath::primary;
                attribute :>> scope = "Execute permitted sailing commands";
            }
            allocation recoveryManagement : IC01Responsibility allocate vessel.recovery to ic01.recoveryController {
                attribute :>> path = ImplementationPath::recovery;
                attribute :>> scope = "Plan, reassess and command recovery; does not itself produce thrust or retrieve the boat";
            }
            allocation recoveryActuation : IC01Responsibility allocate vessel.recoveryActuation to ic01.recoveryPropulsor {
                attribute :>> path = ImplementationPath::recovery;
                attribute :>> scope = "Execute permitted recovery commands; achieved upright/inverted thrust remains unverified";
            }
            allocation recordStorage : IC01Responsibility allocate vessel.recording to ic01.recordStorage {
                attribute :>> path = ImplementationPath::shared;
                attribute :>> scope = "Persist and expose records; supply and post-fault availability remain unresolved";
            }
            allocation primaryRecordPolicy : IC01Responsibility allocate vessel.recording to ic01.primaryController {
                attribute :>> path = ImplementationPath::primary;
                attribute :>> scope = "Generate and schedule primary records and readback";
            }
            allocation recoveryRecordPolicy : IC01Responsibility allocate vessel.recording to ic01.recoveryController {
                attribute :>> path = ImplementationPath::recovery;
                attribute :>> scope = "Generate and schedule recovery records; shared-storage survival is unverified";
            }
            allocation telemetry : IC01Responsibility allocate vessel.communications to ic01.telemetry {
                attribute :>> path = ImplementationPath::shared;
                attribute :>> scope = "Transmit records and report link availability; supply and interface arbitration remain unresolved";
            }
            allocation primaryCommunications : IC01Responsibility allocate vessel.communications to ic01.primaryController {
                attribute :>> path = ImplementationPath::primary;
                attribute :>> scope = "Queue and prioritize primary telemetry without blocking autonomy";
            }
            allocation recoveryCommunications : IC01Responsibility allocate vessel.communications to ic01.recoveryController {
                attribute :>> path = ImplementationPath::recovery;
                attribute :>> scope = "Queue and prioritize recovery telemetry; autonomy does not require a link";
            }
            allocation navigationToSupervisorPrimaryNavigationData : IC01Exchange allocate vessel.navigationToSupervisor to ic01.primaryNavigationData {
                attribute :>> path = ImplementationPath::primary;
                attribute :>> scope = "Candidate payload transfer; installed timing, transport and fault handling remain to be specified";
            }
            allocation navigationToSupervisorRecoveryNavigationData : IC01Exchange allocate vessel.navigationToSupervisor to ic01.recoveryNavigationData {
                attribute :>> path = ImplementationPath::recovery;
                attribute :>> scope = "Candidate payload transfer; installed timing, transport and fault handling remain to be specified";
            }
            allocation navigationToGuidancePrimaryNavigationData : IC01Exchange allocate vessel.navigationToGuidance to ic01.primaryNavigationData {
                attribute :>> path = ImplementationPath::primary;
                attribute :>> scope = "Candidate payload transfer; installed timing, transport and fault handling remain to be specified";
            }
            allocation windToGuidanceWindData : IC01Exchange allocate vessel.windToGuidance to ic01.windData {
                attribute :>> path = ImplementationPath::primary;
                attribute :>> scope = "Candidate payload transfer; installed timing, transport and fault handling remain to be specified";
            }
            allocation windToSupervisorWindData : IC01Exchange allocate vessel.windToSupervisor to ic01.windData {
                attribute :>> path = ImplementationPath::primary;
                attribute :>> scope = "Candidate payload transfer; installed timing, transport and fault handling remain to be specified";
            }
            allocation linkToSupervisorPrimaryLinkStatus : IC01Exchange allocate vessel.linkToSupervisor to ic01.primaryLinkStatus {
                attribute :>> path = ImplementationPath::primary;
                attribute :>> scope = "Candidate payload transfer; installed timing, transport and fault handling remain to be specified";
            }
            allocation linkToSupervisorRecoveryLinkStatus : IC01Exchange allocate vessel.linkToSupervisor to ic01.recoveryLinkStatus {
                attribute :>> path = ImplementationPath::recovery;
                attribute :>> scope = "Candidate payload transfer; installed timing, transport and fault handling remain to be specified";
            }
            allocation safetyToSupervisorRecoverySafetyToPrimary : IC01Exchange allocate vessel.safetyToSupervisor to ic01.recoverySafetyToPrimary {
                attribute :>> path = ImplementationPath::primary;
                attribute :>> scope = "Candidate payload transfer; installed timing, transport and fault handling remain to be specified";
            }
            allocation safetyToSupervisorPrimarySafetyToRecovery : IC01Exchange allocate vessel.safetyToSupervisor to ic01.primarySafetyToRecovery {
                attribute :>> path = ImplementationPath::recovery;
                attribute :>> scope = "Candidate payload transfer; installed timing, transport and fault handling remain to be specified";
            }
            allocation safetyToRecoveryPrimarySafetyToRecovery : IC01Exchange allocate vessel.safetyToRecovery to ic01.primarySafetyToRecovery {
                attribute :>> path = ImplementationPath::recovery;
                attribute :>> scope = "Candidate payload transfer; installed timing, transport and fault handling remain to be specified";
            }
            allocation tracksToCollisionPrimaryTrafficData : IC01Exchange allocate vessel.tracksToCollision to ic01.primaryTrafficData {
                attribute :>> path = ImplementationPath::primary;
                attribute :>> scope = "Candidate payload transfer; installed timing, transport and fault handling remain to be specified";
            }
            allocation tracksToCollisionRecoveryTrafficData : IC01Exchange allocate vessel.tracksToCollision to ic01.recoveryTrafficData {
                attribute :>> path = ImplementationPath::recovery;
                attribute :>> scope = "Candidate payload transfer; installed timing, transport and fault handling remain to be specified";
            }
            allocation navigationToCollisionPrimaryNavigationData : IC01Exchange allocate vessel.navigationToCollision to ic01.primaryNavigationData {
                attribute :>> path = ImplementationPath::primary;
                attribute :>> scope = "Candidate payload transfer; installed timing, transport and fault handling remain to be specified";
            }
            allocation navigationToCollisionRecoveryNavigationData : IC01Exchange allocate vessel.navigationToCollision to ic01.recoveryNavigationData {
                attribute :>> path = ImplementationPath::recovery;
                attribute :>> scope = "Candidate payload transfer; installed timing, transport and fault handling remain to be specified";
            }
            allocation navigationToBoundaryPrimaryNavigationData : IC01Exchange allocate vessel.navigationToBoundary to ic01.primaryNavigationData {
                attribute :>> path = ImplementationPath::primary;
                attribute :>> scope = "Candidate payload transfer; installed timing, transport and fault handling remain to be specified";
            }
            allocation navigationToBoundaryRecoveryNavigationData : IC01Exchange allocate vessel.navigationToBoundary to ic01.recoveryNavigationData {
                attribute :>> path = ImplementationPath::recovery;
                attribute :>> scope = "Candidate payload transfer; installed timing, transport and fault handling remain to be specified";
            }
            allocation permissionsToActuationSailingPermissions : IC01Exchange allocate vessel.permissionsToActuation to ic01.sailingPermissions {
                attribute :>> path = ImplementationPath::primary;
                attribute :>> scope = "Candidate payload transfer; installed timing, transport and fault handling remain to be specified";
            }
            allocation permissionsToRecoveryPrimaryPermissionsToRecovery : IC01Exchange allocate vessel.permissionsToRecovery to ic01.primaryPermissionsToRecovery {
                attribute :>> path = ImplementationPath::recovery;
                attribute :>> scope = "Candidate payload transfer; installed timing, transport and fault handling remain to be specified";
            }
            allocation sailingCommandsSailingCommandData : IC01Exchange allocate vessel.sailingCommands to ic01.sailingCommandData {
                attribute :>> path = ImplementationPath::primary;
                attribute :>> scope = "Candidate payload transfer; installed timing, transport and fault handling remain to be specified";
            }
            allocation supervisorRecordsPrimaryRecords : IC01Exchange allocate vessel.supervisorRecords to ic01.primaryRecords {
                attribute :>> path = ImplementationPath::primary;
                attribute :>> scope = "Candidate payload transfer; installed timing, transport and fault handling remain to be specified";
            }
            allocation supervisorRecordsRecoveryRecords : IC01Exchange allocate vessel.supervisorRecords to ic01.recoveryRecords {
                attribute :>> path = ImplementationPath::recovery;
                attribute :>> scope = "Candidate payload transfer; installed timing, transport and fault handling remain to be specified";
            }
            allocation supervisorTelemetryPrimaryTelemetry : IC01Exchange allocate vessel.supervisorTelemetry to ic01.primaryTelemetry {
                attribute :>> path = ImplementationPath::primary;
                attribute :>> scope = "Candidate payload transfer; installed timing, transport and fault handling remain to be specified";
            }
            allocation supervisorTelemetryRecoveryTelemetry : IC01Exchange allocate vessel.supervisorTelemetry to ic01.recoveryTelemetry {
                attribute :>> path = ImplementationPath::recovery;
                attribute :>> scope = "Candidate payload transfer; installed timing, transport and fault handling remain to be specified";
            }
            allocation navigationToRecoveryRecoveryNavigationData : IC01Exchange allocate vessel.navigationToRecovery to ic01.recoveryNavigationData {
                attribute :>> path = ImplementationPath::recovery;
                attribute :>> scope = "Candidate payload transfer; installed timing, transport and fault handling remain to be specified";
            }
            allocation tracksToRecoveryRecoveryTrafficData : IC01Exchange allocate vessel.tracksToRecovery to ic01.recoveryTrafficData {
                attribute :>> path = ImplementationPath::recovery;
                attribute :>> scope = "Candidate payload transfer; installed timing, transport and fault handling remain to be specified";
            }
            allocation recoveryCommandsRecoveryCommandData : IC01Exchange allocate vessel.recoveryCommands to ic01.recoveryCommandData {
                attribute :>> path = ImplementationPath::recovery;
                attribute :>> scope = "Candidate payload transfer; installed timing, transport and fault handling remain to be specified";
            }
            allocation recoveryRecordsRecoveryRecords : IC01Exchange allocate vessel.recoveryRecords to ic01.recoveryRecords {
                attribute :>> path = ImplementationPath::recovery;
                attribute :>> scope = "Candidate payload transfer; installed timing, transport and fault handling remain to be specified";
            }
            allocation recoveryTelemetryRecoveryTelemetry : IC01Exchange allocate vessel.recoveryTelemetry to ic01.recoveryTelemetry {
                attribute :>> path = ImplementationPath::recovery;
                attribute :>> scope = "Candidate payload transfer; installed timing, transport and fault handling remain to be specified";
            }
            allocation retainedRecordsToCommunicationsPrimaryRecordReadback : IC01Exchange allocate vessel.retainedRecordsToCommunications to ic01.primaryRecordReadback {
                attribute :>> path = ImplementationPath::primary;
                attribute :>> scope = "Candidate payload transfer; installed timing, transport and fault handling remain to be specified";
            }
            allocation retainedRecordsToCommunicationsRecoveryRecordReadback : IC01Exchange allocate vessel.retainedRecordsToCommunications to ic01.recoveryRecordReadback {
                attribute :>> path = ImplementationPath::recovery;
                attribute :>> scope = "Candidate payload transfer; installed timing, transport and fault handling remain to be specified";
            }
            allocation safetyToSupervisorPrimaryInternal : IC01InternalExchange allocate vessel.safetyToSupervisor to ic01.primaryController {
                attribute :>> path = ImplementationPath::primary;
                attribute :>> scope = "Internal interaction of coallocated responsibilities; software scheduling, validity propagation and fault handling remain unresolved";
            }
            allocation safetyToSupervisorRecoveryInternal : IC01InternalExchange allocate vessel.safetyToSupervisor to ic01.recoveryController {
                attribute :>> path = ImplementationPath::recovery;
                attribute :>> scope = "Internal interaction of coallocated responsibilities; software scheduling, validity propagation and fault handling remain unresolved";
            }
            allocation safetyToRecoveryRecoveryInternal : IC01InternalExchange allocate vessel.safetyToRecovery to ic01.recoveryController {
                attribute :>> path = ImplementationPath::recovery;
                attribute :>> scope = "Internal interaction of coallocated responsibilities; software scheduling, validity propagation and fault handling remain unresolved";
            }
            allocation reserveToSupervisorPrimaryInternal : IC01InternalExchange allocate vessel.reserveToSupervisor to ic01.primaryController {
                attribute :>> path = ImplementationPath::primary;
                attribute :>> scope = "Internal interaction of coallocated responsibilities; software scheduling, validity propagation and fault handling remain unresolved";
            }
            allocation reserveToSupervisorRecoveryInternal : IC01InternalExchange allocate vessel.reserveToSupervisor to ic01.recoveryController {
                attribute :>> path = ImplementationPath::recovery;
                attribute :>> scope = "Internal interaction of coallocated responsibilities; software scheduling, validity propagation and fault handling remain unresolved";
            }
            allocation reserveToRecoveryRecoveryInternal : IC01InternalExchange allocate vessel.reserveToRecovery to ic01.recoveryController {
                attribute :>> path = ImplementationPath::recovery;
                attribute :>> scope = "Internal interaction of coallocated responsibilities; software scheduling, validity propagation and fault handling remain unresolved";
            }
            allocation trafficToSupervisorPrimaryInternal : IC01InternalExchange allocate vessel.trafficToSupervisor to ic01.primaryController {
                attribute :>> path = ImplementationPath::primary;
                attribute :>> scope = "Internal interaction of coallocated responsibilities; software scheduling, validity propagation and fault handling remain unresolved";
            }
            allocation trafficToSupervisorRecoveryInternal : IC01InternalExchange allocate vessel.trafficToSupervisor to ic01.recoveryController {
                attribute :>> path = ImplementationPath::recovery;
                attribute :>> scope = "Internal interaction of coallocated responsibilities; software scheduling, validity propagation and fault handling remain unresolved";
            }
            allocation boundaryToSupervisorPrimaryInternal : IC01InternalExchange allocate vessel.boundaryToSupervisor to ic01.primaryController {
                attribute :>> path = ImplementationPath::primary;
                attribute :>> scope = "Internal interaction of coallocated responsibilities; software scheduling, validity propagation and fault handling remain unresolved";
            }
            allocation boundaryToSupervisorRecoveryInternal : IC01InternalExchange allocate vessel.boundaryToSupervisor to ic01.recoveryController {
                attribute :>> path = ImplementationPath::recovery;
                attribute :>> scope = "Internal interaction of coallocated responsibilities; software scheduling, validity propagation and fault handling remain unresolved";
            }
            allocation boundaryToGuidancePrimaryInternal : IC01InternalExchange allocate vessel.boundaryToGuidance to ic01.primaryController {
                attribute :>> path = ImplementationPath::primary;
                attribute :>> scope = "Internal interaction of coallocated responsibilities; software scheduling, validity propagation and fault handling remain unresolved";
            }
            allocation permissionsToGuidancePrimaryInternal : IC01InternalExchange allocate vessel.permissionsToGuidance to ic01.primaryController {
                attribute :>> path = ImplementationPath::primary;
                attribute :>> scope = "Internal interaction of coallocated responsibilities; software scheduling, validity propagation and fault handling remain unresolved";
            }
            allocation permissionsToRecoveryRecoveryInternal : IC01InternalExchange allocate vessel.permissionsToRecovery to ic01.recoveryController {
                attribute :>> path = ImplementationPath::recovery;
                attribute :>> scope = "Internal interaction of coallocated responsibilities; software scheduling, validity propagation and fault handling remain unresolved";
            }
            allocation boundaryToRecoveryRecoveryInternal : IC01InternalExchange allocate vessel.boundaryToRecovery to ic01.recoveryController {
                attribute :>> path = ImplementationPath::recovery;
                attribute :>> scope = "Internal interaction of coallocated responsibilities; software scheduling, validity propagation and fault handling remain unresolved";
            }
        }

        package Interfaces {
            private import ScalarValues::*;
            private import ISQ::*;
            private import SI::*;
            doc /* Candidate logical data contracts. Source basis: NASA SE Handbook
             * 6.3.1.2.2-3; historical NASA SWE-112 section 3 (DI-IPSC-81436A-based
             * guidance); OMG SysML 2.0 sections 7.12-7.16. These definitions do not
             * select transport, serialize messages or implement runtime acceptance. */

            item def ObservationContext {
                attribute sourceIdentity : String;
                attribute configurationIdentity : String;
                attribute clockIdentity : String;
                attribute sourceEpoch : String;
                attribute sequence : Integer;
                doc /* Identity and sequence are semantic provenance, not authentication.
                 * Epoch changes on producer restart; ordering is meaningful only within
                 * the identified source/epoch. Clock identity requires an established
                 * epoch, synchronization and uncertainty contract before comparing times. */
            }
            item def CommandContext {
                attribute authorityIdentity : String;
                attribute configurationIdentity : String;
                attribute clockIdentity : String;
                attribute authorityEpoch : String;
                attribute sequence : Integer;
                attribute issuedAt : TimeValue;
                attribute validUntil : TimeValue;
                doc /* Times use one identified monotonic reference. Consumers must use
                 * an agreed authority epoch and ordering rule. Expiry cannot grant
                 * permission or clear an abort. Arbitration, restart and inhibit design
                 * remain unresolved; these fields do not establish an independent path. */
            }
            calc def ObservationUsable {
                doc /* Parameterized consumer precondition, not a selected freshness
                 * policy. All comparisons require one established clock and applicable
                 * configuration/frame. Producer validity alone is insufficient. A
                 * negative observation may be valid. Bounds here are inclusive; a
                 * consumer's allocated criterion must justify its maximumAge. */
                in producerValid : Boolean;
                in contextApplicable : Boolean;
                in clockEstablished : Boolean;
                in observedAt : TimeValue;
                in now : TimeValue;
                in maximumAge : TimeValue;
                return usable : Boolean = producerValid and contextApplicable and clockEstablished
                    and maximumAge >= 0 [s] and observedAt <= now and now - observedAt <= maximumAge;
            }
            calc def CommandApplicable {
                doc /* Parameterized applicability only. Does not grant authority or
                 * defeat the consumer's current permission/inhibit. Replay protection,
                 * arbitration and clock establishment require separate implementation. */
                in authorityAccepted : Boolean;
                in contextApplicable : Boolean;
                in clockEstablished : Boolean;
                in orderingAccepted : Boolean;
                in issuedAt : TimeValue;
                in validUntil : TimeValue;
                in now : TimeValue;
                return applicable : Boolean = authorityAccepted and contextApplicable and clockEstablished
                    and orderingAccepted and issuedAt <= now and now <= validUntil and issuedAt <= validUntil;
            }
            metadata issue : ModelingMetadata::Issue {
                text = "IF-01: Select per-consumer freshness/latency limits from safety and control analysis; cadence does not establish age. IF-02: Establish clock epoch, synchronization uncertainty, producer/authority restart and replay rules. IF-03: Resolve navigation datum, heading/bearing/trim references and required transformations. IF-04: Resolve primary/recovery arbitration, safe inhibits and command expiry. IF-05: Specify physical voltage/current/protection, connector and sealing contracts, storage/telemetry supply and encoding/protocol details. Schema and predicate checks do not close these implementation and physical-evidence gaps.";
            }
        }

        package Logical {
            private import OOSEM::*;
            private import ScalarValues::*;
            doc /* The onboard functions estimate position and wind, assess traffic and safety, plan sailing commands, decide which operations are allowed, operate the actuators, manage recovery, store records and communicate with shore. Their connections carry observations, permissions, commands and records. The physical architecture assigns these functions to proposed equipment.*/

            #ioEntity item def NavigationEstimate {
                attribute coordinateReference : String;
                attribute headingReference : String;
                item context : BlueDog::Architecture::Interfaces::ObservationContext;
                attribute valid : Boolean;
                attribute observedAt : ISQ::TimeValue;
                attribute latitude : ISQ::AngularMeasureValue;
                attribute longitude : ISQ::AngularMeasureValue;
                attribute heading : ISQ::AngularMeasureValue;
            }
            #ioEntity item def SafetyObservation {
                attribute valid : ScalarValues::Boolean;
                item context : BlueDog::Architecture::Interfaces::ObservationContext;
                attribute capsized : Boolean;
                attribute uprightControlRestored : Boolean;
                attribute requiredSafetyConfirmed : Boolean;
                attribute observedAt : ISQ::TimeValue;
                doc /* Reports whether navigation, traffic assessment, boundary awareness, energy and recovery remain available. A failed primary component may be covered by a working backup. Continued operation after capsize or a switch to backup equipment requires observations confirming that the required functions still work.*/
            }
            #ioEntity item def ReserveAssessment {
                attribute observedAt : ISQ::TimeValue;
                item context : BlueDog::Architecture::Interfaces::ObservationContext;
                attribute usableEnergy : ISQ::EnergyValue;
                attribute protectedReserve : ISQ::EnergyValue;
                attribute threatened : Boolean;
                attribute valid : Boolean;
            }
            #ioEntity item def TrafficAssessment {
                item context : BlueDog::Architecture::Interfaces::ObservationContext;
                attribute conflict : Boolean;
                attribute valid : Boolean;
                attribute observedAt : ISQ::TimeValue;
            }
            #ioEntity item def BoundaryAssessment {
                attribute observedAt : ISQ::TimeValue;
                item context : BlueDog::Architecture::Interfaces::ObservationContext;
                attribute insidePermittedArea : Boolean;
                attribute avoidanceRequired : Boolean;
                attribute valid : Boolean;
                doc /* Evaluated against the configured water domain, exclusions and
                 * current navigation observation; this is not a surveyed-site approval. */
            }
            #ioEntity item def TrafficTrack {
                attribute bearingReference : String;
                attribute rangeReference : String;
                attribute headingReference : String;
                item context : BlueDog::Architecture::Interfaces::ObservationContext;
                attribute identity : String;
                attribute observedAt : ISQ::TimeValue;
                attribute bearing : ISQ::AngularMeasureValue;
                attribute range : ISQ::LengthValue;
                attribute speed : ISQ::SpeedValue;
                attribute heading : ISQ::AngularMeasureValue;
                attribute valid : Boolean;
                doc /* A tracked contact may come from AIS or non-cooperative sensing.
                 * Declared observation validity does not establish detection coverage. */
            }
            #ioEntity item def TrafficObservation {
                attribute valid : ScalarValues::Boolean;
                attribute observedAt : ISQ::TimeValue;
                item context : BlueDog::Architecture::Interfaces::ObservationContext;
                item tracks : TrafficTrack [0..*];
                attribute coverageConfirmed : Boolean;
            }
            #ioEntity item def OperationPermission {
                item context : BlueDog::Architecture::Interfaces::CommandContext;
                attribute sailingPermitted : Boolean;
                attribute gateScoringPermitted : Boolean;
                attribute harvestPermitted : Boolean;
                attribute abortLatched : Boolean;
                attribute qualificationLost : Boolean;
            }
            #ioEntity item def RecoveryCommand {
                item context : BlueDog::Architecture::Interfaces::CommandContext;
                attribute recoveryRequested : Boolean;
                attribute propulsionPermitted : Boolean;
                doc /* Powered recovery follows qualification loss. This command does
                 * not assert shore reachability or available independent hardware. */
            }
            #ioEntity item def MissionRecord {
                item context : BlueDog::Architecture::Interfaces::ObservationContext;
                attribute eventKind : String;
                attribute observedAt : ISQ::TimeValue;
                attribute qualificationLost : Boolean;
                attribute abortLatched : Boolean;
            }
            port def NavigationOutput { out item estimate : NavigationEstimate; }
            port def NavigationInput { in item estimate : NavigationEstimate; }
            port def WindOutput { out item estimate : BlueDog::Method::WindEstimate; }
            port def WindInput { in item estimate : BlueDog::Method::WindEstimate; }
            port def LinkOutput { out item observation : BlueDog::Method::LinkObservation; }
            port def LinkInput { in item observation : BlueDog::Method::LinkObservation; }
            port def SafetyOutput { out item observation : SafetyObservation; }
            port def SafetyInput { in item observation : SafetyObservation; }
            port def ReserveOutput { out item assessment : ReserveAssessment; }
            port def ReserveInput { in item assessment : ReserveAssessment; }
            port def TrafficOutput { out item assessment : TrafficAssessment; }
            port def TrafficInput { in item assessment : TrafficAssessment; }
            port def BoundaryOutput { out item assessment : BoundaryAssessment; }
            port def BoundaryInput { in item assessment : BoundaryAssessment; }
            port def TracksOutput { out item observation : TrafficObservation; }
            port def TracksInput { in item observation : TrafficObservation; }
            port def PermissionOutput { out item permission : OperationPermission; }
            port def PermissionInput { in item permission : OperationPermission; }
            port def CommandOutput { out item command : BlueDog::Method::SailingCommand; }
            port def CommandInput { in item command : BlueDog::Method::SailingCommand; }
            port def RecordOutput { out item record : MissionRecord; }
            port def RecordInput { in item record : MissionRecord; }
            port def RecoveryOutput { out item command : RecoveryCommand; }
            port def RecoveryInput { in item command : RecoveryCommand; }

            #logical part def NavigationEstimation { port navigation : NavigationOutput; }
            #logical part def WindEstimation { port wind : WindOutput; }
            #logical part def SafetyAssessment { port safety : SafetyOutput; }
            #logical part def EnergyManagement { port reserve : ReserveOutput; }
            #logical part def TrafficObservationService { port tracks : TracksOutput; }
            #logical part def CollisionAssessment {
                port tracks : TracksInput;
                port navigation : NavigationInput;
                port traffic : TrafficOutput;
            }
            #logical part def BoundaryManagement {
                port navigation : NavigationInput;
                port boundary : BoundaryOutput;
            }
            #logical part def MissionSupervision {
                port navigation : NavigationInput;
                port wind : WindInput;
                port link : LinkInput;
                port safety : SafetyInput;
                port reserve : ReserveInput;
                port traffic : TrafficInput;
                port boundary : BoundaryInput;
                port permissions : PermissionOutput;
                port events : RecordOutput;
            }
            #logical part def Guidance {
                port navigation : NavigationInput;
                port wind : WindInput;
                port boundary : BoundaryInput;
                port permissions : PermissionInput;
                port commands : CommandOutput;
            }
            #logical part def SailingActuation {
                port commands : CommandInput;
                port permissions : PermissionInput;
            }
            #logical part def RecoveryManagement {
                doc /* Choose and update a reachable shore retrieval route using position, traffic, boundaries, remaining safety functions and available energy. Send permitted propulsion commands to RecoveryActuation. The recovery plan must also account for reaching and staying at a place where the operator can retrieve the boat.*/
                port navigation : NavigationInput;
                port tracks : TracksInput;
                port boundary : BoundaryInput;
                port events : RecordOutput;
                port safety : SafetyInput;
                port reserve : ReserveInput;
                port permissions : PermissionInput;
                port commands : RecoveryOutput;
            }
            #logical part def RecoveryActuation {
                port commands : RecoveryInput;
                doc /* Apply permitted recovery propulsion commands. Tests must measure delivered thrust, operation after capsize, arrival at the retrieval location and the ability to stay there.*/
            }
            #logical part def Recording {
                port events : RecordInput;
                port retained : RecordOutput;
            }
            #logical part def Communications {
                port events : RecordInput;
                port retained : RecordInput;
                port status : LinkOutput;
            }
            part def LogicalVessel {
                doc /* Navigation and wind estimates feed guidance. Traffic, boundary, safety and energy assessments feed the supervisor, which grants or withdraws permission to sail or recover. Actuators apply permitted commands. Recovery planning selects a route to shore; recording and communications preserve and report the attempt history.*/
                part navigation : NavigationEstimation;
                part wind : WindEstimation;
                part safety : SafetyAssessment;
                part energy : EnergyManagement;
                part collision : CollisionAssessment;
                part boundary : BoundaryManagement;
                part trafficObservation : TrafficObservationService;
                part supervision : MissionSupervision;
                part guidance : Guidance;
                part actuation : SailingActuation;
                part recovery : RecoveryManagement;
                part recoveryActuation : RecoveryActuation;
                part recording : Recording;
                part communications : Communications;
                flow navigationToSupervisor from navigation.navigation.estimate to supervision.navigation.estimate;
                flow navigationToGuidance from navigation.navigation.estimate to guidance.navigation.estimate;
                flow windToGuidance from wind.wind.estimate to guidance.wind.estimate;
                flow windToSupervisor from wind.wind.estimate to supervision.wind.estimate;
                flow linkToSupervisor from communications.status.observation to supervision.link.observation;
                flow safetyToSupervisor from safety.safety.observation to supervision.safety.observation;
                flow safetyToRecovery from safety.safety.observation to recovery.safety.observation;
                flow reserveToSupervisor from energy.reserve.assessment to supervision.reserve.assessment;
                flow reserveToRecovery from energy.reserve.assessment to recovery.reserve.assessment;
                flow trafficToSupervisor from collision.traffic.assessment to supervision.traffic.assessment;
                flow tracksToCollision from trafficObservation.tracks.observation to collision.tracks.observation;
                flow navigationToCollision from navigation.navigation.estimate to collision.navigation.estimate;
                flow navigationToBoundary from navigation.navigation.estimate to boundary.navigation.estimate;
                flow boundaryToSupervisor from boundary.boundary.assessment to supervision.boundary.assessment;
                flow boundaryToGuidance from boundary.boundary.assessment to guidance.boundary.assessment;
                flow permissionsToGuidance from supervision.permissions.permission to guidance.permissions.permission;
                flow permissionsToActuation from supervision.permissions.permission to actuation.permissions.permission;
                flow permissionsToRecovery from supervision.permissions.permission to recovery.permissions.permission;
                flow sailingCommands from guidance.commands.command to actuation.commands.command;
                flow supervisorRecords from supervision.events.record to recording.events.record;
                flow supervisorTelemetry from supervision.events.record to communications.events.record;
                flow navigationToRecovery from navigation.navigation.estimate to recovery.navigation.estimate;
                flow tracksToRecovery from trafficObservation.tracks.observation to recovery.tracks.observation;
                flow boundaryToRecovery from boundary.boundary.assessment to recovery.boundary.assessment;
                flow recoveryCommands from recovery.commands.command to recoveryActuation.commands.command;
                flow recoveryRecords from recovery.events.record to recording.events.record;
                flow recoveryTelemetry from recovery.events.record to communications.events.record;
                flow retainedRecordsToCommunications from recording.retained.record to communications.retained.record;
            }
            part vessel : LogicalVessel;
        }

        package Physical {
            private import OOSEM::*;
            private import ScalarValues::*;
            private import BlueDog::Architecture::Logical::*;
            doc /* IC-01 proposes primary sailing equipment and a separate recovery battery, navigation sensors, observation equipment, controller and propulsor. The design aims to preserve recovery after a primary failure. Hardware tests must establish which faults each path can survive, including flooding and capsize. Equipment choices, wiring, connectors, supply ratings and data rates remain open.*/
            #ioEntity item def ElectricalSupply {
                attribute availablePower : ISQ::PowerValue;
                attribute available : Boolean;
            }
            #ioEntity item def MonitoredBankState {
                item context : BlueDog::Architecture::Interfaces::ObservationContext;
                attribute usableEnergy : ISQ::EnergyValue;
                attribute valid : Boolean;
                attribute observedAt : ISQ::TimeValue;
                doc /* Reports estimated usable battery energy, observation time and validity. Energy management compares this estimate with the energy needed for the current recovery route.*/
            }
            port def SupplyOutput { out item electrical : ElectricalSupply; }
            port def SupplyInput { in item electrical : ElectricalSupply; }
            port def BankStateOutput { out item observation : MonitoredBankState; }
            port def BankStateInput { in item observation : MonitoredBankState; }
            #hardware part def Battery {
                attribute nameplateWh : Real;
                port output : SupplyOutput;
                port monitor : BankStateOutput;
                doc /* Stores electrical energy and supplies the connected equipment. Its monitor must estimate usable energy and report observation time and validity. Sensing, calibration and installation still need to be selected.*/
            }
            #hardware part def NavigationSensors {
                port power : SupplyInput;
                port navigation : NavigationOutput;
            }
            #hardware part def WindSensor {
                ref part installation : BlueDog::Configurations::WindEquipment::Installation = BlueDog::Configurations::WindEquipment::challenge;
                port power : SupplyInput;
                port wind : WindOutput;
            }
            #hardware part def ObservationEquipment {
                port power : SupplyInput;
                port tracks : TracksOutput;
            }
            #hardware part def Controller {
                port power : SupplyInput;
                port link : LinkInput;
                port navigation : NavigationInput;
                port wind : WindInput;
                port tracks : TracksInput;
                port safety : SafetyInput;
                port assessedSafety : SafetyOutput;
                port mainBank : BankStateInput;
                port recoveryBank : BankStateInput;
                port commands : CommandOutput;
                port recovery : RecoveryOutput;
                port permissions : PermissionOutput;
                port peerPermissions : PermissionInput;
                port retained : RecordInput;
                port events : RecordOutput;
                doc /* Combines sensor, actuator, battery and health observations to assess safety and issue permitted sailing or recovery commands. The software, peer timeout and failure detection need to be designed and tested, including incorrect or missing peer reports.*/
            }
            #hardware part def SailingActuators {
                port power : SupplyInput;
                port commands : CommandInput;
                port permissions : PermissionInput;
            }
            #hardware part def RecoveryPropulsor {
                port power : SupplyInput;
                port recovery : RecoveryInput;
            }
            #hardware part def RecordStorage {
                port power : SupplyInput;
                port events : RecordInput;
                port retained : RecordOutput;
                doc /* Stores mission events and provides records for delayed telemetry. The design still needs a power supply, access rules and retention behavior that preserve the required records after a primary fault.*/
            }
            #hardware part def TelemetryEquipment {
                port power : SupplyInput;
                port events : RecordInput;
                port status : LinkOutput;
            }
            #hardware part def IC01Candidate {
                doc /* The IC-01 equipment proposal combines hull and rig, primary sailing power and controls, a separate recovery power and control path, telemetry and record storage. Hardware selection and tests must establish mass, electrical demand, sealing, capsize performance and recovery after faults.*/
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                metadata issue : ModelingMetadata::Issue {
                    text = "Recovery still needs tests for shared faults, operation after capsize, sealing, installed loads and interfaces. The power supplies for telemetry and record storage are undecided. The recovery model currently assumes 8 W of essential load and a 60 Wh battery; installed measurements must establish demand and usable capacity.";
                }
                part mainBattery : Battery { attribute :>> nameplateWh = BlueDog::Configurations::IC01::design.battery_Wh; }
                part recoveryBattery : Battery { attribute :>> nameplateWh = BlueDog::Configurations::IC01::integration.recoveryBatteryWh; }
                part primaryNavigation : NavigationSensors;
                part windSensor : WindSensor;
                part primaryObservation : ObservationEquipment;
                part primaryController : Controller;
                part sailingActuators : SailingActuators;
                part recoveryNavigation : NavigationSensors;
                part recoveryObservation : ObservationEquipment;
                part recoveryController : Controller;
                part recoveryPropulsor : RecoveryPropulsor;
                part recordStorage : RecordStorage;
                part telemetry : TelemetryEquipment;
                part hullAndRig : BlueDog::Architecture::HullAndRig;
                flow mainNavigationPower from mainBattery.output.electrical to primaryNavigation.power.electrical;
                flow windPower from mainBattery.output.electrical to windSensor.power.electrical;
                flow mainObservationPower from mainBattery.output.electrical to primaryObservation.power.electrical;
                flow mainControllerPower from mainBattery.output.electrical to primaryController.power.electrical;
                flow sailingPower from mainBattery.output.electrical to sailingActuators.power.electrical;
                flow recoveryNavigationPower from recoveryBattery.output.electrical to recoveryNavigation.power.electrical;
                flow recoveryObservationPower from recoveryBattery.output.electrical to recoveryObservation.power.electrical;
                flow recoveryControllerPower from recoveryBattery.output.electrical to recoveryController.power.electrical;
                flow recoveryPropulsionPower from recoveryBattery.output.electrical to recoveryPropulsor.power.electrical;
                flow mainBankToPrimary from mainBattery.monitor.observation to primaryController.mainBank.observation;
                flow recoveryBankToPrimary from recoveryBattery.monitor.observation to primaryController.recoveryBank.observation;
                flow recoveryBankToRecovery from recoveryBattery.monitor.observation to recoveryController.recoveryBank.observation;
                flow mainBankToRecovery from mainBattery.monitor.observation to recoveryController.mainBank.observation;
                flow primaryNavigationData from primaryNavigation.navigation.estimate to primaryController.navigation.estimate;
                flow windData from windSensor.wind.estimate to primaryController.wind.estimate;
                flow primaryTrafficData from primaryObservation.tracks.observation to primaryController.tracks.observation;
                flow primarySafetyToRecovery from primaryController.assessedSafety.observation to recoveryController.safety.observation;
                flow recoverySafetyToPrimary from recoveryController.assessedSafety.observation to primaryController.safety.observation;
                flow sailingPermissions from primaryController.permissions.permission to sailingActuators.permissions.permission;
                flow primaryPermissionsToRecovery from primaryController.permissions.permission to recoveryController.peerPermissions.permission;
                flow recoveryPermissionsToPrimary from recoveryController.permissions.permission to primaryController.peerPermissions.permission;
                flow sailingCommandData from primaryController.commands.command to sailingActuators.commands.command;
                flow recoveryNavigationData from recoveryNavigation.navigation.estimate to recoveryController.navigation.estimate;
                flow recoveryTrafficData from recoveryObservation.tracks.observation to recoveryController.tracks.observation;
                flow recoveryCommandData from recoveryController.recovery.command to recoveryPropulsor.recovery.command;
                flow primaryRecords from primaryController.events.record to recordStorage.events.record;
                flow recoveryRecords from recoveryController.events.record to recordStorage.events.record;
                flow primaryTelemetry from primaryController.events.record to telemetry.events.record;
                flow recoveryTelemetry from recoveryController.events.record to telemetry.events.record;
                flow primaryLinkStatus from telemetry.status.observation to primaryController.link.observation;
                flow recoveryLinkStatus from telemetry.status.observation to recoveryController.link.observation;
                flow primaryRecordReadback from recordStorage.retained.record to primaryController.retained.record;
                flow recoveryRecordReadback from recordStorage.retained.record to recoveryController.retained.record;
            }
            part ic01 : IC01Candidate {
                ref part configuration : MarineDesign::Design = BlueDog::Configurations::IC01::design;
                ref part integration = BlueDog::Configurations::IC01::integration;
                doc /* Candidate assembly for this named geometry and capability hypothesis.
                 * Configuration references do not qualify installed hardware. */
            }
        }
        private import OOSEM::*;
    }

    package Behavior {

        package Contracts {
            private import ScalarValues::*;
            private import ISQ::*;
            private import ModelingMetadata::refinement;
            doc /* Partial executable consumer contracts for the current Gorge mission.
             * NASA SE Handbook 4.3.1.2.2 and defense SE Guidebook 2026 section 6.2.3
             * inform end-to-end functions/allocation; SysML 2.0 sections 7.17-7.18
             * govern action semantics. Actual outcomes follow the named requirements.
             * No hardware scheduler, synchronized clock or durable storage is inferred. */

            action def AssessObservationUsability {
                in producerValid : Boolean [1];
                in contextApplicable : Boolean [1];
                in clockEstablished : Boolean [1];
                in observedAt : TimeValue [1];
                in now : TimeValue [1];
                in maximumAge : TimeValue [1];
                out usable : Boolean [1];
                first start;
                then action assess {
                    assign usable := BlueDog::Architecture::Interfaces::ObservationUsable(
                        producerValid,contextApplicable,clockEstablished,observedAt,now,maximumAge);
                }
                then done;
            }
            action def SailingActuationGate {
                doc /* Evaluate immediately before dispatch against current observations
                 * and permission, not only at command creation. Boolean applicability
                 * inputs are assessed using the interface contracts; they are not defaults. */
                in commandApplicable : Boolean [1];
                in permissionApplicable : Boolean [1];
                in sailingPermitted : Boolean [1];
                in abortLatched : Boolean [1];
                in qualificationLost : Boolean [1];
                in capsized : Boolean [1];
                in windUsable : Boolean [1];
                in navigationUsable : Boolean [1];
                in requiredSafetyConfirmed : Boolean [1];
                out actuate : Boolean [1];
                first start;
                then action gate {
                    assign actuate := commandApplicable and permissionApplicable and sailingPermitted
                        and not abortLatched and not qualificationLost and not capsized
                        and windUsable and navigationUsable and requiredSafetyConfirmed;
                }
                then done;
            }
            action def RecoveryActuationGate {
                doc /* R-101 inhibits motor thrust while qualifying or status unknown.
                 * E-138 requires durable disqualification before commanded motor enable.
                 * R-102 requires established recovery authorization after restart.
                 * Abort is intentionally not a motor inhibit: recovery follows abort. */
                in recoveryRequested : Boolean [1];
                in commandApplicable : Boolean [1];
                in recoveryAuthorized : Boolean [1];
                in qualificationStateKnown : Boolean [1];
                in qualifying : Boolean [1];
                in disqualificationStored : Boolean [1];
                in recoveryPathAvailable : Boolean [1];
                in inhibitActive : Boolean [1];
                out motorEnable : Boolean [1];
                first start;
                then action gate {
                    assign motorEnable := recoveryRequested and commandApplicable and recoveryAuthorized
                        and qualificationStateKnown and not qualifying and disqualificationStored
                        and recoveryPathAvailable and not inhibitActive;
                }
                then done;
            }
            action def RestoreQualification {
                doc /* Explicit restart assessment, distinct from constructing a new
                 * attempt. E-139/E-145 require nonqualifying fallback for missing or
                 * inconsistent persisted state. A live disqualification cannot be erased
                 * by restoring an older record. Persistence and the 30 s restoration
                 * deadline still need an actual storage/restart implementation. */
                in recordValid : Boolean [1];
                in persistedQualificationLost : Boolean [1];
                in currentQualificationLost : Boolean [1];
                out qualificationLostNext : Boolean [1];
                first start;
                then action restore {
                    assign qualificationLostNext := currentQualificationLost or not recordValid or persistedQualificationLost;
                }
                then done;
            }
            action navigationValidation : AssessObservationUsability;
            action sailingGate : SailingActuationGate;
            action recoveryGate : RecoveryActuationGate;
            action restartQualification : RestoreQualification;
            allocate navigationValidation to BlueDog::Architecture::Logical::vessel.navigation;
            allocate sailingGate to BlueDog::Architecture::Logical::vessel.actuation;
            allocate recoveryGate to BlueDog::Architecture::Logical::vessel.recoveryActuation;
            allocate restartQualification to BlueDog::Architecture::Logical::vessel.supervision;
            #refinement dependency navigationAssessment from AssessObservationUsability to BlueDog::Method::Scenarios::ValidateNavigation;
            #refinement dependency sailingAssessment from SailingActuationGate to BlueDog::Method::Scenarios::ApplySailingCommand;
            #refinement dependency recoveryAssessment from RecoveryActuationGate to BlueDog::Method::Scenarios::ApplyRecoveryCommand;
            dependency motorInvariant from RecoveryActuationGate to BlueDog::Requirements::motorQualificationInvariant;
            dependency durableAuthorization from RecoveryActuationGate to BlueDog::Requirements::qualificationPersistence;
            dependency freshAuthorization from RecoveryActuationGate to BlueDog::Requirements::freshRecoveryCommand;
            dependency restorationPolicy from RestoreQualification to BlueDog::Requirements::qualificationRestoration;
            dependency unknownFallback from RestoreQualification to BlueDog::Requirements::unknownQualificationFallback;
            metadata issue : ModelingMetadata::Issue {
                text = "B-01: Bind installed message contexts to usability, current permissions and consumer gates; scalar conceptual simulations do not implement serialization. B-02: Demonstrate atomic durable state, acknowledgment ordering, all restriction restoration and restart deadlines on selected hardware. B-03: Resolve controller concurrency, command arbitration, resource ownership and timeout budgets, including abort during capsize/recovery. B-04: Implement and measure estimators, achieved actuation and repeated dynamic recovery; descriptive scenarios do not prove these functions.";
            }
        }

        package MissionLogic {
            private import ScalarValues::*;
            private import ModelingMetadata::refinement;

            doc /* Executable supervisory policy for the conceptual mission simulator.
             * Geometry, sensing observations, heading search and vessel dynamics are supplied
             * by the simulator. These actions do not implement a physical autopilot.
             */
            action def HandleEvent {
                in eventKind : String;
                in qualificationLost : Boolean = false;
                out directive : String;
                out capsized : Boolean;
                out recoveryPermitted : Boolean;
                out qualificationLostNext : Boolean;
                first start;
                then action classify {
                    assign directive :=
                        if eventKind == "operator_intervention" or eventKind == "manual_weather_update" or eventKind == "motor_use" ? "disqualify"
                        else if eventKind == "communications_loss" ? "communications_outage"
                        else if eventKind == "weather_service_loss" ? "retain_forecast"
                        else if eventKind == "wind_sensor_loss" ? "wind_outage"
                        else if eventKind == "navigation_loss" ? "navigation_outage"
                        else if eventKind == "capsize" or eventKind == "unassisted_righting" ? "assess_capsize"
                        else if eventKind == "forecast_invalidated" or eventKind == "sensing_loss" or eventKind == "steering_loss" or eventKind == "power_loss" or eventKind == "safety_capability_loss" or eventKind == "refuge_entry" or eventKind == "grounding" or eventKind == "anchoring" or eventKind == "shore_attachment" ? "abort"
                        else if eventKind == "terminal_failure" ? "stop"
                        else "unsupported";
                    assign capsized := eventKind == "capsize";
                    assign recoveryPermitted := eventKind == "sensing_loss" or eventKind == "forecast_invalidated" or eventKind == "safety_capability_loss" or eventKind == "capsize";
                    assign qualificationLostNext := qualificationLost or directive == "disqualify" or directive == "abort";
                }
                then done;
            }

            action def CapsizeDisposition {
                doc /* Explicit observation contract, not a righting dynamics prediction.
                 * Safety must remain available while inverted. Resumption additionally
                 * requires observed unassisted upright recovery and restored control.
                 * Missing safety evidence fails closed; a prior abort cannot be cleared. */
                in currentlyCapsized : Boolean;
                in uprightRecoveryObserved : Boolean;
                in requiredSafetyConfirmed : Boolean;
                in abortLatched : Boolean;
                in qualificationLost : Boolean = false;
                out directive : String;
                out qualificationLostNext : Boolean;
                first start;
                then action assess {
                    assign directive := if abortLatched or qualificationLost or not requiredSafetyConfirmed ? "abort"
                        else if uprightRecoveryObserved and not currentlyCapsized ? "invalid_observation"
                        else if uprightRecoveryObserved ? "resume"
                        else "await_righting";
                    assign qualificationLostNext := qualificationLost or abortLatched or not requiredSafetyConfirmed;
                }
                then done;
            }
            dependency capsizeQualification from CapsizeDisposition to BlueDog::Requirements::capsizeQualificationRetention;
            #refinement dependency capsizeScenarioPolicy from CapsizeDisposition to BlueDog::Method::Scenarios::AssessCapsizeContinuation;

            action def SupervisoryCycle {
                doc /* A nominal upright cycle assumes valid observations supplied by its caller.
                 * Inversion or invalid primary navigation requires explicit confirmation of
                 * retained safety capability. Qualification and safety abort are distinct
                 * persistent states: intervention ends qualification even without a casualty.
                 * The caller supplies geometry and energy assessments; this action owns the
                 * response permissions. It does not predict righting or verify hardware. */
                in windValid : Boolean;
                in navigationValid : Boolean = true;
                in capsized : Boolean = false;
                in requiredSafetyConfirmed : Boolean;
                in reserveThreatened : Boolean = false;
                in trafficConflict : Boolean;
                in abortRequested : Boolean;
                in abortLatched : Boolean;
                in qualificationLost : Boolean = false;
                in communicationsAvailable : Boolean;
                out abortLatchedNext : Boolean;
                out qualificationLostNext : Boolean;
                out sailingPermitted : Boolean;
                out gateScoringPermitted : Boolean;
                out harvestPermitted : Boolean;
                out mode : String;
                out alert : String;
                first start;
                then action chooseMode {
                    assign abortLatchedNext := abortLatched or abortRequested or reserveThreatened or not requiredSafetyConfirmed;
                    assign qualificationLostNext := qualificationLost or abortLatchedNext;
                    assign sailingPermitted := windValid and navigationValid and not capsized and not qualificationLostNext;
                    assign gateScoringPermitted := navigationValid and not capsized and not qualificationLostNext;
                    assign harvestPermitted := not capsized;
                    assign mode := if abortLatchedNext ? "abort_recovery"
                        else if qualificationLostNext ? "disqualified"
                        else if capsized ? "capsized_drift"
                        else if not navigationValid ? "navigation_degraded"
                        else if not windValid ? "degraded_drift"
                        else if trafficConflict ? "traffic_avoidance"
                        else "sailing";
                    assign alert := if not abortLatchedNext or abortLatched ? "none"
                        else if communicationsAvailable ? "attempt" else "queue";
                }
                then done;
            }

            action def RecoveryAuthority {
                in eventKind : String;
                in ordinaryPermission : Boolean;
                in independentPath : Boolean;
                out permitted : Boolean;
                first start;
                then action chooseAuthority {
                    assign permitted := ordinaryPermission or (independentPath and (eventKind == "steering_loss" or eventKind == "power_loss"));
                }
                then done;
            }
            action def FallbackPolicy {
                in recoveryAvailable : Boolean;
                in recoveryPermitted : Boolean;
                out attemptRecovery : Boolean;
                out continueDrift : Boolean;
                first start;
                then action chooseFallback {
                    assign attemptRecovery := recoveryAvailable and recoveryPermitted;
                    assign continueDrift := not (recoveryAvailable and recoveryPermitted);
                }
                then done;
            }
            dependency fallbackBasis from FallbackPolicy to BlueDog::Mission::Challenge::autonomousShoreRecovery;

            dependency unassisted from HandleEvent to BlueDog::Mission::Challenge::unassistedAttempt;
            dependency propulsion from HandleEvent to BlueDog::Mission::Challenge::sailingPropulsion;
            dependency safeRecovery from SupervisoryCycle to BlueDog::Mission::Challenge::autonomousShoreRecovery;
            dependency normalScenario from SupervisoryCycle to BlueDog::Method::Scenarios::NormalSailing;
            dependency trafficScenario from SupervisoryCycle to BlueDog::Method::Scenarios::TrafficEncounter;
            dependency recoveryScenario from SupervisoryCycle to BlueDog::Method::Scenarios::AbortAndRecover;
            action supervisor : SupervisoryCycle;
            action capsizeDisposition : CapsizeDisposition;
            action recoveryAuthority : RecoveryAuthority;
            action fallback : FallbackPolicy;
            allocate recoveryAuthority to BlueDog::Architecture::Logical::vessel.recovery;
            allocate fallback to BlueDog::Architecture::Logical::vessel.recovery;
            dependency recoveryAuthorityScenario from RecoveryAuthority to BlueDog::Method::Scenarios::AbortAndRecover;
            dependency fallbackScenario from FallbackPolicy to BlueDog::Method::Scenarios::AbortAndRecover;
            allocate supervisor to BlueDog::Architecture::Logical::vessel.supervision;
            allocate capsizeDisposition to BlueDog::Architecture::Logical::vessel.supervision;
        }

        package Navigation { doc /* Mission integration policy for supplied Inland pair assessments. Numerical thresholds below are engineering hypotheses, not statutory interpretations or physically validated limits.*/ private import ScalarValues::*; part context;
            analysis def Policy {
                subject encounter;
                out attribute headingToleranceDeg : Real = 2.0;
                out attribute speedToleranceMps : Real = 0.05;
                out attribute substantialTurnDeg : Real = 15.0;
                out attribute bearingUncertaintyDeg : Real = 10.0;
                out attribute clearanceReleaseMultiplier : Real = 2.0;
            }
            analysis def Candidate {
                doc /* Filters a geometrically feasible proposal using the native pair response. Hold-course/speed tolerances and substantial-turn threshold are declared hypotheses. No supported candidate causes a navigation abort, not an inferred lawful emergency departure. Recovery is separately unassessed.*/
                subject encounter;
                in attribute relevant : Boolean;
                in attribute supported : Boolean;
                in attribute candidateClear : Boolean;
                in attribute heldClear : Boolean;
                in attribute holdsCourseSpeed : Boolean;
                in attribute substantialChange : Boolean;
                in attribute missingTrackedDuty : Boolean;
                in attribute response : String;
                out attribute allowed : Boolean = not missingTrackedDuty and (if not relevant ? true else supported and candidateClear and (continuationSupported or (if response == "holdCourseSpeed" ? holdsCourseSpeed else if response == "mayAct" ? holdsCourseSpeed or substantialChange else if response == "keepClear" or response == "shallAct" ? (heldClear and holdsCourseSpeed) or substantialChange else response == "monitor")));
                out attribute completeComplianceEstablished : Boolean = false;
                in attribute continuationSupported : Boolean;
            }
            analysis def Geometry {
                doc /* Geometry-to-assessed-fact hypotheses. Past-and-clear requires an observed opening track beyond twice the protected envelope and no forecast conflict. Track loss never meets this condition. Substantial action here only recognizes a heading change; speed-only maneuvers need a separate validated criterion.*/
                subject encounter;
                in attribute rangeM : Real;
                in attribute closingMps : Real;
                in attribute protectedRadiusM : Real;
                in attribute releaseMultiplier : Real;
                in attribute headingChangeDeg : Real;
                in attribute speedChangeMps : Real;
                in attribute headingToleranceDeg : Real;
                in attribute speedToleranceMps : Real;
                in attribute substantialTurnDeg : Real;
                in attribute heldConflict : Boolean;
                in attribute headingKnown : Boolean;
                in attribute trackAdequate : Boolean;
                out attribute pastAndClear : Boolean = trackAdequate and not heldConflict and closingMps < 0 and rangeM > protectedRadiusM * releaseMultiplier;
                out attribute holdsCourseSpeed : Boolean = headingKnown and headingChangeDeg <= headingToleranceDeg and speedChangeMps <= speedToleranceMps;
                out attribute substantialChange : Boolean = headingKnown and headingChangeDeg >= substantialTurnDeg;
            }
            analysis def Context {
                doc /* This controller integration is restricted to the assessed synthetic clear-visibility, non-channel context. Other contexts require a separate controller implementation, even without observed traffic. This scope gate is not a general legal prohibition.*/
                subject encounter;
                in attribute inlandProfile : String;
                in attribute channelContext : String;
                in attribute restrictedVisibility : String;
                in attribute specialCircumstances : String;
                out attribute supported : Boolean = inlandProfile == "yes" and channelContext == "no" and restrictedVisibility == "no" and specialCircumstances == "no";
            }
        }
    }

    package Analyses {

        package AerodynamicPolicy {
            private import ScalarValues::*;
            part sizing {
                doc /* Engineering assumptions for a restricted, attached-flow sizing case.
                 * These are not measured confidence bounds or a demonstrated stall boundary.
                 * Published crescent-wing tests establish method relevance, but their section,
                 * Reynolds number and setup do not validate this CAD geometry. */
                attribute incidenceLowDeg : Real = -4;
                attribute incidenceHighDeg : Real = 8;
                attribute heelLimitDeg : Real = 20;
                attribute profileCd : Real = 0.04;
                attribute clLimit : Real = 0.9;
                attribute liftScale : Real = 0.7;
                attribute dragScale : Real = 1.4;
                attribute momentScale : Real = 1.4;
                metadata rationale : ModelingMetadata::Rationale { text = "Use the former adverse aerodynamic case for primary sizing. Restrict nominal incidence and heel to reduce reliance on separated flow and large spanwise inflow. The observed heel sensitivity motivates additional conservatism, not a universal calibrated correction. Moment uncertainty is independent of reduced lift credit so lower propulsion credit does not automatically reduce predicted actuator demand. All geometry variables remain free within their existing model brackets."; }
                metadata issue : ModelingMetadata::Issue { text = "Matched low-Re forward/reverse section measurements, measured pitching moments, finite-thickness effects, and heel-dependent full-grid validation remain missing. The retained cosine projection and uncertainty factors are provisional. A feasible solve establishes only feasibility under these assumptions."; }
            }
            part stress {
                attribute profileCd : Real = 0.06;
                attribute clLimit : Real = 0.8;
                attribute liftScale : Real = 0.55;
                attribute dragScale : Real = 1.6;
                metadata rationale : ModelingMetadata::Rationale { text = "An additional uncalibrated adverse hypothesis, not a probability distribution or a validated worst case. Re-solve controls at the selected geometry to expose remaining sensitivity."; }
            }
            analysis convergenceInputs {
                out attribute aspect : Real = 4;
                out attribute camber : Real = 1;
                out attribute meshes : Integer [3] ordered = (24,48,72);
                out attribute wakeIterations : Integer [3] ordered = (5,15,30);
                out attribute absoluteTolerance : Real [3] ordered = (0.03,0.01,0.02);
                doc /* Compare CL, induced CD and CMy over nominal incidence -4..8 degrees.
                 * Crossed mesh/wake checks on both chord directions. Engineering numerical
                 * screening tolerances only; passing does not establish physical validity. */
            }
            dependency supports from sizing to BlueDog::Requirements::cruiseEvidence;
            dependency evidence from sizing to BlueDog::Analyses::WingHeel::sweepInputs;
            dependency literature from sizing to BlueDog::Evidence::Sources::sail4;
            dependency actuator from sizing to BlueDog::Requirements::sustainedEnergyFeasibility;
        }

        package AnalysisCredibility {
            private import ScalarValues::*;
            metadata def UseIntent {
                attribute category : String;
                attribute intendedUse : String;
                attribute domain : String;
                attribute excludedUses : String;
                attribute evidenceNeeded : String;
            }
            metadata def Inputs :> UseIntent {
                attribute :>> category = "Inputs";
                attribute :>> intendedUse = "Export declared parameters or provisional sensitivity assumptions for an identified caller.";
                attribute :>> domain = "The owning configuration and consumer units/vector ordering; these cases export inputs, not predicted performance.";
                attribute :>> excludedUses = "No feasibility, measured uncertainty distribution or physical capability follows from exporting values.";
                attribute :>> evidenceNeeded = "Trace each value to its owner, external-data pedigree and consuming analysis; verify conversions.";
            }
            metadata def HistoricalReview :> UseIntent {
                attribute :>> category = "HistoricalReview";
                attribute :>> intendedUse = "Inspect recorded operating screens and unaccepted evidence for the original archived candidate.";
                attribute :>> domain = "Only the original run configuration, policy, source revision and sampled scenarios.";
                attribute :>> excludedUses = "No current IC-01 design substitution, physical qualification or transfer of margins between configurations.";
                attribute :>> evidenceNeeded = "Preserve archive manifests and source hashes; assess new use separately against current configuration and policy.";
            }
            metadata def Rules :> UseIntent {
                attribute :>> category = "Rules";
                attribute :>> intendedUse = "Evaluate navigation-rule obligations or fixture consistency from supplied situation facts.";
                attribute :>> domain = "Declared rule edition, delivered tracks, vessel/status/visibility/channel facts and bounded encounter context.";
                attribute :>> excludedUses = "Supplied facts do not demonstrate perception, legal status or achieved safe maneuver; no universal compliance claim.";
                attribute :>> evidenceNeeded = "Validate actual fact acquisition, rule applicability and full encounter behavior against authoritative rules and observations.";
            }
            metadata def Readiness :> UseIntent {
                attribute :>> category = "Readiness";
                attribute :>> intendedUse = "Expose missing review/evidence preconditions in the named safety or configuration argument.";
                attribute :>> domain = "Declared review scope, configuration, contributors and supplied review assertions.";
                attribute :>> excludedUses = "A true review flag or complete register does not demonstrate control effectiveness, install hardware or accept risk.";
                attribute :>> evidenceNeeded = "Actual configuration, implementation/effectiveness records, coverage review and responsible disposition evidence.";
            }
            metadata def Trade :> UseIntent {
                attribute :>> category = "Trade";
                attribute :>> intendedUse = "Compare declared rig evidence gates or illustrate a supporting buoyancy calculation.";
                attribute :>> domain = "The named candidate and ordered evidence vector, or explicit synthetic buoyancy inputs.";
                attribute :>> excludedUses = "No invented scores, hardware downselect, accepted reliability estimate or physical qualification.";
                attribute :>> evidenceNeeded = "Comparable both-tack, energy, durability, construction, casualty and reliability-study evidence; separate mandatory criteria from studies.";
            }
            metadata def Recovery :> UseIntent {
                attribute :>> category = "Recovery";
                attribute :>> intendedUse = "Screen conditional recovery authority, exposure or energy for supplied capabilities and route.";
                attribute :>> domain = "Named configuration, current, orientation, usable reserve, approach and response assumptions.";
                attribute :>> excludedUses = "No demonstrated thrust, whole-river recoverability, physical independence, shore retention or pickup.";
                attribute :>> evidenceNeeded = "Measured installed propulsion/energy and casualty-response envelopes; route and approach evidence with uncertainty.";
            }
            metadata def Sailing :> UseIntent {
                attribute :>> category = "Sailing";
                attribute :>> intendedUse = "Estimate polar demand, conditional progress or hull/route screens under declared inputs.";
                attribute :>> domain = "Supplied polar/geometry, current, wind, leeway and bounded route assumptions.";
                attribute :>> excludedUses = "Demand ratios and solved states do not predict a measured voyage or establish performance outside the studied envelope.";
                attribute :>> evidenceNeeded = "Both-tack measured polar and mass/drag evidence; discretization, convergence and environment-domain sensitivity.";
            }
            metadata def Equipment :> UseIntent {
                attribute :>> category = "Equipment";
                attribute :>> intendedUse = "Account for candidate equipment allocations or illustrative actuator/energy loads.";
                attribute :>> domain = "Declared included/excluded components, duty assumptions, modes and accounting boundary.";
                attribute :>> excludedUses = "An allowance or arithmetic rollup is not a measured installed budget, peak capability or architecture downselect.";
                attribute :>> evidenceNeeded = "Identified component/BOM and synchronized mass, peak/average power, duty and environmental measurements.";
            }
            metadata def Encounter :> UseIntent {
                attribute :>> category = "Encounter";
                attribute :>> intendedUse = "Screen class detection, acquisition or response-distance/exposure from supplied bounds.";
                attribute :>> domain = "Specified target/class, timing, uncertainty, controller state and envelope assumptions.";
                attribute :>> excludedUses = "Allocated observation or response bounds are not demonstrated sensing coverage, maneuver completion or accepted safety margins.";
                attribute :>> evidenceNeeded = "Installed target-class detection/error/dropout and timing evidence including interacting faults and occupied maneuvers.";
            }
            metadata def Weather :> UseIntent {
                attribute :>> category = "Weather";
                attribute :>> intendedUse = "Explore environmental or passage-exposure sensitivity with declared scenario values.";
                attribute :>> domain = "Named wind/current/wave/weather assumptions, geometry and sampled domain.";
                attribute :>> excludedUses = "Scenario sweeps are not calibrated probability distributions, full-domain coverage or voyage reliability evidence.";
                attribute :>> evidenceNeeded = "Observed environmental basis, dependence and coverage review; uncertainty and sensitivity for the proposed use.";
            }
            metadata def EnergyReliability :> UseIntent {
                attribute :>> category = "EnergyReliability";
                attribute :>> intendedUse = "Evaluate conditional energy reconciliation or mission-reliability arithmetic for the named subject.";
                attribute :>> domain = "Declared load/exposure/storage boundaries or failure-rate partition, dependence and hazard assumptions.";
                attribute :>> excludedUses = "Numerical success does not establish measured load, accepted rates, independence or physical reliability/energy sufficiency.";
                attribute :>> evidenceNeeded = "Configuration-specific measurements, rate/profile justification, common-cause/dependence review and uncertainty assessment.";
            }
            metadata def Geometry :> UseIntent {
                attribute :>> category = "Geometry";
                attribute :>> intendedUse = "Inspect a geometric/course or analytic hydrostatic fixture.";
                attribute :>> domain = "Declared coordinate/geometry conventions and simplified analytic assumptions.";
                attribute :>> excludedUses = "A consistent fixture is not surveyed course truth, validated free-surface response or installed-vessel performance.";
                attribute :>> evidenceNeeded = "Independent coordinate/unit checks, geometry survey or hydrostatic comparison relevant to the proposed use.";
            }
