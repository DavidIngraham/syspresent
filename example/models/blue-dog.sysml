package BlueDog {
    doc /* Blue Dog is a small autonomous sailboat for the Columbia River. Its first mission is one Bingen-Stevenson-Bingen round trip using sail power and onboard control, with live monitoring from shore. The boat must detect traffic, protect its recovery energy and return to a suitable retrieval location after an abort. Later goals include repeated river circuits and a voyage toward Hawaii. The design is under development; equipment selection and physical testing remain open.*/

    package Mission {
            action def HawaiiMission {
                doc /* Plan the voyage, launch, sail toward Hawaii, approach the destination and recover the boat and its records. Energy management, health monitoring and communications support the passage. The route, arrival criteria, endurance and recovery plan still need to be defined.*/
                action prepareAndLaunch;
                action sailOceanPassage;
                action approachDestination;
                action recoverBoatAndData;
                action manageEnergy;
                action monitorHealthAndRecover;
                action communicateWithOperator;
                action recordMissionData;
            }
            action def TransGorgeMission {
                doc /* Prepare and launch at Bingen, sail to the buoy 16 rounding near Stevenson, return through the Bingen finish gate, and retrieve the boat and its records. Throughout the circuit, manage energy, monitor hazards and health, communicate with shore and record progress. Qualification requires onboard control without operator intervention. The course, operating conditions and recovery sites require review before launch; completion has no time limit.*/
                action prepareAndLaunch;
                action sailOutbound;
                action turnAround;
                action sailHome;
                action recoverBoatAndData;
                action manageEnergy;
                action monitorHealthAndRecover;
                action communicateWithOperator;
                action recordMissionData;
            }
            action def SwellMonitoringMission {
                doc /* A possible later mission would send the boat to an observation area, collect wind and wave measurements, and return for retrieval. The area, measurement products and accuracy remain to be chosen.*/
                action reachObservationArea;
                action maintainObservationArea;
                action measureAndRecordConditions;
                action returnForRecovery;
            }

        package Challenge {
            doc /* Independent trans-gorge autonomous sailing challenge.
             * Inspired by the structure of the Microtransat rules:
             * https://microtransat.org/content.php?p=rules&top=rules
             * This is a separate project challenge, not a Microtransat entry or endorsement.
             * Vessel architecture and communications technology are unrestricted; overall length is limited to 1.2 m.
             * The Gorge is the proving ground for a longer-term voyage toward Hawaii.
             * Marker-referenced virtual gates are defined in BlueDog::Mission::Course.
             * There is no completion deadline. The vehicle defines candidate environmental qualification profiles; no dam passage is permitted.
             */
            private import RequirementDerivation::*;
            private import ISQ::*;
            private import SI::*;
            attribute maximumOverallLength : LengthValue = 1.2 [m];
            requirement def <'C-000'> TransGorgeChallenge {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                doc /* The vessel shall autonomously sail one round trip from Bingen, around buoy 16 near Stevenson, and back to Bingen.*/
                metadata rationale : ModelingMetadata::Rationale { text = "One Bingen–Stevenson–Bingen circuit defines the finite challenge. Repeated circuits are a separate future endurance objective."; }
                comment conditions /* Qualification requires C-001, C-003 through C-010 and C-012 through C-027 to be met for the same attempt. These cover the course, onboard control, sail propulsion, monitoring, safety, recovery and vessel constraints. Repeated circuits under C-002 are a future objective. The course gates require review before launch; there is no completion deadline.*/
            }
            requirement transGorgeChallenge : TransGorgeChallenge;
            requirement def <'C-001'> CourseCompletion {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                doc /* The vessel shall cross the Bingen departure gate, the buoy 16 rounding checkpoints and the Bingen finish gate in that order during one attempt.*/
                comment conditions /* BlueDog::Mission::Course defines nominal marker references and directed finite gate segments. Completion has no elapsed-time deadline. Position history must demonstrate crossings; touching a gate line alone does not count. */
                metadata issue : ModelingMetadata::Issue { text = "The marker-based gate proposal remains subject to the course safety review before launch; route corridor and current notice exclusions must accompany the accepted configuration."; }
            }
            requirement def <'C-002'> RepeatedOperation {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                doc /* After its first circuit, the vessel should repeat Bingen–Stevenson–Bingen autonomously for as long as practical. */
                comment notes /* Future endurance objective, excluded from finite challenge acceptance. */
                metadata issue : ModelingMetadata::Issue { text = "No fixed objective endurance duration has been selected."; }
            }
            requirement def <'C-003'> UnassistedAttempt {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                doc /* A qualifying attempt shall complete the round trip without operator intervention. */
                comment conditions /* Passive live monitoring and autonomous polling of weather services are permitted. Any operator-supplied update, remote emergency abort or manual control ends qualification. Weather data must be obtained by the system without manual operator submission. */
                comment restartConditions /* After intervention, a new qualifying attempt begins only with a new downstream crossing of the departure gate. Previous partial progress does not transfer. */
            }
            requirement def <'C-004'> SailingPropulsion {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                doc /* A qualifying attempt shall use sailing propulsion without auxiliary motor propulsion. */
                comment conditions /* An auxiliary motor may remain installed. Motor use is permitted during separate development tests and vessel recovery; use during an attempt ends its qualification. */
                comment notes /* The restriction concerns propulsion, not onboard electrical power. */
            }
            requirement def <'C-005'> LiveObservation {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                doc /* The vessel shall deliver position, operating mode and health updates at intervals no greater than 30 seconds while the monitoring link is available. */
                comment conditions /* C-020 governs autonomous continuation, retention and telemetry replay during monitoring-link outages. */
                metadata issue : ModelingMetadata::Issue { text = "LTE-M-class throughput is a provisional vehicle design assumption, not a mandated challenge technology. End-to-end delivery qualification and stale-data presentation are allocated to the vehicle."; }
            }
            requirement def <'C-006'> EmergencyIntervention {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                doc /* The vessel shall permit remote emergency abort or manual control when a command link is available. */
                comment conditions /* Use disqualifies the attempt as unassisted. */
                metadata issue : ModelingMetadata::Issue { text = "Owner-approved policy: autonomous safety abort does not wait for operator contact. Recovery may use motor propulsion; operator-directed relocation or motor-sailing after abort never restores qualification."; }
            }
            requirement courseCompletion : CourseCompletion;
            requirement repeatedOperation : RepeatedOperation;
            requirement unassistedAttempt : UnassistedAttempt;
            requirement sailingPropulsion : SailingPropulsion;
            requirement liveObservation : LiveObservation;
            requirement emergencyIntervention : EmergencyIntervention;
            requirement def <'C-007'> NavigationRules {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                doc /* The vessel shall comply with the U.S. Inland Navigation Rules (33 CFR parts 83 through 90) and applicable local navigation provisions throughout the attempt on the approved Gorge course.*/
                comment conditions /* Evaluate the actual encounter and visibility conditions, including lookout, collision-risk assessment, avoidance action, safe speed, overtaking, sailing encounters and narrow-channel obligations. A safety action takes precedence over preserving attempt qualification. */
                metadata rationale : ModelingMetadata::Rationale { text = "USCG Navigation Rules: https://www.navcen.uscg.gov/navigation-rules-amalgamated . Detailed encounter cases and quantitative acceptance allocations belong to the vehicle analysis, not the independent challenge. Small size and sail propulsion do not exempt the vessel from collision avoidance or channel non-impediment."; }
                comment processResponsibilities /* C-028 identifies entrant applicability review; C-029 controls the organizer rule and notice baseline; C-030 governs entry evidence; C-031 identifies operator safety intervention; C-032 governs adjudication. These preserve the C-007 entry and qualification policy. */
                comment complianceSources /* Governing source: https://www.ecfr.gov/current/title-33/chapter-I/subchapter-E . Applicability: https://www.ecfr.gov/current/title-33/chapter-I/subchapter-E/part-83/subpart-A/section-83.01 . Source-linked verification cases in BlueDog::Verification::Challenge cover applicability, lookout/avoidance, encounter conduct, channel/visibility and signals. Their verdicts remain inconclusive pending accepted evidence; traceability is not a compliance finding.*/
            }
            requirement def <'C-008'> RestrictedWaters {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                doc /* The vessel shall remain outside waters prohibited to the attempt configuration. */
                comment conditions /* Include dam restricted areas, lock approaches excluded by the challenge, and applicable temporary safety/security zones or closures. Use the chart and notice set applicable to the attempt. */
                metadata rationale : ModelingMetadata::Rationale { text = "33 CFR 207.718 defines site-specific dam restrictions and lock-approach authority: https://www.ecfr.gov/current/title-33/chapter-II/part-207/section-207.718 . The course stays between the dams and requires no lock passage. Do not replace mapped restrictions with an invented universal stand-off radius."; }
            }
            requirement def <'C-009'> TrafficCoexistence {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                doc /* The vessel shall complete the course without collision with other waterway users. */
                comment conditions /* The operating context includes commercial tows, passenger vessels, fishing craft, recreational powerboats, sailing vessels and people in the water. Channel non-impediment and encounter conduct remain independently required by C-007. The vehicle analysis defines representative and adverse traffic scenarios and assesses maneuver feasibility. */
                metadata rationale : ModelingMetadata::Rationale { text = "The course is shared water, not a closed test range. Typical traffic and uncertainty in other users' behavior are part of mission validation; AIS absence is not evidence of clear water. Numeric separation allocations must be justified by encounter geometry and vessel performance."; }
            }
            requirement navigationRules : NavigationRules;
            requirement restrictedWaters : RestrictedWaters;
            requirement trafficCoexistence : TrafficCoexistence;
            #derivation connection challengeNavigationRules {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                metadata rationale : ModelingMetadata::Rationale { text = "C-000 includes this obligation independently of course progress or elapsed time."; }
                end #original source ::> transGorgeChallenge;
                end #derive target ::> navigationRules;
            }
            #derivation connection challengeRestrictedWaters {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                metadata rationale : ModelingMetadata::Rationale { text = "C-000 includes this obligation independently of course progress or elapsed time."; }
                end #original source ::> transGorgeChallenge;
                end #derive target ::> restrictedWaters;
            }
            #derivation connection challengeTrafficCoexistence {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                metadata rationale : ModelingMetadata::Rationale { text = "C-000 includes this obligation independently of course progress or elapsed time."; }
                end #original source ::> transGorgeChallenge;
                end #derive target ::> trafficCoexistence;
            }
            #derivation connection challengeRuleCourseCompletion {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                metadata rationale : ModelingMetadata::Rationale { text = "This rule is explicitly included in C-000; C-002 retains its objective-only status."; }
                end #original source ::> transGorgeChallenge;
                end #derive target ::> courseCompletion;
            }
            dependency futureEnduranceBasis from repeatedOperation to courseCompletion {
                metadata rationale : ModelingMetadata::Rationale { text = "Future repeated operation uses the same ordered course geometry. This design dependency does not impose repeating endurance on the current finite qualification mission."; }
            }
            #derivation connection challengeRuleUnassistedAttempt {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                metadata rationale : ModelingMetadata::Rationale { text = "This rule is explicitly included in C-000; C-002 retains its objective-only status."; }
                end #original source ::> transGorgeChallenge;
                end #derive target ::> unassistedAttempt;
            }
            #derivation connection challengeRuleSailingPropulsion {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                metadata rationale : ModelingMetadata::Rationale { text = "This rule is explicitly included in C-000; C-002 retains its objective-only status."; }
                end #original source ::> transGorgeChallenge;
                end #derive target ::> sailingPropulsion;
            }
            #derivation connection challengeRuleLiveObservation {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                metadata rationale : ModelingMetadata::Rationale { text = "This rule is explicitly included in C-000; C-002 retains its objective-only status."; }
                end #original source ::> transGorgeChallenge;
                end #derive target ::> liveObservation;
            }
            #derivation connection challengeRuleEmergencyIntervention {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                metadata rationale : ModelingMetadata::Rationale { text = "This rule is explicitly included in C-000; C-002 retains its objective-only status."; }
                end #original source ::> transGorgeChallenge;
                end #derive target ::> emergencyIntervention;
            }
            requirement def <'C-010'> OverallLength {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                doc /* The vessel overall length shall not exceed 1.2 m. */
                attribute measuredOverallLength : LengthValue;
                require constraint lengthLimit { measuredOverallLength > 0 [m] and measuredOverallLength <= maximumOverallLength }
                comment conditions /* Measure maximum fore-and-aft extent, including rudders, rig projections, antennas and other equipment, across normal operating configurations. Hull arrangement is unrestricted. */
                metadata rationale : ModelingMetadata::Rationale { text = "Half the Microtransat 2.4 m overall-length entry limit; owner-selected challenge constraint."; }
            }
            requirement overallLength : OverallLength;
            #derivation connection deriveOverallLength {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                end #original source ::> transGorgeChallenge;
                end #derive target ::> overallLength;
            }
            requirement def <'C-012'> SafetyCapabilityAbort {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                doc /* The vessel shall autonomously terminate qualification when a required safety capability is lost. */
                comment conditions /* A demonstrated backup preserving the function permits continuation. Darkness alone is not a fault. Fog triggers this rule when it compromises required capability. */
                metadata rationale : ModelingMetadata::Rationale { text = "Abort is based on capability, not individual component failure."; }
            }
            requirement safetyCapabilityAbort : SafetyCapabilityAbort;
            #derivation connection deriveSafetyCapabilityAbort {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                end #original source ::> transGorgeChallenge;
                end #derive target ::> safetyCapabilityAbort;
            }
            requirement def <'C-013'> AutonomousShoreRecovery {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                doc /* Following a safety abort, the vessel shall autonomously initiate recovery toward a suitable shore-accessible retrieval location. */
                comment conditions /* Do not wait for operator intervention or communications. Select a viable route based on remaining capabilities. Intentional grounding at a suitable accessible shore is permitted. */
                metadata rationale : ModelingMetadata::Rationale { text = "Owner-selected recovery policy; residual risk of movement after traffic-sensing failure requires explicit analysis and review, not assumed acceptance."; }
            }
            requirement autonomousShoreRecovery : AutonomousShoreRecovery;
            #derivation connection deriveAutonomousShoreRecovery {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                end #original source ::> transGorgeChallenge;
                end #derive target ::> autonomousShoreRecovery;
            }
            requirement def <'C-014'> AbortAlert {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                doc /* The vessel shall attempt immediate transmission of an abort alert when an abort is declared. */
                comment conditions /* Queue the alert while communications are unavailable and transmit when contact returns. */
                metadata rationale : ModelingMetadata::Rationale { text = "Operator awareness supports shore retrieval without being a prerequisite for recovery."; }
            }
            requirement abortAlert : AbortAlert;
            #derivation connection deriveAbortAlert {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                end #original source ::> transGorgeChallenge;
                end #derive target ::> abortAlert;
            }
            requirement def <'C-015'> NoLittering {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                doc /* The vessel shall support recovery without abandonment of the vessel or its major components in the waterway. */
                comment conditions /* Apply flotation, retention and post-capsize recovery obligations C-016 through C-018. */
                metadata rationale : ModelingMetadata::Rationale { text = "Owner intent: no littering. This is a recoverability obligation, not a guarantee against every conceivable casualty."; }
            }
            requirement noLittering : NoLittering;
            #derivation connection deriveNoLittering {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                end #original source ::> transGorgeChallenge;
                end #derive target ::> noLittering;
            }
            requirement def <'C-016'> CasualtyFlotation {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                doc /* The vessel shall remain afloat following capsize or hull flooding. */
                comment conditions /* Demonstrate in the declared casualty qualification conditions for the interval needed to execute shore recovery. */
                metadata rationale : ModelingMetadata::Rationale { text = "Derived from recoverability; casualty definition and exposure allocations require SRR review."; }
            }
            requirement casualtyFlotation : CasualtyFlotation;
            #derivation connection deriveCasualtyFlotation {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                end #original source ::> noLittering;
                end #derive target ::> casualtyFlotation;
            }
            requirement def <'C-017'> MajorComponentRetention {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                doc /* The vessel shall retain its rig, ballast and battery following capsize or hull flooding. */
                comment conditions /* Use the same casualty qualification conditions as C-016. */
                metadata rationale : ModelingMetadata::Rationale { text = "Retained major components prevent debris and support retrieval."; }
            }
            requirement majorComponentRetention : MajorComponentRetention;
            #derivation connection deriveMajorComponentRetention {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                end #original source ::> noLittering;
                end #derive target ::> majorComponentRetention;
            }
            requirement def <'C-018'> CapsizeRecovery {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                doc /* The vessel shall demonstrate autonomous travel to a suitable shore retrieval location following capsize without communications. */
                comment conditions /* Self-righting is not prescribed; inverted recovery is permitted. Auxiliary propulsion ends qualification. Demonstrate against declared course recovery conditions. */
                metadata rationale : ModelingMetadata::Rationale { text = "Limp recovery is the required outcome; hull architecture remains open."; }
            }
            requirement capsizeRecovery : CapsizeRecovery;
            #derivation connection deriveCapsizeRecovery {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                end #original source ::> noLittering;
                end #derive target ::> capsizeRecovery;
            }
            requirement def <'C-019'> UnattachedPassage {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                doc /* A qualifying attempt shall remain afloat and unattached throughout the scored passage. */
                comment conditions /* Grounding, anchoring, attaching to shore or entering designated refuge ends qualification. Safe waiting under sail is permitted and counts toward elapsed exposure. */
                metadata rationale : ModelingMetadata::Rationale { text = "Refuge does not preserve partial qualifying progress."; }
            }
            requirement unattachedPassage : UnattachedPassage;
            #derivation connection deriveUnattachedPassage {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                end #original source ::> transGorgeChallenge;
                end #derive target ::> unattachedPassage;
            }
            requirement def <'C-020'> OutageAutonomy {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                doc /* Loss of communications alone shall not terminate an otherwise safe qualifying attempt. */
                comment conditions /* Continue navigation and retain telemetry onboard; replay retained data after reconnection. */
                metadata rationale : ModelingMetadata::Rationale { text = "Onboard safety and recovery do not depend on contact."; }
            }
            requirement communicationOutageAutonomy : OutageAutonomy;
            #derivation connection deriveOutageAutonomy {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                end #original source ::> transGorgeChallenge;
                end #derive target ::> communicationOutageAutonomy;
            }
            requirement def <'C-021'> ForecastAdmission {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                doc /* Launch authorization shall require a forecast window assessed to support the complete round trip with waiting and recovery margins. */
                comment conditions /* Use the declared mission configuration and forecast-conditioned scenarios. No fixed completion deadline applies. */
                metadata rationale : ModelingMetadata::Rationale { text = "Whole-mission assessment replaces an arbitrary sailing-speed floor."; }
            }
            requirement forecastAdmission : ForecastAdmission;
            #derivation connection deriveForecastAdmission {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                end #original source ::> transGorgeChallenge;
                end #derive target ::> forecastAdmission;
            }
            requirement def <'C-022'> WeatherOutageContinuation {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                doc /* The vessel shall permit continued qualification during weather-service outage only while the last forecast remains applicable and required safety capabilities remain available. */
                comment conditions /* Forecast applicability must cover remaining passage and recovery options; assess against observations. */
                metadata rationale : ModelingMetadata::Rationale { text = "Loss of data access alone is not an abort trigger."; }
            }
            requirement weatherOutageContinuation : WeatherOutageContinuation;
            #derivation connection deriveWeatherOutageContinuation {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                end #original source ::> transGorgeChallenge;
                end #derive target ::> weatherOutageContinuation;
            }
            requirement def <'C-023'> CourseRecoveryReserve {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                doc /* The vessel shall protect sufficient energy to reach a suitable shore retrieval location from its current course position. */
                comment conditions /* Account for adverse current, essential onboard loads and uncertainty along the recovery route. No fixed motor-runtime reserve is substituted for route analysis. */
                metadata rationale : ModelingMetadata::Rationale { text = "Reserve follows the course and available recovery destinations."; }
            }
            requirement courseRecoveryReserve : CourseRecoveryReserve;
            #derivation connection deriveCourseRecoveryReserve {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                end #original source ::> transGorgeChallenge;
                end #derive target ::> courseRecoveryReserve;
            }
            requirement def <'C-024'> ReserveAbort {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                doc /* The vessel shall initiate autonomous recovery before further mission continuation would compromise the course-dependent recovery reserve. */
                comment conditions /* Include the decision and maneuver margin needed to enter recovery. */
                metadata rationale : ModelingMetadata::Rationale { text = "Protecting reserve requires timely action, not only energy monitoring."; }
            }
            requirement reserveAbort : ReserveAbort;
            #derivation connection deriveReserveAbort {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                end #original source ::> transGorgeChallenge;
                end #derive target ::> reserveAbort;
            }
            requirement def <'C-025'> NightOperation {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                doc /* The vessel shall support qualifying operation in darkness. */
                comment conditions /* Required navigation, traffic safety and observation functions remain applicable. Nightfall alone does not require refuge. */
                metadata rationale : ModelingMetadata::Rationale { text = "Passage duration is uncertain and may include overnight sailing."; }
            }
            requirement nightOperation : NightOperation;
            #derivation connection deriveNightOperation {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                end #original source ::> transGorgeChallenge;
                end #derive target ::> nightOperation;
            }
            requirement def <'C-026'> AbortPersistence {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                doc /* An aborted attempt shall remain disqualified until a new attempt begins at the departure gate. */
                comment conditions /* No autonomous resumption from refuge. Operator-commanded relocation is permitted outside qualification. */
                metadata rationale : ModelingMetadata::Rationale { text = "Recovery cannot silently resume a partial challenge."; }
            }
            requirement abortPersistence : AbortPersistence;
            #derivation connection deriveAbortPersistence {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                end #original source ::> transGorgeChallenge;
                end #derive target ::> abortPersistence;
            }
            requirement def <'C-027'> RecoveryConspicuity {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                doc /* The vessel shall present conspicuous recovery indications during autonomous shore recovery. */
                comment conditions /* Allocate indications consistently with applicable navigation signals; no light or sound configuration is prescribed here. */
                metadata rationale : ModelingMetadata::Rationale { text = "Prompt recovery and operator alerts do not replace visibility to other users."; }
            }
            requirement recoveryConspicuity : RecoveryConspicuity;
            #derivation connection deriveRecoveryConspicuity {
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
                end #original source ::> transGorgeChallenge;
                end #derive target ::> recoveryConspicuity;
            }
            comment trafficCourtesyGuidance /* Entrants are encouraged to choose routes and operating windows that reduce encounters with other waterway users. This is nonbinding guidance, not an entry or adjudication criterion. Another vessel changing course or speed is not by itself a breach. Navigation-rule compliance, applicable nonimpediment duties and collision avoidance remain governed by C-007 and C-009.*/
            requirement def <'C-028'> NavigationRuleApplicability {
                doc /* Before entry approval, the entrant shall submit a configuration-specific navigation-rule applicability assessment. */
                comment conditions /* Before entry approval, the entrant shall submit a rule-applicability assessment for the identified vessel, propulsion modes, course and operating conditions. Identify the governing provisions and current local restrictions, required lights/shapes/sound signals, applicable exceptions and supporting authority. */
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            }
            requirement navigationRuleApplicability : NavigationRuleApplicability;
            dependency navigationRuleApplicabilityBasis from navigationRuleApplicability to navigationRules;
            requirement def <'C-029'> NavigationRuleBaseline {
                doc /* The organizer shall record and maintain the reviewed rule and notice baseline for the attempt. */
                comment conditions /* The organizer shall record the reviewed rule and notice baseline; later effective changes shall be reviewed before launch. */
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            }
            requirement navigationRuleBaseline : NavigationRuleBaseline;
            dependency navigationRuleBaselineBasis from navigationRuleBaseline to navigationRules;
            requirement def <'C-030'> NavigationEntryEvidence {
                doc /* The organizer shall approve entry only when the configuration-specific navigation evidence satisfies the entry-evidence conditions. */
                comment conditions /* Entry approval shall require organizer acceptance of configuration-specific evidence covering relevant sailing, overtaking, crossing and constrained-water encounters, uncertain classification, restricted visibility, degraded sensing and safety intervention. Record assumptions, observation and maneuver limits, pass/fail criteria, physical demonstrations, simulation coverage and remaining exclusions. Unsupported conditions shall be excluded from admission; unresolved capability within admitted conditions prevents entry approval. Entrants shall justify detection distances, margins and maneuver capability. Passing a limited software rule subset does not establish compliance with C-007. */
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            }
            requirement navigationEntryEvidence : NavigationEntryEvidence;
            dependency navigationEntryEvidenceBasis from navigationEntryEvidence to navigationRules;
            requirement def <'C-031'> OperatorSafetyIntervention {
                doc /* The operator shall intervene when necessary if autonomous safety action is insufficient and intervention is available. */
                comment conditions /* Safety action shall not be delayed to preserve qualification. Operator intervention or motor propulsion ends qualification under C-003/C-004 even when it prevents a violation. */
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            }
            requirement operatorSafetyIntervention : OperatorSafetyIntervention;
            dependency operatorSafetyInterventionBasis from operatorSafetyIntervention to navigationRules;
            requirement def <'C-032'> NavigationAdjudication {
                doc /* The organizer shall record the attempt qualification decision and its supporting reason against the navigation adjudication conditions. */
                comment conditions /* A collision, established navigation-rule breach or unsafe conduct requiring safety intervention disqualifies the attempt. Safety action shall not be delayed to preserve qualification, and the operator shall intervene when necessary if autonomous action is insufficient and intervention is available. Operator intervention or motor propulsion ends qualification under C-003/C-004 even when it prevents a violation. A compliant autonomous avoidance maneuver does not by itself end qualification. The organizer shall adjudicate using retained observations, commands, motion history and independent evidence where available, with a recorded reason. Insufficient evidence leaves qualification unconfirmed; absence of collision alone is not proof of compliance. Entry approval does not waive ongoing obligations. */
                metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            }
            requirement navigationAdjudication : NavigationAdjudication;
            dependency navigationAdjudicationBasis from navigationAdjudication to navigationRules;

        }

        package Course {
            private import ScalarValues::*;

            part def MarkerGate {
                attribute markerName : String;
                attribute lightListNumber : Integer;
                attribute longitudeDeg : Real;
                attribute latitudeDeg : Real;
                attribute bearingFromMarkerDeg : Real;
                attribute nearOffsetM : Real;
                attribute farOffsetM : Real;
                attribute sourceCell : String;
                attribute sourceEditionUpdate : String;
            }

            part west : MarkerGate {
                attribute :>> markerName = "Bonneville Pool Lighted Buoy 16";
                attribute :>> lightListNumber = 11835;
                attribute :>> longitudeDeg = -121.8676486;
                attribute :>> latitudeDeg = 45.6918586;
                attribute :>> bearingFromMarkerDeg = 0;
                attribute :>> nearOffsetM = 80;
                attribute :>> farOffsetM = 220;
                attribute :>> sourceCell = "US5WA3DK";
                attribute :>> sourceEditionUpdate = "2.0";
                metadata rationale : ModelingMetadata::Rationale { text = "Western rounding mark near Stevenson: NOAA ENC US5WA3DK and USCG LLNR 11835 identify red Lighted Buoy 16. Round to port through north, west and south offset checkpoints in that order. Use the nominal charted position, never contact or attach to the aid. The 80 m exclusion and 220 m checkpoint extent are project allocations, not statutory stand-offs."; }
            }

            part east : MarkerGate {
                attribute :>> markerName = "Bonneville Pool Lighted Buoy 39";
                attribute :>> lightListNumber = 11985;
                attribute :>> longitudeDeg = -121.461773;
                attribute :>> latitudeDeg = 45.7035806;
                attribute :>> bearingFromMarkerDeg = 180;
                attribute :>> nearOffsetM = 80;
                attribute :>> farOffsetM = 220;
                attribute :>> sourceCell = "US5WA3DP";
                attribute :>> sourceEditionUpdate = "2.0";
                metadata rationale : ModelingMetadata::Rationale { text = "Bingen start/finish reference downstream of Bingen Point boat ramp: green Lighted Buoy 39, NOAA ENC US5WA3DP and USCG LLNR 11985. The virtual gate extends south from the nominal charted buoy position. Launch and retrieval at Bingen Point are outside the scored circuit. Confirm the actual buoy and current notices before launch."; }
            }

            part temporaryWorks {
                attribute longitudeDeg : Real = -121.5225;
                attribute latitudeDeg : Real = 45.7283333333;
                attribute screeningRadiusM : Real = 250;
                metadata rationale : ModelingMetadata::Rationale { text = "2026-10-07 Northwest LNM week 40 page 2 locates railroad bridge work at White Salmon confluence, RM 168.2, through 2026-12-31. The derrick barge stays on station outside work hours. Source: https://www.navcen.uscg.gov/sites/default/files/pdf/lnms/lnm13402026.pdf . Exclude a 250 m analysis buffer around the published point for this snapshot."; }
                metadata issue : ModelingMetadata::Issue { text = "The radius is a conservative scenario allocation, not a surveyed work footprint or statutory stand-off. Replace with confirmed work extent and current notices before release; do not silently expire this exclusion using the computer clock."; }
            }
            part bridgePassage {
                attribute spanIdentifier : String = "0226241BDFAB1596";
                attribute closedClearanceM : Real = 20.4;
                attribute horizontalClearanceM : Real = 74.9;
                attribute pierAllowanceM : Real = 10;
                attribute verticalAllowanceM : Real = 2;
                attribute referenceApproachM : Real = 150;
                attribute source : String = "https://www.portofhoodriver.com/bridge-lift-request";
                metadata rationale : ModelingMetadata::Rationale { text = "Select the charted Hood River lifting span, closed, for both legs. ENC US5WA3DP LNAM 0226241BDFAB1596 supplies the polygon and conservative 20.4 m closed clearance; the Port reports 20.42 m at its stated average river height. Adjacent spans without clearance evidence are excluded. No bridge opening is part of the mission. Vertical acceptance subtracts measured pool rise, vessel air draft including motion, and a 2 m project uncertainty allowance from chart clearance. PDR must verify the local stage datum; launch must check current works and pool stage. The 10 m pier allowance is a planning allocation, not a legal stand-off."; }
            }
            part policy {
                attribute coordinateDatum : String = "WGS84 longitude/latitude degrees; bearings clockwise from true north; offsets in meters";
                attribute chartEvidence : String = "evidence/course/2026-10-11/chart-features.geojson";
                attribute sourceCatalog : String = "https://www.charts.noaa.gov/ENCs/ENCProdCat_19115.xml";
                attribute sourceLightList : String = "https://www.navcen.uscg.gov/sites/default/files/pdf/lightLists/weeklyUpdates/v6WeeklyChanges.pdf";
                attribute chartCatalogDate : String = "2026-10-10";
                attribute lightListDate : String = "2026-10-07";
                attribute gatesAcceptedForLaunch : Boolean = false;
                attribute damTransitPermitted : Boolean = false;
                attribute lockApproachTransitPermitted : Boolean = false;
                attribute hasCompletionDeadline : Boolean = false;
                attribute minimumChartDepthM : Real = 2;
                attribute shoreClearanceM : Real = 30;
                attribute restrictionClearanceM : Real = 50;
                attribute obstacleClearanceM : Real = 30;
                attribute routingGridM : Real = 40;
                attribute referenceLegLengthM : Real = 32994.546297358545;
                metadata referenceLengthBasis : ModelingMetadata::Rationale { text = "Half the complete chart-domain reference circuit including the buoy rounding generated from this gate and clearance configuration by tools.boat_analysis.environment.routing. This equivalent leg length preserves full circuit distance in the symmetric sizing calculation; the mission simulation uses the distinct legs. This is a nominal sizing-analysis distance, not a prescribed sailing track; tacks and avoidance increase traveled distance. Regeneration checks this value against the chart-derived route."; }
                metadata routingRationale : ModelingMetadata::Rationale { text = "Initial routing allocations for the small-vessel analysis: chart depth at least 2 m, 30 m from charted land/obstructions and 50 m from excluded charted areas. These are project planning margins, not legal stand-off distances. Actual draft, pool stage, maneuvering, uncertainty and bridge clearances require separate assessment. Grid resolution is a numerical setting, not a vessel requirement."; }
                attribute gateNames : String [5] ordered nonunique = ("eastGate", "westGate", "turnGate", "returnGate", "eastGate");
                attribute gateDirections : Integer [5] ordered nonunique = (-1,1,1,1,1);
                attribute crossingSequence : String = "Cross Bingen gate downstream; pass north, west and south of buoy 16 in order, keeping the buoy to port; cross Bingen gate upstream to finish. Maintain the modeled marker exclusion throughout. Launch and retrieval are outside the scored course.";
                metadata rationale : ModelingMetadata::Rationale { text = "The route stays in Bonneville Pool. Gate segments are defined relative to existing aids, with 80 m minimum nominal marker offset. Chart-derived polygons, water depth and local notices constrain route planning; neither the marker-to-marker chord nor the commercial fairway is the whole permitted sailing corridor. Completion has no elapsed-time deadline. A computational horizon reports censoring rather than failure."; }
                metadata issue : ModelingMetadata::Issue { text = "Gate proposal for mission analysis, not a launch release. Verify complete segment clearance and maneuvering/drift margins, current MSI notices, current pool stage, bridge passage and autonomous traffic avoidance. A route through charted water does not establish safe operation. No universal vessel stand-off distance is inferred from navigation rules."; }
            }
            dependency courseBasis from policy to BlueDog::Mission::Challenge::courseCompletion;

            analysis GateGeometry {
                out attribute bridgeSpanIdentifier : String = bridgePassage.spanIdentifier;
                out attribute bridgePierAllowanceM : Real = bridgePassage.pierAllowanceM;
                out attribute bridgeApproachM : Real = bridgePassage.referenceApproachM;
                out attribute referenceLegLengthM : Real = policy.referenceLegLengthM;
                out attribute temporaryWorks : Real [3] ordered nonunique = (BlueDog::Mission::Course::temporaryWorks.longitudeDeg, BlueDog::Mission::Course::temporaryWorks.latitudeDeg, BlueDog::Mission::Course::temporaryWorks.screeningRadiusM);
                out attribute westGate : Real [5] ordered nonunique = (west.longitudeDeg, west.latitudeDeg, west.bearingFromMarkerDeg, west.nearOffsetM, west.farOffsetM);
                out attribute turnGate : Real [5] ordered nonunique = (west.longitudeDeg, west.latitudeDeg, 270, west.nearOffsetM, west.farOffsetM);
                out attribute returnGate : Real [5] ordered nonunique = (west.longitudeDeg, west.latitudeDeg, 180, west.nearOffsetM, west.farOffsetM);
                out attribute eastGate : Real [5] ordered nonunique = (east.longitudeDeg, east.latitudeDeg, east.bearingFromMarkerDeg, east.nearOffsetM, east.farOffsetM);
                out attribute routing : Real [5] ordered nonunique = (policy.minimumChartDepthM, policy.shoreClearanceM, policy.restrictionClearanceM, policy.obstacleClearanceM, policy.routingGridM);
            }
        }

        package Scope {
            private import ScalarValues::*;
            enum def MissionKind { gorge; futureOcean; futureEndurance; }
            metadata def Applicability {
                attribute mission : MissionKind;
            }
            metadata applicability : Applicability about BlueDog::Mission::Challenge::RepeatedOperation {
                mission = MissionKind::futureEndurance;
            }
            part current {
                attribute designObjective : String = "Maximize probability of completing one unassisted sail-only Gorge round trip within a selected weather window";
                attribute requiresOceanQualification : Boolean = false;
                attribute requiresIndefiniteOperation : Boolean = false;
                attribute requiresRepeatableEnergyBalance : Boolean = false;
                attribute hasCompletionDeadline : Boolean = false;
                metadata rationale : ModelingMetadata::Rationale { text = "Owner decision: focus on the finite Gorge challenge. Retain finite battery accounting and reserve protection; no fixed-duration campaign constrains acceptance; no Hawaii route, saltwater profile or indefinite operation constraint is inherited. Passage time, speed-dependent failure exposure and weather-window completion should be compared together. Safety dispositions remain independent launch gates."; }
                metadata issue : ModelingMetadata::Issue { text = "Archived studies retain their original daily-balance screens. Active Gorge sizing uses instantaneous peak-power checks; chronological mission execution must establish finite energy feasibility. Speed/load-dependent failure evidence and a valid planing model remain necessary for comparing hull regimes."; }
            }
            part future {
                attribute designObjective : String = "Define a separate Hawaii mission and persistent-operation capability";
                attribute acceptanceAllocated : Boolean = false;
                metadata rationale : ModelingMetadata::Rationale { text = "Hawaii remains a future mission with independently allocated route, weather, endurance, communications, maintenance and recovery constraints. Existing ocean limits and repeating-energy cases are candidate future studies; they do not constrain Gorge acceptance."; }
            }
            dependency currentMission from current to BlueDog::Mission::Challenge::transGorgeChallenge;
            dependency futureMission from future to BlueDog::Goals::hawaiiVoyage;
        }

        package UseCases {
            private import OOSEM::systemUseCase;
            private import BlueDog::Architecture::*;
            private import BlueDog::Requirements::*;
            #systemUseCase use case prepare {
                doc /* Prepare and launch. */
                subject context : MissionContext;
                actor operator : Operator;
                objective 'P-001 Transportability' :> transportability;
            }
            #systemUseCase use case sailGorge {
                doc /* Complete Gorge challenge. */
                subject context : MissionContext;
                actor operator : Operator;
                actor traffic : OtherVessel;
                objective 'M-001 Gorge mission' :> roundTrip;
            }
            #systemUseCase use case navigateCourse {
                doc /* Use current validated navigation to follow the declared course
                 * and operating boundaries. Invalid observations require degradation and
                 * separately confirmed safety; they cannot silently remain control inputs. */
                subject context : MissionContext;
                actor operator : Operator;
                actor traffic : OtherVessel;
                objective 'E-002 Navigation and control' :> navigationAndControl;
            }
            #systemUseCase use case preserveRecoveryReserve {
                doc /* Observe usable energy and current recovery demand, preserve
                 * required safety loads, and transfer to recovery when reserve is threatened. */
                subject context : MissionContext;
                actor operator : Operator;
                objective 'E-004 Low-energy recovery' :> lowEnergyRecovery;
            }
            #systemUseCase use case sailOcean {
                metadata applicability : BlueDog::Mission::Scope::Applicability { mission = BlueDog::Mission::Scope::MissionKind::futureOcean; }
                doc /* Future mission: sail to Hawaii under independently allocated constraints. */
                subject context : MissionContext;
                actor operator : Operator;
                actor traffic : OtherVessel;
                objective 'H-001 Hawaii voyage' :> BlueDog::Goals::hawaiiVoyage;
            }
            #systemUseCase use case monitor {
                doc /* Monitor live and reconnect. */
                subject context : MissionContext;
                actor operator : Operator;
                objective 'C-101 Telemetry' :> telemetryEquipment;
            }
            #systemUseCase use case recover {
                doc /* Abort and recover. */
                subject context : MissionContext;
                actor operator : Operator;
                actor traffic : OtherVessel;
                objective 'S-003 Emergency control' :> emergencyControl;
            }
            #systemUseCase use case recoverUpright {
                doc /* For the passive-righting candidate, retain required safety while inverted, recover upright without
                 * propulsion or outside assistance, and restore control without clearing
                 * gate progress, restrictions or a prior loss of qualification. If safety
                 * is unavailable, transfer to autonomous abort and recovery. */
                subject context : MissionContext;
                actor operator : Operator;
                actor traffic : OtherVessel;
                objective 'N-051 Self-righting' :> selfRighting;
            }
            #systemUseCase use case maintain {
                doc /* Manufacture and service. */
                subject context : MissionContext;
                actor operator : Operator;
                objective 'P-003 Serviceability' :> serviceability;
            }
            #systemUseCase use case avoidTraffic {
                doc /* Detect AIS and non-AIS traffic, assess collision risk, maneuver, and monitor separation without depending on operator intervention or cooperation by the other vessel. */
                subject context : MissionContext;
                actor operator : Operator;
                actor traffic : OtherVessel;
                objective 'S-001 Traffic safety' :> trafficSafety;
            }
            #systemUseCase use case presentNavigationSignals {
                doc /* Present mode-appropriate navigation signals to other vessels during sailing, powered recovery and stationary operation. */
                subject context : MissionContext;
                actor traffic : OtherVessel;
                objective 'S-004 Navigation conspicuity' :> navigationConspicuity;
            }
            dependency poweredRecoveryBasis from recover to BlueDog::Requirements::recoveryPropulsion;
        }
    }

    package Requirements {
        private import RequirementDerivation::*;
        private import ModelingMetadata::refinement;
        private import ScalarValues::*;
        private import ISQ::*;
        private import SI::*;
        private import BlueDog::Mission::Challenge::*;
        private import BlueDog::Goals::*;
        requirement def <'M-001'> RoundTrip {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            doc /* The vessel shall sail from the Bingen departure gate, around buoy 16 near Stevenson, and through the Bingen finish gate in one qualifying attempt.*/
            comment conditions /* C-000 defines the governing finite challenge obligations. Course review, unassisted sail-only operation, safety capability, recovery reserve and the persistent attempt state apply throughout. Safe unassisted righting may preserve qualification; motor propulsion, external intervention or required safety-capability loss ends it. */
        }
        requirement def <'M-002'> MultiDayEndurance {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            doc /* The vessel shall complete the qualifying round trip without servicing or external charging. */
            comment conditions /* N-010 operational functions and applicable N-001 shared conditions apply. The mission history includes sailing, maneuvers and holds until completion. Conservative usable energy must remain above the R-002 reserve. No fixed duration or nonnegative daily energy balance is required. */
            comment notes /* The mission may finish with less stored energy than at departure. */
        }
        requirement def <'E-001'> EnergyAwareness {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            doc /*
             *  The vessel shall maintain conservative estimates of usable battery energy and the energy required for protected recovery. */
            comment conditions /* Energy estimation and conservative decision inputs; accuracy uses calibrated energy integration across operating battery temperatures. */
        }
        requirement def <'E-002'> NavigationAndControl {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            doc /* The vessel shall navigate the course and control its sail and rudder autonomously within the selected operating conditions.*/
            comment conditions /* Qualification uses the selected mission profile. Accuracy trials contain 1800 scheduled one-second epochs in 30 minutes; invalid or missing epochs count as failed epochs. Position and heading criteria use the same set of at least 1710 qualifying epochs, preventing separate selection of different good samples. Fault-injection runs are separate. */
        }
        requirement def <'E-003'> ResetRecovery {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            doc /* After a watchdog reset, the vessel shall resume the autonomous behavior permitted by its retained operating mode.*/
            comment conditions /* Watchdog-reset tests start above protected reserve with valid navigation observations. Normal sailing remains subject to N-035; data and qualification persistence have shared leaf criteria. */
        }
        requirement def <'E-004'> LowEnergyRecovery {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            doc /* The vessel shall keep the functions needed for safe recovery powered when the conservative estimate of usable energy reaches the recovery reserve.*/
            comment conditions /* Reserve means R-002. Emergency/recovery cadence takes precedence; clearing low-energy state is independent of other modes, while payload enabling respects all restrictions. */
        }
        requirement def <'E-005'> Communications {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            doc /* The vessel shall store telemetry during communication outages and deliver the stored records after reconnection.*/
            comment conditions /* Link availability is a delivery-test precondition, not a coverage guarantee. Normal, low-energy and recovery delivery cadence is 30 seconds, as allocated by BlueDog::Mission::Challenge::liveObservation. Outage tests last 24 hours. */
        }
        requirement def <'E-006'> IngressResponse {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            doc /* The vessel shall remain recoverable while fresh water enters its normally dry hull at 10 mL/min for 30 minutes.*/
            comment conditions /* All leaves use a 30-minute freshwater injection at 10 mL/min into the normally dry hull. No pump technology is prescribed; R-004 remains applicable. */
        }
        requirement def <'E-007'> MissionEvidence {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            doc /* The vessel shall preserve timestamped mission records through communication outages and power interruptions.*/
            comment conditions /* Periodic records contain position, heading, mode, gate progress, battery energy and fault state. Critical events are independent of periodic cadence. Timestamp accuracy is assessed with valid GNSS time. */
        }
        requirement roundTrip : RoundTrip;
        requirement multiDayEndurance : MultiDayEndurance;
        requirement energyAwareness : EnergyAwareness;
        requirement navigationAndControl : NavigationAndControl;
        requirement resetRecovery : ResetRecovery;
        requirement lowEnergyRecovery : LowEnergyRecovery;
        requirement communications : Communications;
        requirement ingressResponse : IngressResponse;
        requirement missionEvidence : MissionEvidence;

        #refinement dependency challengeCourse from roundTrip to BlueDog::Mission::Challenge::courseCompletion {
            metadata rationale : ModelingMetadata::Rationale { text = "Ordered gate crossings use the marker-referenced proposal in BlueDog::Mission::Course; operational release remains subject to course review."; }
        }
        dependency challengeEndurance from multiDayEndurance to roundTrip {
            metadata rationale : ModelingMetadata::Rationale { text = "The complete finite round trip, including holding and contingency exposure, determines required endurance. Repeated circuits are a separate future objective."; }
        }
        dependency challengeAutonomy from navigationAndControl to BlueDog::Mission::Challenge::unassistedAttempt {
            metadata rationale : ModelingMetadata::Rationale { text = "The vessel needs onboard guidance and control to complete an unassisted attempt."; }
        }
        dependency challengePropulsion from roundTrip to BlueDog::Mission::Challenge::sailingPropulsion {
            metadata rationale : ModelingMetadata::Rationale { text = "Vehicle challenge operation excludes auxiliary motor propulsion; powered development tests are separate."; }
        }
        #refinement dependency challengeMonitoring from communications to BlueDog::Mission::Challenge::liveObservation {
            metadata rationale : ModelingMetadata::Rationale { text = "The vehicle telemetry requirement provides a more precise outage-retention and delivery specification for the observation aspect of C-005. Autonomous execution remains separately required."; }
        }
        dependency challengeOverride from communications to BlueDog::Mission::Challenge::emergencyIntervention {
            metadata rationale : ModelingMetadata::Rationale { text = "Vehicle communications provide emergency commands whose use ends attempt qualification."; }
        }

        // Derivations: direction is original requirement to derived requirement.
        dependency roundTripNavigation from navigationAndControl to roundTrip {
            metadata rationale : ModelingMetadata::Rationale { text = "Autonomous completion of the route needs observations, guidance, and actuation."; }
        }
        dependency roundTripReset from resetRecovery to roundTrip {
            metadata rationale : ModelingMetadata::Rationale { text = "A reset during an autonomous journey must not leave mission behavior undefined."; }
        }
        dependency roundTripCommunications from communications to roundTrip {
            metadata rationale : ModelingMetadata::Rationale { text = "Mission supervision and recovery need an agreed operator communication policy."; }
        }
        dependency roundTripIngress from ingressResponse to roundTrip {
            metadata rationale : ModelingMetadata::Rationale { text = "Recovering the boat after the journey motivates a defined response to small leaks."; }
        }
        dependency roundTripEvidence from missionEvidence to roundTrip {
            metadata rationale : ModelingMetadata::Rationale { text = "Assessing route completion and learning from the mission requires recorded evidence."; }
        }
        dependency enduranceEnergy from energyAwareness to multiDayEndurance {
            metadata rationale : ModelingMetadata::Rationale { text = "Multi-day operation with variable harvesting needs energy estimation and load management."; }
        }
        dependency enduranceLimpMode from lowEnergyRecovery to multiDayEndurance {
            metadata rationale : ModelingMetadata::Rationale { text = "Harvest shortfalls need an explicit degraded operating mode."; }
        }
        dependency energyLimpMode from lowEnergyRecovery to energyAwareness {
            metadata rationale : ModelingMetadata::Rationale { text = "Available-energy estimates and reserve policy must drive low-energy transitions."; }
        }

        requirement def <'P-001'> Transportability {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            doc /* The vessel shall support transport, assembly, launch and retrieval by one adult under the specified handling conditions. */
            comment conditions /* Demonstrate with one adult, no powered lift, a firm bank or ramp of slope at most 1:12, wind at most 5 m/s and waves at most 0.2 m. This is not a survival-envelope recovery claim. */
        }
        requirement transportability : Transportability;
        dependency deriveTransportability from transportability to BlueDog::DesignIntent {
            metadata rationale : ModelingMetadata::Rationale { text = "The owner requires one-person handling independently of either voyage outcome."; }
        }

        attribute printBuildLimit : LengthValue = 250 [mm];
        requirement def <'P-002'> DesktopManufacture {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            doc /* Each print job shall fit within a 250 mm by 250 mm by 250 mm build volume.*/
            comment conditions /* Every printed component must be producible as one or more such jobs. The envelope includes the selected build orientation, supports, brim, raft and printer-required clearance. */
            attribute jobX : LengthValue;
            attribute jobY : LengthValue;
            attribute jobZ : LengthValue;
            attribute buildLimit : LengthValue = printBuildLimit;
            require constraint jobFits { PrintJobEnvelopeCriterion(jobX, jobY, jobZ, buildLimit) }
        }
        requirement desktopManufacture : DesktopManufacture;
        calc def PrintJobEnvelopeCriterion {
            in jobX : LengthValue;
            in jobY : LengthValue;
            in jobZ : LengthValue;
            in buildLimit : LengthValue;
            return verdict : Boolean;
            buildLimit > 0 [mm] and jobX > 0 [mm] and jobY > 0 [mm] and jobZ > 0 [mm] and
                jobX <= buildLimit and jobY <= buildLimit and jobZ <= buildLimit
        }
        dependency deriveDesktopManufacture from desktopManufacture to BlueDog::DesignIntent {
            metadata rationale : ModelingMetadata::Rationale { text = "The owner selected a 250 mm cubic desktop-printer build volume independently of mission completion."; }
        }

        requirement def <'P-003'> Serviceability {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            doc /* The vessel shall support replacement of serviceable equipment without structural damage. */
            comment conditions /* Exercise individual replacement of the battery, every electronics module, every actuator and every serviceable enclosure seal by one operator using hand tools. */
        }
        requirement serviceability : Serviceability;
        dependency deriveServiceability from serviceability to BlueDog::DesignIntent {
            metadata rationale : ModelingMetadata::Rationale { text = "Between-attempt serviceability is a project lifecycle constraint; it is not entailed by unassisted endurance."; }
        }

        requirement def <'S-001'> TrafficSafety {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            doc /* The vessel shall detect and respond to traffic hazards within the reviewed limits for each target class, while avoiding collisions and allowing other vessels the passage required by navigation rules.*/
            metadata issue : ModelingMetadata::Issue { text = "BlueDog::Analyses::ClassDetection defines the current class-specific allocation method. Numerical consequence, exposure, reliability, confidence and risk acceptance inputs remain unreviewed; hardware sensing and maneuver evidence is absent. Historical six-class 750 m analyses do not define the current requirement."; }
            comment conditions /* Use independently recorded head-on, crossing and overtaking AIS and non-AIS targets, day and night in the selected operational profile. Allocations shall include kinematic response distance, uncertainty, consequence-informed clearance and margins, and required timely observation and whole-response reliability with confidence criteria. Unreliably classified targets shall use a reviewed conservative envelope spanning plausible classes and occupant transitions. Collision avoidance and nonimpediment obligations remain unchanged.*/
        }
        requirement trafficSafety : TrafficSafety;
        #refinement dependency challengeTrafficResponse from BlueDog::Requirements::trafficSafety to BlueDog::Mission::Challenge::trafficCoexistence {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            metadata rationale : ModelingMetadata::Rationale { text = "S-001 specifies observation, assessment and response supporting collision-free passage. Its reviewed performance envelopes are selected allocations; C-007 independently supplies navigation duties. No-contact outcome alone does not imply the assessment process."; }
        }
        dependency deriveTrafficSafety from trafficSafety to navigationAndControl {
            metadata rationale : ModelingMetadata::Rationale { text = "The boat must detect traffic and choose an avoidance maneuver while navigating the shared river."; }
        }

        requirement def <'S-002'> OperatingBoundary {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            doc /* The vessel shall enforce the configured operating boundaries. */
            comment conditions /* Use uploaded permitted-water and exclusion polygons, with a 60-second prediction horizon. Inject approaches to every boundary, navigation loss and no-feasible-maneuver cases. Coordinates and uncertainty/clearance margins are controlled mission inputs with no default values. */
        }
        requirement operatingBoundary : OperatingBoundary;
        #refinement dependency challengeExclusions from operatingBoundary to BlueDog::Mission::Challenge::restrictedWaters {
            metadata rationale : ModelingMetadata::Rationale { text = "Configured polygons and predictive boundary handling refine the challenge exclusion obligation."; }
        }
        dependency deriveOperatingBoundary from operatingBoundary to roundTrip {
            metadata rationale : ModelingMetadata::Rationale { text = "The route must keep the boat inside permitted water and clear of restricted areas and obstacles."; }
        }

        requirement def <'S-003'> EmergencyControl {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            doc /* The vessel shall support emergency control that permits abort, local motor isolation and safe response to remote-control loss.*/
            comment conditions /* Emergency intervention ends attempt qualification. Exercise abort, local isolation and remote-control loss with coexisting low-energy flags. S-110 through S-115 define the detailed acceptance criteria; powered shore-recovery capability is independently required by R-001. */
        }
        requirement emergencyControl : EmergencyControl;
        dependency deriveSafeRecovery from emergencyControl to BlueDog::Mission::Challenge::emergencyIntervention {
            metadata rationale : ModelingMetadata::Rationale { text = "Permitted emergency intervention requires explicit abort, qualification, isolation and control-loss behavior."; }
        }

        requirement def <'S-004'> NavigationConspicuity {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            doc /* The vessel shall present the navigation signals required for its operating mode. */
            comment conditions /* Use the deployment-specific compliance matrix for sailing, powered-recovery and stationary modes, including its visibility, arcs, colors and sound criteria. The matrix remains a deployment hold point under S-005. */
        }
        requirement navigationConspicuity : NavigationConspicuity;
        #refinement dependency challengeNavigationSignals from BlueDog::Requirements::navigationConspicuity to BlueDog::Mission::Challenge::navigationRules {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            metadata rationale : ModelingMetadata::Rationale { text = "S-004 clarifies C-007 signal presentation during an attempt only. Its powered-recovery and stationary-mode coverage has the separate C-027 and deployment-matrix basis; those modes are not derived from attempt-only compliance."; }
        }
        dependency deriveNavigationConspicuity from navigationConspicuity to trafficSafety {
            metadata rationale : ModelingMetadata::Rationale { text = "Other waterway users need to see and identify the boat in the conditions in which it operates."; }
        }

        requirement def <'S-005'> RegulatoryClassification {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            doc /* Deployment shall require documented compliance with applicable navigation, radio and authorization obligations. */
            comment conditions /* Acceptance is deployment document review, not onboard behavior or an assertion of buoy status. */
        }
        requirement regulatoryClassification : RegulatoryClassification;
        dependency deriveRegulatoryClassification from regulatoryClassification to roundTrip {
            metadata rationale : ModelingMetadata::Rationale { text = "Entry review must identify which navigation and equipment rules apply to this boat and course."; }
        }

        requirement def <'N-001'> EnvironmentalEnvelope {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            doc /* The vessel shall keep its sailing and safety functions working in the declared operating conditions and remain afloat and recoverable in the declared survival conditions.*/
            comment conditions /* Gorge qualification uses N-010; ocean qualification uses N-020. Both include applicable shared exposure requirements. Operational functions are navigation, sail/steering control, recording and available-link telemetry. Survival requires flotation, attached rig/ballast, dry electronics and retained mission state; course progress is not required. Required traffic assessment, navigation signals and available-link location reporting remain safety obligations in every mode. Loss of required safety capability invokes C-012 even when the structure survives. */
            comment notes /* Profiles are not interchangeable. Gorge release does not require ocean qualification, and Gorge success does not establish ocean capability. */
        }
        requirement environmentalEnvelope : EnvironmentalEnvelope;
        dependency deriveEnvironmentalEnvelope from environmentalEnvelope to roundTrip {
            metadata rationale : ModelingMetadata::Rationale { text = "Wind, waves, current and wet exposure determine the conditions in which the boat must complete the circuit and recover."; }
        }

        requirement def <'N-002'> MarineDurability {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            doc /* The vessel shall maintain structural strength and equipment operation through the wet-exposure tests for the selected mission.*/
            comment conditions /* Gorge uses N-041 freshwater exposure; ocean uses N-042 saltwater exposure; dual-profile qualification requires both. Shared sealing, material-aging and thermal checks use the selected campaign. */
            comment notes /* A derivation does not make every mission-specific descendant applicable to every deployment. */
        }
        requirement marineDurability : MarineDurability;
        dependency deriveMarineDurability from marineDurability to environmentalEnvelope {
            metadata rationale : ModelingMetadata::Rationale { text = "Water, corrosion and repeated exposure can damage equipment and prevent completion or recovery."; }
        }

        requirement def <'N-003'> CapsizeResilience {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            doc /* After capsize, the vessel shall carry out the selected recovery strategy: right itself and restore upright control, or recover toward shore after abort.*/
            comment conditions /* Righting and upright control restoration apply to selected N-051/N-052 passive-righting criteria; C-018 independently permits post-abort limp recovery. No capsize waives required safety capability or motor inhibition. N-004 separately governs vegetation encounters. */

        }
        requirement capsizeResilience : CapsizeResilience;
        dependency deriveStabilityAndFouling from capsizeResilience to environmentalEnvelope {
            metadata rationale : ModelingMetadata::Rationale { text = "Capsize can disable sailing and sensing. The boat needs a defined way to regain control or reach a retrieval location under the declared conditions."; }
        }

        requirement def <'R-001'> RecoveryPropulsion {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            doc /* At maximum mission load, powered recovery shall reach a suitable shore retrieval location from the declared course recovery cases. */
            comment conditions /* Use route-specific wind, waves, current and casualty state, with installed propulsion performance. R-004 governs motor enable and challenge qualification; S-003 governs isolation and control loss. Course recovery scenarios must be accepted before qualification. */
            comment notes /* A sheltered thrust demonstration alone cannot qualify course-wide or capsized recovery. */
        }
        requirement recoveryPropulsion : RecoveryPropulsion;
    dependency deriveRecoveryPropulsion from recoveryPropulsion to BlueDog::Mission::Challenge::autonomousShoreRecovery {
            metadata rationale : ModelingMetadata::Rationale { text = "R-001 specifies the installed powered means supporting course-dependent shore recovery. Emergency-control acceptance remains a separate S-003 obligation."; }
        }

        calc def RecoveryReserveDemand {
            doc /* R-002 route-dependent reserve. Route traversal and recovery completion determine exposure durations; uncertainty is explicit. Powers are non-overlapping battery withdrawal rates. */
            in motorPower : PowerValue;
            in essentialPower : PowerValue;
            in poweredDuration : TimeValue;
            in essentialDuration : TimeValue;
            in uncertaintyFactor : Real;
            return reserve : EnergyValue;
            uncertaintyFactor * (motorPower * poweredDuration + essentialPower * essentialDuration)
        }

        requirement def <'R-002'> RecoveryEnergy {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            doc /* The protected reserve shall cover the energy required by a viable course-dependent shore recovery route with declared uncertainty allowance. */
            comment conditions /* Route evaluation supplies powered and essential durations from current position to a suitable retrieval location, including adverse current and final approach. Essential duration includes all powered transit. Powers use the installed configuration; uncertaintyFactor is at least one. An unavailable or infeasible recovery route cannot produce a valid reserve. */
            comment notes /* R-003 governs launch admission; E-004 governs in-mission reserve crossing. */
            attribute motorPower : PowerValue;
            attribute essentialPower : PowerValue;
            attribute reserveEnergy : EnergyValue;
            attribute poweredDuration : TimeValue;
            attribute essentialDuration : TimeValue;
            attribute uncertaintyFactor : Real;
            attribute routeFeasible : Boolean;
            require constraint reserveSizing {
                motorPower > 0 [W] and essentialPower > 0 [W] and
                routeFeasible and poweredDuration > 0 [s] and essentialDuration >= poweredDuration and uncertaintyFactor >= 1 and
                reserveEnergy >= RecoveryReserveDemand(motorPower, essentialPower, poweredDuration, essentialDuration, uncertaintyFactor)
            }
        }
        requirement recoveryEnergy : RecoveryEnergy;
        dependency deriveRecoveryEnergy from recoveryEnergy to recoveryPropulsion {
            metadata rationale : ModelingMetadata::Rationale { text = "The recovery route needs enough stored energy for propulsion and essential equipment through arrival at shore."; }
        }

        requirement def <'C-101'> TelemetryEquipment {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            doc /* The shore endpoint shall present current vessel telemetry with explicit data age and identity. */
            comment conditions /* Freshness threshold is 120 seconds for normal, emergency, powered recovery or unknown mode, and 600 seconds only for explicitly reported low energy without emergency or powered recovery. Staleness describes data age, not diagnosed link failure. Exercise a 24-hour outage and reconnection. */
        }
        requirement telemetryEquipment : TelemetryEquipment;
        dependency deriveTelemetryEquipment from telemetryEquipment to communications {
            metadata rationale : ModelingMetadata::Rationale { text = "The operator needs vessel identity, current observations and their age to interpret received telemetry."; }
        }

        requirement def <'C-102'> CommandIntegrity {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            doc /* The vessel shall accept external commands only under the specified authentication, freshness and qualification rules. */
            comment conditions /* Exercise complete command receipt, authentication failure, replayed sequence numbers, age greater than 30 seconds, and external control during a qualifying attempt. */
        }
        requirement commandIntegrity : CommandIntegrity;
        dependency deriveCommandIntegrity from commandIntegrity to communications {
            metadata rationale : ModelingMetadata::Rationale { text = "Authentication and freshness checks prevent unauthorized or replayed commands from changing the boat's behavior."; }
        }

        requirement def <'N-010'> GorgeEnvironment {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            doc /* The vessel shall operate in the freshwater Columbia River reach between Bingen and Stevenson, including opposing wind/current, short chop, traffic and submerged vegetation. */
            comment conditions /* Gorge-specific parameter limits and applicable shared exposure requirements apply together. */
            comment notes /* The profile excludes dam transit, ice and surf-zone launch. */
        }
        requirement gorgeEnvironment : GorgeEnvironment;
        dependency deriveGorgeEnvironment from gorgeEnvironment to roundTrip {
            metadata rationale : ModelingMetadata::Rationale { text = "The Gorge mission sets the river environment; it does not impose the ocean profile."; }
        }

        requirement def <'N-020'> OceanEnvironment {
            metadata applicability : BlueDog::Mission::Scope::Applicability { mission = BlueDog::Mission::Scope::MissionKind::futureOcean; }
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            doc /* The vessel shall operate on a northeast Pacific passage toward Hawaii amid saltwater, ocean swell, wind seas and prolonged unattended exposure. */
            comment conditions /* Ocean-specific parameter limits and applicable shared exposure requirements apply together. */
            comment notes /* This baseline is neither a hurricane-survival claim nor completed route/season qualification. */
        }
        requirement oceanEnvironment : OceanEnvironment;
        dependency deriveOceanEnvironment from oceanEnvironment to BlueDog::Goals::hawaiiVoyage {
            metadata rationale : ModelingMetadata::Rationale { text = "The Hawaii mission sets the ocean environment; this profile is not a Gorge acceptance prerequisite."; }
        }

        requirement def <'N-011'> GorgeWind {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            doc /* The vessel shall retain operational functions in 0–15 m/s mean true wind with 3-second gusts up to 20 m/s. */
            comment conditions /* Operational functions are defined by N-001. Mean wind uses a 10-minute average referenced to 10 m above water. */
            comment notes /* Wind tolerance does not guarantee upstream progress. */
        }
        requirement gorgeWind : GorgeWind;
        #refinement dependency deriveGorgeWind from BlueDog::Requirements::gorgeWind to BlueDog::Requirements::gorgeEnvironment {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            metadata rationale : ModelingMetadata::Rationale { text = "N-011 specifies a detailed acceptance condition for N-010 within their stated applicability."; }
        }

        requirement def <'N-012'> GorgeWaves {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            doc /* The vessel shall retain operational functions in significant wave heights up to 1.5 m, peak periods 1.5–5 s and individual waves up to 3 m. */
            comment conditions /* N-001 defines operational functions. Wave statistics use 20-minute records. */
        }
        requirement gorgeWaves : GorgeWaves;
        #refinement dependency deriveGorgeWaves from BlueDog::Requirements::gorgeWaves to BlueDog::Requirements::gorgeEnvironment {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            metadata rationale : ModelingMetadata::Rationale { text = "N-012 specifies a detailed acceptance condition for N-010 within their stated applicability."; }
        }

        requirement def <'N-013'> GorgeCurrent {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            doc /* The vessel shall retain navigation and control in currents from 0 to 1.5 m/s from any direction relative to wind and waves. */
            comment conditions /* Predicted boundary risk invokes S-002. */
            comment notes /* Current tolerance does not guarantee progress or station keeping; positive upstream speed is not required at every wind speed or heading. */
        }
        requirement gorgeCurrent : GorgeCurrent;
        #refinement dependency deriveGorgeCurrent from BlueDog::Requirements::gorgeCurrent to BlueDog::Requirements::gorgeEnvironment {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            metadata rationale : ModelingMetadata::Rationale { text = "N-013 specifies a detailed acceptance condition for N-010 within their stated applicability."; }
        }

        requirement def <'N-014'> GorgeSurvivalWind {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            doc /* The vessel shall retain survival functions through the course-derived recovery exposure in mean wind up to 25 m/s and 3-second gusts up to 35 m/s. */
            comment conditions /* Use N-001 survival outcomes and the operational wind reference convention. Selected-profile wave, current, temperature and humidity limits apply concurrently. BlueDog::Analyses::EnvironmentReview::RecoveryExposureHours includes casualty transit and declared pickup delay. */
        }
        requirement gorgeSurvivalWind : GorgeSurvivalWind;
        #refinement dependency deriveGorgeSurvivalWind from BlueDog::Requirements::gorgeSurvivalWind to BlueDog::Requirements::gorgeEnvironment {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            metadata rationale : ModelingMetadata::Rationale { text = "N-014 specifies a detailed acceptance condition for N-010 within their stated applicability."; }
        }

        requirement def <'N-015'> GorgeSurvivalWaves {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            doc /* The vessel shall retain survival functions through the course-derived recovery exposure in significant wave heights up to 2 m, peak periods 1.5–7 s and individual waves up to 4 m. */
            comment conditions /* N-001 defines survival outcomes. */
        }
        requirement gorgeSurvivalWaves : GorgeSurvivalWaves;
        #refinement dependency deriveGorgeSurvivalWaves from BlueDog::Requirements::gorgeSurvivalWaves to BlueDog::Requirements::gorgeEnvironment {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            metadata rationale : ModelingMetadata::Rationale { text = "N-015 specifies a detailed acceptance condition for N-010 within their stated applicability."; }
        }

        requirement def <'N-021'> OceanWind {
            metadata applicability : BlueDog::Mission::Scope::Applicability { mission = BlueDog::Mission::Scope::MissionKind::futureOcean; }
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            doc /* The vessel shall retain operational functions in 3–15 m/s mean true wind with 3-second gusts up to 20 m/s. */
            comment conditions /* Operational functions are defined by N-001. Mean wind uses a 10-minute average referenced to 10 m above water. */
            comment notes /* Wind tolerance does not guarantee upstream progress. */
        }
        requirement oceanWind : OceanWind;
        #refinement dependency deriveOceanWind from BlueDog::Requirements::oceanWind to BlueDog::Requirements::oceanEnvironment {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            metadata rationale : ModelingMetadata::Rationale { text = "N-021 specifies a detailed acceptance condition for N-020 within their stated applicability."; }
        }

        requirement def <'N-022'> OceanWaves {
            metadata applicability : BlueDog::Mission::Scope::Applicability { mission = BlueDog::Mission::Scope::MissionKind::futureOcean; }
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            doc /* The vessel shall retain operational functions in significant wave heights up to 3 m, peak periods 5–20 s and individual waves up to 6 m. */
            comment conditions /* N-001 defines operational functions. Wave statistics use 20-minute records. */
        }
        requirement oceanWaves : OceanWaves;
        #refinement dependency deriveOceanWaves from BlueDog::Requirements::oceanWaves to BlueDog::Requirements::oceanEnvironment {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            metadata rationale : ModelingMetadata::Rationale { text = "N-022 specifies a detailed acceptance condition for N-020 within their stated applicability."; }
        }

        requirement def <'N-023'> OceanCurrent {
            metadata applicability : BlueDog::Mission::Scope::Applicability { mission = BlueDog::Mission::Scope::MissionKind::futureOcean; }
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            doc /* The vessel shall retain navigation and control in currents from 0 to 1.0 m/s from any direction relative to wind and waves. */
            comment conditions /* Predicted boundary risk invokes S-002. */
            comment notes /* Current tolerance does not guarantee progress or station keeping; positive upstream speed is not required at every wind speed or heading. */
        }
        requirement oceanCurrent : OceanCurrent;
        #refinement dependency deriveOceanCurrent from BlueDog::Requirements::oceanCurrent to BlueDog::Requirements::oceanEnvironment {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            metadata rationale : ModelingMetadata::Rationale { text = "N-023 specifies a detailed acceptance condition for N-020 within their stated applicability."; }
        }

        requirement def <'N-024'> OceanSurvivalWind {
            metadata applicability : BlueDog::Mission::Scope::Applicability { mission = BlueDog::Mission::Scope::MissionKind::futureOcean; }
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            doc /* The vessel shall retain survival functions for 24 continuous hours in mean wind up to 25 m/s and 3-second gusts up to 35 m/s. */
            comment conditions /* Use N-001 survival outcomes and the operational wind reference convention. Selected-profile wave, current, temperature and humidity limits apply concurrently. */
        }
        requirement oceanSurvivalWind : OceanSurvivalWind;
        #refinement dependency deriveOceanSurvivalWind from BlueDog::Requirements::oceanSurvivalWind to BlueDog::Requirements::oceanEnvironment {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            metadata rationale : ModelingMetadata::Rationale { text = "N-024 specifies a detailed acceptance condition for N-020 within their stated applicability."; }
        }

        requirement def <'N-025'> OceanSurvivalWaves {
            metadata applicability : BlueDog::Mission::Scope::Applicability { mission = BlueDog::Mission::Scope::MissionKind::futureOcean; }
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            doc /* The vessel shall retain survival functions for 24 continuous hours in significant wave heights up to 6 m, peak periods 6–20 s and individual waves up to 12 m. */
            comment conditions /* N-001 defines survival outcomes. */
        }
        requirement oceanSurvivalWaves : OceanSurvivalWaves;
        #refinement dependency deriveOceanSurvivalWaves from BlueDog::Requirements::oceanSurvivalWaves to BlueDog::Requirements::oceanEnvironment {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            metadata rationale : ModelingMetadata::Rationale { text = "N-025 specifies a detailed acceptance condition for N-020 within their stated applicability."; }
        }

        requirement def <'N-030'> AirTemperature {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            doc /* The vessel shall retain mode-appropriate functions at ambient air temperatures from 0 to 40 degC. */
            comment conditions /* N-001/N-035 define operational and survival functions. */
        }
        requirement airTemperature : AirTemperature;
        #refinement dependency deriveAirTemperature from BlueDog::Requirements::airTemperature to BlueDog::Requirements::environmentalEnvelope {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            metadata rationale : ModelingMetadata::Rationale { text = "N-030 specifies a detailed acceptance condition for N-001 within their stated applicability."; }
        }

        requirement def <'N-031'> WaterTemperature {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            doc /* Immersed hull, appendages and equipment shall retain mode-appropriate functions in water from 2 to 30 degC. */
            comment conditions /* N-001/N-035 define operational and survival functions. */
        }
        requirement waterTemperature : WaterTemperature;
        #refinement dependency deriveWaterTemperature from BlueDog::Requirements::waterTemperature to BlueDog::Requirements::environmentalEnvelope {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            metadata rationale : ModelingMetadata::Rationale { text = "N-031 specifies a detailed acceptance condition for N-001 within their stated applicability."; }
        }

        requirement def <'N-032'> Humidity {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            doc /* Installed equipment shall retain operational functions at 0–100 percent relative humidity, including condensation. */
        }
        requirement humidity : Humidity;
        #refinement dependency deriveHumidity from BlueDog::Requirements::humidity to BlueDog::Requirements::environmentalEnvelope {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            metadata rationale : ModelingMetadata::Rationale { text = "N-032 specifies a detailed acceptance condition for N-001 within their stated applicability."; }
        }

        requirement def <'N-033'> Visibility {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            doc /* The vessel shall provide mode-appropriate navigation and traffic response across the specified visibility conditions. */
            comment conditions /* Exercise daylight and darkness at meteorological visibility of at least 1 km, and detected visibility below 1 km. Apply current BlueDog::Analyses::ClassDetection class-specific or conservative plausible-class envelopes and the S-001 reviewed observation and response criteria.*/
        }
        requirement visibility : Visibility;
        #refinement dependency deriveVisibility from BlueDog::Requirements::visibility to BlueDog::Requirements::environmentalEnvelope {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            metadata rationale : ModelingMetadata::Rationale { text = "N-033 specifies a detailed acceptance condition for N-001 within their stated applicability."; }
        }

        requirement def <'N-034'> CalmOperation {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            doc /* While waiting in mean wind below 3 m/s, the vessel shall preserve the course-derived recovery reserve. */
            comment conditions /* Calm-mode functions are navigation, recording and autonomous boundary/traffic contingency. Waiting may continue only while forecast coverage, traffic/boundary safety and measured calm-mode loads preserve route-dependent recovery authority; no fixed waiting endurance is imposed. Autonomous safety recovery first terminates qualification under BlueDog::Mission::Challenge::safetyCapabilityAbort, then may enable the motor under R-004. */
            comment notes /* Neither progress nor station keeping is required. */
        }
        requirement calmOperation : CalmOperation;
        #refinement dependency deriveCalmOperation from BlueDog::Requirements::calmOperation to BlueDog::Requirements::environmentalEnvelope {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            metadata rationale : ModelingMetadata::Rationale { text = "N-034 specifies a detailed acceptance condition for N-001 within their stated applicability."; }
        }

        requirement def <'N-035'> EnvelopeTransition {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            doc /* The vessel shall select survival or sailing operation according to the defined environmental transition conditions. */
            comment conditions /* The trigger is a detected upper operational wind or wave limit exceedance for the selected profile; calm invokes N-034. Resumption eligibility requires 10 continuous minutes inside the selected wind/wave limits, valid navigation, upright control, preserved required safety capability and no low-energy, emergency-recovery or isolation restriction. Resuming a control mode never clears a disqualified attempt. */
        }
        requirement envelopeTransition : EnvelopeTransition;
        #refinement dependency deriveEnvelopeTransition from BlueDog::Requirements::envelopeTransition to BlueDog::Requirements::environmentalEnvelope {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            metadata rationale : ModelingMetadata::Rationale { text = "N-035 specifies a detailed acceptance condition for N-001 within their stated applicability."; }
        }

        requirement def <'N-041'> FreshwaterExposure {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            doc /* For Gorge qualification, following continuous freshwater exposure for the full declared mission history, with submerged parts continuously wet and complete topside spray wetting at least once per hour, the vessel shall pass its Gorge functional checks without repair or servicing. */
        }
        requirement freshwaterExposure : FreshwaterExposure;
        #refinement dependency deriveFreshwaterExposure from BlueDog::Requirements::freshwaterExposure to BlueDog::Requirements::marineDurability {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            metadata rationale : ModelingMetadata::Rationale { text = "N-041 specifies a detailed acceptance condition for N-002 within their stated applicability."; }
        }

        requirement def <'N-042'> SaltwaterExposure {
            metadata applicability : BlueDog::Mission::Scope::Applicability { mission = BlueDog::Mission::Scope::MissionKind::futureOcean; }
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            doc /* For ocean qualification, following 30 days continuous 35 g/kg saltwater exposure, with submerged parts continuously wet and complete topside spray wetting at least once per hour, the vessel shall pass its ocean functional checks without repair or servicing. */
            comment notes /* The exposure campaign does not establish the eventual passage duration. */
        }
        requirement saltwaterExposure : SaltwaterExposure;

        requirement def <'N-043'> EnclosureSealing {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            doc /* Before and after each wet-exposure campaign, installed electronics enclosures, connectors and penetrations shall show no detectable liquid ingress on dry internal water-sensitive indicators after 30 minutes immersion with their highest point 1 m below the water surface. */
        }
        requirement enclosureSealing : EnclosureSealing;
        #refinement dependency deriveEnclosureSealing from BlueDog::Requirements::enclosureSealing to BlueDog::Requirements::marineDurability {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            metadata rationale : ModelingMetadata::Rationale { text = "N-043 specifies a detailed acceptance condition for N-002 within their stated applicability."; }
        }

        requirement def <'N-044'> WetMechanicalIntegrity {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            doc /* External mechanisms and structural joints shall retain integrity after the selected wet-exposure campaign. */
            comment conditions /* Evaluate after each selected profile wet-exposure campaign under N-002. */
        }
        requirement wetMechanicalIntegrity : WetMechanicalIntegrity;
        #refinement dependency deriveWetMechanicalIntegrity from BlueDog::Requirements::wetMechanicalIntegrity to BlueDog::Requirements::marineDurability {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            metadata rationale : ModelingMetadata::Rationale { text = "N-044 specifies a detailed acceptance condition for N-002 within their stated applicability."; }
        }

        requirement def <'N-045'> WetElectricalIntegrity {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            doc /* Cable assemblies shall retain electrical integrity after the selected wet-exposure campaign. */
            comment conditions /* Evaluate disconnected cable assemblies after each selected profile wet-exposure campaign under N-002; disconnect electronics for insulation measurement. */
        }
        requirement wetElectricalIntegrity : WetElectricalIntegrity;
        #refinement dependency deriveWetElectricalIntegrity from BlueDog::Requirements::wetElectricalIntegrity to BlueDog::Requirements::marineDurability {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            metadata rationale : ModelingMetadata::Rationale { text = "N-045 specifies a detailed acceptance condition for N-002 within their stated applicability."; }
        }

        requirement def <'N-046'> SolarHeating {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            doc /* The vessel shall retain safe powered operation during the specified solar-heating exposure. */
            comment conditions /* Expose the powered vessel to 40 degC ambient air and 1000 W/m2 incident solar irradiance for 8 hours; use the installed battery manufacturer temperature limits. */
        }
        requirement solarHeating : SolarHeating;
        #refinement dependency deriveSolarHeating from BlueDog::Requirements::solarHeating to BlueDog::Requirements::marineDurability {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            metadata rationale : ModelingMetadata::Rationale { text = "N-046 specifies a detailed acceptance condition for N-002 within their stated applicability."; }
        }

        requirement def <'N-047'> PrintedMaterialAging {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            doc /* Aged printed structural components shall retain the load capacity credited to them in the qualified design. */
            comment conditions /* Use exposure representative of the selected mission and intended service interval, followed by N-041 for Gorge or N-042 for ocean. Establish aged directional load bounds for the actual print and joints. The initial 300 MJ/m2 UV dose is a provisional accelerated-test condition, not a mission-derived dose; compare aged capacity with credited demand, not an arbitrary percentage of unaged strength. */
            attribute creditedLoadCapacityN : Real;
            attribute qualifiedAgedCapacityN : Real;
            attribute exposureEvidenceAccepted : Boolean;
            require constraint acceptance { exposureEvidenceAccepted and creditedLoadCapacityN > 0 and qualifiedAgedCapacityN >= creditedLoadCapacityN }
        }
        requirement printedMaterialAging : PrintedMaterialAging;
        #refinement dependency derivePrintedMaterialAging from BlueDog::Requirements::printedMaterialAging to BlueDog::Requirements::marineDurability {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            metadata rationale : ModelingMetadata::Rationale { text = "N-047 specifies a detailed acceptance condition for N-002 within their stated applicability."; }
        }

        requirement def <'N-051'> SelfRighting {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            doc /* The vessel shall recover from the specified capsize releases without external assistance or motor thrust. */
            comment conditions /* Apply to the selected passive-righting concept, not every challenge-compliant vessel. Use minimum and maximum mission loading, five releases at each angle of 90 and 180 degrees toward each side, without external action or motor thrust. Use freshwater for Gorge or 35 g/kg saltwater for ocean; dual qualification requires both media. N-118 RightingDeadline, N-119 CapsizeRigRetention, N-120 CapsizeBallastRetention and N-121 CapsizeElectronicsSealing apply to every release. */
        }
        requirement selfRighting : SelfRighting;
        dependency selectedRightingStrategy from selfRighting to capsizeResilience {
            metadata rationale : ModelingMetadata::Rationale { text = "Passive self-righting is the current monohull design strategy, not entailed by the challenge. C-018 also permits demonstrated limp recovery after abort; an alternative concept may meet that obligation without self-righting."; }
        }

        requirement def <'N-052'> CapsizeControlRecovery {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            doc /* The vessel shall restore mode-appropriate control after each specified capsize release. */
            comment conditions /* Apply to every N-051 release without operator input. Mode-appropriate control does not mean normal sailing before the N-035 resumption gate permits it. */
        }
        requirement capsizeControlRecovery : CapsizeControlRecovery;
        dependency deriveCapsizeControlRecovery from capsizeControlRecovery to capsizeResilience {
            metadata rationale : ModelingMetadata::Rationale { text = "Upright control restoration is an obligation of the selected passive-righting strategy. Alternative challenge concepts may provide post-abort limp recovery without this strategy."; }
        }

        requirement def <'N-053'> SubmergedWeedPassage {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            doc /* The vessel shall tolerate submerged milfoil-like vegetation during the specified unassisted Gorge sailing passes. */
            comment conditions /* Gorge campaign: five consecutive sailing passes without manual clearing or motor use through a 5 m by 1 m patch of 20 flexible branched stems per square metre, each 0.5-1.0 m long, extending from below the deepest appendage to within 0.1 m of the surface. Use 5 m/s mean wind and the weed-free reference heading. Record material, branch geometry, wet bending stiffness and anchoring. */
            metadata issue : ModelingMetadata::Issue { text = "Equivalence of the vegetation surrogate to local milfoil requires physical-test validation."; }
        }
        requirement submergedWeedPassage : SubmergedWeedPassage;
        #refinement dependency deriveSubmergedWeedPassage from BlueDog::Requirements::submergedWeedPassage to BlueDog::Requirements::vegetationResilience {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            metadata rationale : ModelingMetadata::Rationale { text = "N-053 specifies a detailed acceptance condition for N-004 within their stated applicability."; }
        }

        requirement def <'N-054'> WeedSnagShedding {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            doc /* The vessel shall recover sailing performance after the specified appendage weed snags without assistance or motor use. */
            comment conditions /* Gorge campaign: drape one wet 1 m branched stem over one appendage leading edge at a time, five repetitions per appendage, with N-053 surrogate characteristics, 5 m/s mean wind and the unobstructed reference heading. No manual assistance or motor use. N-128 WeedSnagSpeedRecovery and N-129 WeedSnagSteeringRecovery apply to every repetition; visible stem removal alone is insufficient. */
        }
        requirement weedSnagShedding : WeedSnagShedding;
        #refinement dependency deriveWeedSnagShedding from BlueDog::Requirements::weedSnagShedding to BlueDog::Requirements::vegetationResilience {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            metadata rationale : ModelingMetadata::Rationale { text = "N-054 specifies a detailed acceptance condition for N-004 within their stated applicability."; }
        }

        requirement def <'N-055'> WeedBlockageResponse {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            doc /* The vessel shall enter autonomous fouling contingency when the defined weed-blockage trigger occurs. */
            comment conditions /* Gorge trigger: vegetation prevents completion of commanded rudder motion for 5 seconds, or keeps water-relative speed below 25 percent of the preceding weed-free 60-second mean for 60 seconds with mean wind at least 3 m/s. Dense mats are a blockage/avoidance case, not a pass-through claim. */
        }
        requirement weedBlockageResponse : WeedBlockageResponse;
        #refinement dependency deriveWeedBlockageResponse from BlueDog::Requirements::weedBlockageResponse to BlueDog::Requirements::vegetationResilience {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            metadata rationale : ModelingMetadata::Rationale { text = "N-055 specifies a detailed acceptance condition for N-004 within their stated applicability."; }
        }

        requirement def <'N-056'> RecoveryPropulsorWeeds {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            doc /* The recovery propulsion system shall tolerate the specified weed encounters within its rated electrical and thermal limits. */
            comment conditions /* Use a separately designated Gorge powered-recovery test with five passes through the N-053 patch without manual propulsor clearing, on the weed-free powered reference heading. Exercise locked propulsor separately. */
        }
        requirement recoveryPropulsorWeeds : RecoveryPropulsorWeeds;
        #refinement dependency deriveRecoveryPropulsorWeeds from BlueDog::Requirements::recoveryPropulsorWeeds to BlueDog::Requirements::vegetationResilience {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            metadata rationale : ModelingMetadata::Rationale { text = "N-056 specifies a detailed acceptance condition for N-004 within their stated applicability."; }
        }
        dependency motorWeedTolerance from recoveryPropulsorWeeds to recoveryPropulsion {
            metadata rationale : ModelingMetadata::Rationale { text = "The recovery propulsor must remain usable in the vegetation encountered by the sailing vessel."; }
        }
        requirement def <'E-008'> NavigationAvailability {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            doc /* The vessel shall maintain valid navigation inputs and reject stale observations. */
            comment conditions /* Campaigns use 1800 scheduled one-second epochs in 30 minutes, with missing/invalid epochs counted as failures. Fault injection is separate. */
        }
        requirement navigationAvailability : NavigationAvailability;
        requirement def <'R-003'> LaunchEnergyAdmission {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            doc /*
             *  The vessel shall inhibit mission start unless a valid usable-energy estimate no older than 1 second strictly exceeds a valid R-002 protected reserve. */
            comment conditions /* Missing, stale or invalid estimates or reserve configuration inhibit start. */
            attribute conservativeStartEnergy : EnergyValue;
            attribute protectedReserve : EnergyValue;
            attribute estimateAge : TimeValue;
            attribute estimateValid : Boolean;
            attribute reserveValid : Boolean;
            attribute missionStartEnabled : Boolean;
            attribute admissionEligible : Boolean =
                estimateValid and reserveValid and protectedReserve > 0 [J] and
                estimateAge >= 0 [s] and estimateAge <= 1 [s] and
                conservativeStartEnergy > protectedReserve;
            require constraint launchEnergyGate {
                not missionStartEnabled or admissionEligible
            }
        }
        requirement launchEnergyAdmission : LaunchEnergyAdmission;
        requirement def <'R-004'> ChallengeMotorInhibition {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            doc /*
             *  The vessel shall inhibit motor thrust until it has durably recorded a known nonqualifying status for the attempt. */
            comment conditions /* Exercise qualifying, nonqualifying and unknown qualification states, restart, link loss, power loss during transitions and conflicting/stale commands. Shared qualification persistence applies before enabling intervention. */
        }
        requirement challengeMotorInhibition : ChallengeMotorInhibition;
        #refinement dependency auditDerivation1 from BlueDog::Requirements::navigationAvailability to BlueDog::Requirements::navigationAndControl {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            metadata rationale : ModelingMetadata::Rationale { text = "E-008 specifies a detailed acceptance condition for E-002 within their stated applicability."; }
        }
        dependency auditDerivation2 from launchEnergyAdmission to recoveryEnergy {
            metadata rationale : ModelingMetadata::Rationale { text = "The selected launch gate consumes the route-dependent reserve calculation. A changed reserve or validity rule requires admission review; the reserve magnitude alone does not define launch behavior."; }
        }
        dependency auditDerivation3 from challengeMotorInhibition to BlueDog::Mission::Challenge::sailingPropulsion {
            metadata rationale : ModelingMetadata::Rationale { text = "The onboard interlock is the selected enforcement of sail-only qualification. The challenge rule governs the attempt outcome without mandating this particular interlock design."; }
        }
        dependency auditDerivation4 from challengeMotorInhibition to BlueDog::Mission::Challenge::unassistedAttempt {
            metadata rationale : ModelingMetadata::Rationale { text = "No-intervention qualification must survive resets and motor-mode transitions."; }
        }
        dependency auditDerivation5 from commandIntegrity to BlueDog::Mission::Challenge::unassistedAttempt {
            metadata rationale : ModelingMetadata::Rationale { text = "Accepted external control changes the attempt qualification; communications alone does not supply this rule."; }
        }
        dependency auditDerivation6 from commandIntegrity to BlueDog::Mission::Challenge::emergencyIntervention {
            metadata rationale : ModelingMetadata::Rationale { text = "The emergency control channel needs authenticated, fresh commands and persistent qualification changes."; }
        }
        #refinement dependency auditDerivation10 from BlueDog::Requirements::freshwaterExposure to BlueDog::Requirements::gorgeEnvironment {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            metadata rationale : ModelingMetadata::Rationale { text = "N-041 specifies a detailed acceptance condition for N-010 within their stated applicability."; }
        }
        #refinement dependency auditDerivation11 from BlueDog::Requirements::saltwaterExposure to BlueDog::Requirements::oceanEnvironment {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            metadata rationale : ModelingMetadata::Rationale { text = "N-042 specifies a detailed acceptance condition for N-020 within their stated applicability."; }
        }
        #refinement dependency auditDerivation12 from BlueDog::Requirements::submergedWeedPassage to BlueDog::Requirements::gorgeEnvironment {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            metadata rationale : ModelingMetadata::Rationale { text = "N-053 specifies a detailed acceptance condition for N-010 within their stated applicability."; }
        }
        #refinement dependency auditDerivation13 from BlueDog::Requirements::weedSnagShedding to BlueDog::Requirements::gorgeEnvironment {
            metadata workStatus : ModelingMetadata::StatusInfo { status = ModelingMetadata::StatusKind::open; }
            metadata rationale : ModelingMetadata::Rationale { text = "N-054 specifies a detailed acceptance condition for N-010 within their stated applicability."; }
        }

        // Independently verifiable acceptance leaves.
        requirement def <'E-101'> EnergyEstimateCadence {
